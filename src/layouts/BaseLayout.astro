  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .lang-link {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    padding: 0.1rem 0.25rem;
    border-radius: 4px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .lang-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  .lang-link.active {
    color: var(--chrome-accent, #facc15);
    background: rgba(255, 255, 255, 0.12);
  }

  .lang-sep {
    opacity: 0.45;
  }
</style>
  
  <script is:inline>
    document.addEventListener('click', function (e) {
      const target = e.target && e.target.closest ? e.target.closest('[data-set-lang]') : null;
      if (target) {
        const chosen = target.getAttribute('data-set-lang');
        if (chosen) {
          document.cookie = 'lang_pref=' + encodeURIComponent(chosen) + '; path=/; max-age=31536000; SameSite=Lax';
        }
      }
    });
  </script>

  <script is:inline>
    (function () {
      const hasEnCookie = document.cookie.split(';').some((c) => c.trim() === 'lang_pref=en');
      const isEnPath = window.location.pathname.startsWith('/en/');
      if (!hasEnCookie && !isEnPath) return;

      document.documentElement.lang = 'en';

      const phraseMap = new Map([
        ['Calcular', 'Calculate'],
        ['Limpar', 'Clear'],
        ['Simular', 'Simulate'],
        ['Copiar', 'Copy'],
        ['Copiado!', 'Copied!'],
        ['Resultado', 'Result'],
        ['Resultados', 'Results'],
        ['Valor Inicial', 'Initial Amount'],
        ['Aporte Mensal', 'Monthly Contribution'],
        ['Taxa de Juros', 'Interest Rate'],
        ['Período', 'Period'],
        ['Meses', 'Months'],
        ['Anos', 'Years'],
        ['Total Investido', 'Total Invested'],
        ['Total em Juros', 'Total Interest'],
        ['Valor Final Total', 'Final Total Balance'],
        ['Calculadora de Juros Compostos', 'Compound Interest Calculator'],
        ['Calculadora de Porcentagem', 'Percentage Calculator'],
        ['Calculadora de Regra de Três', 'Rule of Three Calculator'],
        ['Calculadora de Financiamento Imobiliário', 'Mortgage Calculator'],
        ['Simulador de Investimentos', 'Investment Simulator'],
        ['Calculadora de Independência Financeira', 'Financial Independence (FIRE) Calculator'],
        ['Calculadora de Empréstimo', 'Loan Payment Calculator'],
        ['Calculadora de Desconto', 'Discount Calculator'],
        ['Calculadora Científica', 'Scientific Calculator'],
        ['Calculadora Padrão', 'Standard Calculator'],
        ['Conversor de Temperatura', 'Temperature Converter'],
        ['Calculadora de Dias Úteis', 'Business Days Calculator'],
        ['Calculadora de Biometria e IMC', 'BMI & Biometrics Calculator'],
        ['Gerador de Senhas Seguras', 'Secure Password Generator'],
        ['Contador de Texto e Caracteres', 'Word & Character Counter'],
        ['Calculadora de Precificação e Markup', 'Markup & Pricing Calculator'],
        ['Calculadora de Valor Hora', 'Hourly Rate Calculator'],
        ['Início', 'Home'],
        ['Finanças', 'Finance'],
        ['Matemática', 'Math'],
        ['Trabalhista', 'Labor (BR)'],
        ['Conversores', 'Converters'],
        ['Saúde', 'Health'],
        ['Ferramentas', 'Tools'],
        ['Guias', 'Guides'],
        ['Contato', 'Contact'],
        ['Privacidade', 'Privacy'],
      ]);

      function translateTextNodes(root) {
        if (!root) return;
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
        let node;
        while ((node = walker.nextNode())) {
          const raw = node.nodeValue;
          if (!raw) continue;
          const trimmed = raw.trim();
          if (phraseMap.has(trimmed)) {
            node.nodeValue = raw.replace(trimmed, phraseMap.get(trimmed));
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => translateTextNodes(document.body));
      } else {
        translateTextNodes(document.body);
      }
    })();
  </script>
</body>
