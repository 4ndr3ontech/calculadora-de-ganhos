---
import { TOOLS_DATA } from '../data/tools';
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(new URL(Astro.request.url));
const isEn = lang === 'en';

const catEnMap: Record<string, string> = {
  'Finanças': 'Finance',
  'Matemática': 'Math',
  'Conversores': 'Converters',
  'Saúde': 'Health',
  'Ferramentas': 'Tools',
};

const localizedTools = isEn
  ? TOOLS_DATA.filter((t) => t.status === 'active' && t.category !== 'Trabalhista').map((t) => ({
      ...t,
      category: catEnMap[t.category] || t.category,
    }))
  : TOOLS_DATA;

const placeholderText = isEn
  ? 'What do you want to calculate? (e.g., compound interest, percentage...)'
  : 'O que você deseja calcular? (ex: juros compostos, salário líquido...)';
const ariaLabelText = isEn
  ? 'Search calculators and tools'
  : 'Pesquisar ferramentas e calculadoras';
---

<div class="search-wrapper" role="search">
  <div class="search-box">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" class="search-icon" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" x2="16.65" y1="21" y2="16.65"/>
    </svg>
    <input 
      type="search" 
      id="tool-search-input" 
      placeholder={placeholderText} 
      aria-label={ariaLabelText}
      aria-autocomplete="list"
      aria-controls="search-results"
      autocomplete="off"
    />
  </div>
  <div id="search-results" class="search-results-dropdown" role="listbox"></div>
</div>

<script define:vars={{ toolsIndex: localizedTools, isEn }}>
  function setupToolSearch() {
    const input = document.getElementById('tool-search-input');
    const dropdown = document.getElementById('search-results');
    if (!input || !dropdown) return;

    let selectedIndex = -1;

    function normalize(str) {
      return (str || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function getCategoryColor(cat) {
      const c = normalize(cat);
      if (c.includes("trabalh")) return "blue";
      if (c.includes("finan")) return "green";
      if (c.includes("matem") || c === "math") return "purple";
      if (c.includes("saude") || c === "health") return "pink";
      if (c.includes("convers") || c === "converters") return "cyan";
      return "orange";
    }

    function updateHighlight(items) {
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          item.setAttribute('aria-selected', 'true');
          item.classList.add('is-highlighted');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.setAttribute('aria-selected', 'false');
          item.classList.remove('is-highlighted');
        }
      });
    }

    input.addEventListener('input', (e) => {
      const query = normalize(e.target.value);
      selectedIndex = -1;

      if (query.length < 2) {
        dropdown.classList.remove('active');
        dropdown.innerHTML = '';
        return;
      }

      const filtered = toolsIndex.filter(t => 
        normalize(t.name).includes(query) || 
        normalize(t.description).includes(query) || 
        normalize(t.category).includes(query) ||
        (t.keywords && t.keywords.some(kw => normalize(kw).includes(query)))
      );

      if (filtered.length > 0) {
        dropdown.innerHTML = filtered.map((item, index) => `
          <a href="${item.route}" class="search-result-item color-${getCategoryColor(item.category)}" role="option" id="search-item-${index}">
            <div class="search-result-top">
              <span class="search-result-title">${item.name}</span>
              <span class="search-result-badge">${item.category}</span>
            </div>
            <div class="search-result-desc">${item.description}</div>
          </a>
        `).join('');
        dropdown.classList.add('active');
      } else {
        dropdown.innerHTML = `<div class="search-no-results">${isEn ? "No calculator found for" : "Nenhuma ferramenta encontrada para"} "${e.target.value}"</div>`;
        dropdown.classList.add('active');
      }
    });

    input.addEventListener('keydown', (e) => {
      const items = Array.from(dropdown.querySelectorAll('.search-result-item'));
      if (!dropdown.classList.contains('active') || items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateHighlight(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateHighlight(items);
      } else if (e.key === 'Enter' && selectedIndex >= 0 && items[selectedIndex]) {
        e.preventDefault();
        items[selectedIndex].click();
      } else if (e.key === 'Escape') {
        dropdown.classList.remove('active');
        selectedIndex = -1;
      }
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.remove('active');
        selectedIndex = -1;
      }
    });
  }

  setupToolSearch();
  document.addEventListener('astro:after-swap', setupToolSearch);
</script>

<style>
  .search-wrapper {
    position: relative;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    text-align: left;
  }

  .search-box {
    display: flex;
    align-items: center;
    background: var(--bg-primary);
    border: 1.5px solid color-mix(in srgb, var(--color-primary) 28%, var(--border-color));
    border-radius: var(--radius-md);
    padding: 0.9rem 1.2rem;
    box-shadow:
      0 10px 25px -8px color-mix(in srgb, var(--color-primary) 18%, transparent),
      0 2px 6px rgba(0, 0, 0, 0.04);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .search-box:hover {
    border-color: color-mix(in srgb, var(--color-primary) 55%, var(--border-color));
    transform: translateY(-1px);
  }

  .search-box:focus-within {
    border-color: var(--color-primary);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--color-primary) 14%, transparent),
      0 14px 30px -8px color-mix(in srgb, var(--color-primary) 24%, transparent);
    transform: translateY(-1px);
  }

  .search-icon {
    color: var(--color-primary);
    margin-right: 0.85rem;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .search-box:focus-within .search-icon {
    transform: scale(1.06);
  }

  #tool-search-input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: 0.95rem;
    color: var(--text-primary);
    outline: none;
  }

  #tool-search-input::placeholder {
    color: var(--text-muted);
  }

  .search-results-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 100%;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    max-height: 360px;
    overflow-y: auto;
    z-index: 60;
    display: none;
    box-sizing: border-box;
    text-align: left;
  }

  .search-results-dropdown.active {
    display: block;
  }

  :global(.search-result-item) {
    --res-color: #059669;
    --res-bg: rgba(16, 185, 129, 0.12);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0.85rem 1.1rem;
    color: var(--text-primary);
    text-decoration: none !important;
    border-bottom: 1px solid var(--border-color);
    border-left: 3px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  :global(.search-result-item:last-child) {
    border-bottom: none;
  }

  :global(.search-result-item.color-blue)   { --res-color: #2563eb; --res-bg: rgba(37, 99, 235, 0.12); }
  :global(.search-result-item.color-green)  { --res-color: #059669; --res-bg: rgba(16, 185, 129, 0.12); }
  :global(.search-result-item.color-purple) { --res-color: #8b5cf6; --res-bg: rgba(139, 92, 246, 0.12); }
  :global(.search-result-item.color-orange) { --res-color: #ea580c; --res-bg: rgba(234, 88, 12, 0.12); }
  :global(.search-result-item.color-cyan)   { --res-color: #0891b2; --res-bg: rgba(8, 145, 178, 0.12); }
  :global(.search-result-item.color-pink)   { --res-color: #db2777; --res-bg: rgba(219, 39, 119, 0.12); }

  :global(.search-result-item:hover),
  :global(.search-result-item.is-highlighted) {
    background-color: color-mix(in srgb, var(--res-color) 8%, var(--bg-primary));
    border-left-color: var(--res-color);
  }

  :global(.search-result-top) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 0.5rem;
  }

  :global(.search-result-title) {
    font-size: 0.94rem;
    font-weight: 750;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  :global(.search-result-item:hover .search-result-title),
  :global(.search-result-item.is-highlighted .search-result-title) {
    color: var(--res-color);
  }

  :global(.search-result-badge) {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--res-bg);
    color: var(--res-color);
    font-size: 0.68rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  :global(.search-result-desc) {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  :global(.search-no-results) {
    padding: 1.25rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
</style>