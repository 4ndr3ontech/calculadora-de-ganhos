---
import { TOOLS_DATA } from '../data/tools';
---

<div class="search-wrapper" role="search">
  <div class="search-box">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" class="search-icon" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" x2="16.65" y1="21" y2="16.65"/>
    </svg>
    <input 
      type="search" 
      id="tool-search-input" 
      placeholder="O que você deseja calcular? (ex: juros compostos, salário líquido...)" 
      aria-label="Pesquisar ferramentas e calculadoras"
      aria-autocomplete="list"
      aria-controls="search-results"
      autocomplete="off"
    />
  </div>
  <div id="search-results" class="search-results-dropdown" role="listbox"></div>
</div>

<script define:vars={{ toolsIndex: TOOLS_DATA }}>
  function setupToolSearch() {
    const input = document.getElementById('tool-search-input');
    const dropdown = document.getElementById('search-results');
    if (!input || !dropdown) return;

    let selectedIndex = -1;

    function normalize(str) {
      return (str || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function updateHighlight(items) {
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          item.setAttribute('aria-selected', 'true');
          item.classList.add('is-highlighted');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.setAttribute('aria-selected', 'false');
          item.classList.remove('is-highlighted');
        }
      });
    }

    input.addEventListener('input', (e) => {
      const query = normalize(e.target.value);
      selectedIndex = -1;

      if (query.length < 2) {
        dropdown.classList.remove('active');
        dropdown.innerHTML = '';
        return;
      }

      const filtered = toolsIndex.filter(t => 
        normalize(t.name).includes(query) || 
        normalize(t.description).includes(query) || 
        normalize(t.category).includes(query) ||
        (t.keywords && t.keywords.some(kw => normalize(kw).includes(query)))
      );

      if (filtered.length > 0) {
        dropdown.innerHTML = filtered.map((item, index) => `
          <a href="${item.route}" class="search-result-item" role="option" id="search-item-${index}">
            <div class="search-result-top">
              <span class="search-result-title">${item.name}</span>
              <span class="search-result-badge">${item.category}</span>
            </div>
            <div class="search-result-desc">${item.description}</div>
          </a>
        `).join('');
        dropdown.classList.add('active');
      } else {
        dropdown.innerHTML = `<div class="search-no-results">Nenhuma ferramenta encontrada para "${e.target.value}"</div>`;
        dropdown.classList.add('active');
      }
    });

    input.addEventListener('keydown', (e) => {
      const items = Array.from(dropdown.querySelectorAll('.search-result-item'));
      if (!dropdown.classList.contains('active') || items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateHighlight(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateHighlight(items);
      } else if (e.key === 'Enter' && selectedIndex >= 0 && items[selectedIndex]) {
        e.preventDefault();
        items[selectedIndex].click();
      } else if (e.key === 'Escape') {
        dropdown.classList.remove('active');
        selectedIndex = -1;
      }
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.remove('active');
        selectedIndex = -1;
      }
    });
  }

  setupToolSearch();
  document.addEventListener('astro:after-swap', setupToolSearch);
</script>

<style>
  .search-wrapper {
    position: relative;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
  }

  .search-box {
    display: flex;
    align-items: center;
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.8rem 1.15rem;
    box-shadow: var(--shadow-md);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-box:focus-within {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
  }

  .search-icon {
    color: var(--text-muted);
    margin-right: 0.85rem;
    flex-shrink: 0;
  }

  #tool-search-input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: 0.95rem;
    color: var(--text-primary);
    outline: none;
  }

  #tool-search-input::placeholder {
    color: var(--text-muted);
  }

  .search-results-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 100%;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    max-height: 360px;
    overflow-y: auto;
    z-index: 60;
    display: none;
    box-sizing: border-box;
  }

  .search-results-dropdown.active {
    display: block;
  }

  .search-result-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.85rem 1.1rem;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border-color);
    transition: background-color 0.15s ease;
  }

  .search-result-item:last-child {
    border-bottom: none;
  }

  .search-result-item:hover,
  .search-result-item.is-highlighted {
    background-color: color-mix(in srgb, var(--color-primary) 10%, var(--bg-secondary));
  }

  .search-result-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .search-result-title {
    font-size: 0.94rem;
    font-weight: 750;
    color: var(--color-primary);
  }

  .search-result-badge {
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-size: 0.68rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .search-result-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .search-no-results {
    padding: 1.25rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
</style>