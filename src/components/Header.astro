---
import Navigation from './Navigation.astro';
---

<header class="site-header">
  <div class="container header-container">
    <div class="header-left" aria-hidden="true"></div>

    <a href="/" class="logo-link" aria-label="Calculadora de Ganhos - Página Inicial">
      <img
        src="/images/logo.svg"
        alt="Calculadora de Ganhos"
        class="brand-logo"
        width="260"
        height="64"
        fetchpriority="high"
      />
    </a>

    <div class="header-actions">
      <button
        id="theme-toggle"
        type="button"
        class="icon-btn btn-theme"
        aria-label="Alternar tema"
        title="Alternar tema"
      >
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/>
          <path d="M12 20v2"/>
          <path d="m4.93 4.93 1.41 1.41"/>
          <path d="m17.66 17.66 1.41 1.41"/>
          <path d="M2 12h2"/>
          <path d="M20 12h2"/>
          <path d="m6.34 17.66-1.41 1.41"/>
          <path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <button
        id="mobile-menu-btn"
        type="button"
        class="icon-btn mobile-menu-btn"
        aria-label="Abrir menu principal"
        aria-expanded="false"
        aria-controls="main-navigation"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <Navigation />
</header>

<script>
  function setupThemeToggle() {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;

    const updateAria = (theme: string) => {
      const label = theme === 'dark' ? 'Ativar modo claro' : 'Ativar modo escuro';
      toggleBtn.setAttribute('aria-label', label);
      toggleBtn.setAttribute('title', label);
    };

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateAria(currentTheme);

    toggleBtn.onclick = () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';

      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateAria(next);
    };
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--bg-secondary) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
  }

  .header-container {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 90px;
  }

  .header-left,
  .header-actions {
    display: flex;
    align-items: center;
    min-width: 42px;
  }

  .header-actions {
    justify-content: flex-end;
    gap: 0.65rem;
  }

  .logo-link {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    height: 58px;
    width: auto;
    transition: transform 0.2s ease;
  }

  .logo-link:hover .brand-logo {
    transform: scale(1.02);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .icon-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-1px);
  }

  .logo-link:focus-visible,
  .icon-btn:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .mobile-menu-btn {
    display: none;
  }

  /* :global garante que o Astro enxergue o data-theme aplicado na tag <html> */
  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: block;
  }

  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }

  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }

  @media (max-width: 768px) {
    .header-container {
      height: 72px;
    }

    .logo-link {
      position: static;
      transform: none;
    }

    .header-left {
      display: none;
    }

    .mobile-menu-btn {
      display: inline-flex;
    }

    .brand-logo {
      height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logo,
    .icon-btn {
      transition: none;
    }

    .logo-link:hover .brand-logo,
    .icon-btn:hover {
      transform: none;
    }
  }
</style>