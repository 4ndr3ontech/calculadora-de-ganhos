---
import { getToolPresentation } from '../data/tool-presentations';

interface Props {
  tool: {
    name: string;
    description: string;
    route: string;
  };
  ctaText?: string;
  dataSearch?: string;
}

const { tool, ctaText = 'Acessar ferramenta', dataSearch } = Astro.props;
const presentation = getToolPresentation(tool.name);
---

<a href={tool.route} class={`featured-tool-card color-${presentation.color}`} data-search={dataSearch}>
  <div class="ftc-top">
    <div class="ftc-icon" aria-hidden="true" set:html={presentation.icon} />
    <span class="ftc-badge">{presentation.label}</span>
  </div>

  <div class="ftc-content">
    <h3>{tool.name}</h3>
    <p>{tool.description}</p>
  </div>

  <div class="ftc-footer">
    <span>{ctaText}</span>
    <span class="ftc-arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .featured-tool-card {
    --tool-color: #2563eb;
    --tool-bg: rgba(37, 99, 235, 0.1);

    display: flex;
    flex-direction: column;
    min-height: 245px;
    padding: 1.55rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    color: inherit;
    text-decoration: none;
    text-align: center;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .featured-tool-card:hover {
    transform: translateY(-4px);
    border-color: var(--tool-color);
    box-shadow: var(--shadow-md);
  }

  .featured-tool-card:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .color-green {
    --tool-color: #059669;
    --tool-bg: rgba(16, 185, 129, 0.12);
  }

  .color-purple {
    --tool-color: #8b5cf6;
    --tool-bg: rgba(139, 92, 246, 0.12);
  }

  .color-orange {
    --tool-color: #ea580c;
    --tool-bg: rgba(234, 88, 12, 0.12);
  }

  .color-cyan {
    --tool-color: #0891b2;
    --tool-bg: rgba(8, 145, 178, 0.12);
  }

  .color-pink {
    --tool-color: #db2777;
    --tool-bg: rgba(219, 39, 119, 0.12);
  }

  .ftc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 1.25rem;
  }

  .ftc-icon {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 12px;
    background: var(--tool-bg);
    color: var(--tool-color);
  }

  .ftc-badge {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--tool-bg);
    color: var(--tool-color);
    font-size: 0.7rem;
    font-weight: 750;
  }

  .ftc-content {
    flex: 1;
  }

  .ftc-content h3 {
    margin: 0 0 0.55rem;
    color: var(--text-primary);
    font-size: 1.12rem;
    font-weight: 750;
    line-height: 1.4;
    text-align: center;
  }

  .ftc-content p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.86rem;
    line-height: 1.65;
    text-align: center;
  }

  .ftc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.35rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--border-color);
    color: var(--tool-color);
    font-size: 0.83rem;
    font-weight: 750;
  }

  .ftc-arrow {
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }

  .featured-tool-card:hover .ftc-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 600px) {
    .featured-tool-card {
      min-height: 205px;
    }
  }
</style>
