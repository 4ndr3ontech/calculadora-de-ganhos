---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calculadora de MDC e MMC Online — Máximo Divisor e Múltiplo Comum"
  description="Calcule MDC e MMC de dois ou mais números. Descubra o máximo divisor comum e o mínimo múltiplo comum entre dois inteiros, com fatoração prima e resolução passo a passo."
>
  <main class="mdc-page">
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/matematica/">Matemática</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">MDC e MMC</span>
    </nav>

    <!-- APRESENTAÇÃO -->
    <header class="page-header">
      <span class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        MATEMÁTICA ONLINE
      </span>

      <h1>Calculadora de <span>MDC e MMC</span></h1>

      <p>
        Encontre o Máximo Divisor Comum e o Mínimo Múltiplo Comum
        entre dois números inteiros. Veja os resultados, a fatoração
        em números primos e a resolução detalhada.
      </p>

      <div class="header-features">
        <span><span class="check" aria-hidden="true">✓</span> Gratuita</span>
        <span><span class="check" aria-hidden="true">✓</span> Resultado instantâneo</span>
        <span><span class="check" aria-hidden="true">✓</span> Passo a passo</span>
      </div>
    </header>

    <!-- CALCULADORA -->
    <section class="calculator-section" aria-labelledby="calculator-title">
      <div class="section-heading">
        <div>
          <span class="section-label">CALCULADORA</span>
          <h2 id="calculator-title">Informe os dois números</h2>
          <p>Digite números inteiros para calcular o MDC e o MMC.</p>
        </div>
        <span class="calculator-tag">ƒx Matemática</span>
      </div>

      <div class="calculator-layout">
        <!-- ENTRADAS -->
        <div class="panel input-panel">
          <div class="panel-heading">
            <div class="panel-icon" aria-hidden="true">∑</div>
            <div>
              <h3>Valores de entrada</h3>
              <p>Escolha os números que deseja comparar.</p>
            </div>
          </div>

          <div class="input-group">
            <label for="num-a">Primeiro número (A)</label>
            <input
              type="number"
              id="num-a"
              value="24"
              step="1"
              inputmode="numeric"
              autocomplete="off"
              aria-describedby="input-hint"
            />
          </div>

          <div class="input-group">
            <label for="num-b">Segundo número (B)</label>
            <input
              type="number"
              id="num-b"
              value="36"
              step="1"
              inputmode="numeric"
              autocomplete="off"
              aria-describedby="input-hint"
            />
          </div>

          <p class="input-hint" id="input-hint">
            Aceita números inteiros positivos, negativos e zero.
          </p>

          <div class="quick-examples">
            <span>Exemplos:</span>
            <button type="button" class="example-btn" data-a="24" data-b="36">24 e 36</button>
            <button type="button" class="example-btn" data-a="12" data-b="18">12 e 18</button>
            <button type="button" class="example-btn" data-a="15" data-b="25">15 e 25</button>
          </div>

          <button type="button" id="calc-btn" class="calculate-button">
            <span>Calcular MDC e MMC</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </button>

          <button type="button" id="clear-btn" class="clear-button">
            Limpar valores
          </button>

          <p id="error-message" class="error-message" role="alert" hidden></p>
        </div>

        <!-- RESULTADOS -->
        <div class="panel results-panel" aria-live="polite" aria-atomic="true">
          <div class="panel-heading">
            <div class="panel-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <div>
              <h3>Resultados do cálculo</h3>
              <p>Valores calculados para os números informados.</p>
            </div>
          </div>

          <div class="result-box result-mdc">
            <div class="result-info">
              <span class="result-label">MÁXIMO DIVISOR COMUM</span>
              <span class="result-acronym">MDC</span>
            </div>
            <strong id="res-mdc">12</strong>
            <p>Maior divisor positivo comum entre A e B.</p>
          </div>

          <div class="result-box result-mmc">
            <div class="result-info">
              <span class="result-label">MÍNIMO MÚLTIPLO COMUM</span>
              <span class="result-acronym">MMC</span>
            </div>
            <strong id="res-mmc">72</strong>
            <p>Menor múltiplo positivo comum entre A e B.</p>
          </div>

          <div class="result-relation">
            <span>Relação entre os resultados</span>
            <strong id="result-relation">12 × 72 = 24 × 36</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- DECOMPOSIÇÃO -->
    <section class="details-section" id="details-section">
      <div class="section-heading">
        <div>
          <span class="section-label">ENTENDA O CÁLCULO</span>
          <h2>Decomposição em fatores primos</h2>
          <p>Veja como cada número pode ser representado por fatores primos.</p>
        </div>
      </div>

      <div class="factor-grid">
        <article class="panel factor-card">
          <span class="factor-label">NÚMERO A</span>
          <h3 id="factor-a-title">24</h3>
          <div class="factor-expression" id="factor-a">2³ × 3</div>
          <p>Decomposição em fatores primos.</p>
        </article>

        <article class="panel factor-card">
          <span class="factor-label">NÚMERO B</span>
          <h3 id="factor-b-title">36</h3>
          <div class="factor-expression" id="factor-b">2² × 3²</div>
          <p>Decomposição em fatores primos.</p>
        </article>
      </div>
    </section>

    <!-- PASSO A PASSO -->
    <section class="details-section">
      <div class="section-heading">
        <div>
          <span class="section-label">RESOLUÇÃO DETALHADA</span>
          <h2>Como chegamos ao resultado?</h2>
          <p>Acompanhe as etapas utilizadas para encontrar o MDC.</p>
        </div>
      </div>

      <div class="panel steps-panel">
        <h3>Algoritmo de Euclides</h3>
        <p class="steps-description">
          O MDC pode ser encontrado por meio de divisões sucessivas.
          O processo termina quando o resto da divisão chega a zero.
        </p>

        <div id="euclid-steps" class="euclid-steps">
          <div class="euclid-step">36 ÷ 24 = 1, resto 12</div>
          <div class="euclid-step">24 ÷ 12 = 2, resto 0</div>
          <div class="euclid-final">MDC = 12</div>
        </div>

        <div class="mmc-explanation">
          <h3>Como calcular o MMC?</h3>
          <p>
            O MMC pode ser calculado utilizando o MDC e a seguinte relação:
          </p>
          <div class="formula-box">
            MMC(A, B) = |A × B| ÷ MDC(A, B)
          </div>
          <p id="mmc-calculation">
            MMC(24, 36) = (24 × 36) ÷ 12 = 72
          </p>
        </div>
      </div>
    </section>

    <!-- CONTEÚDO EDUCATIVO -->
    <section class="content-section">
      <span class="section-label">APRENDA MATEMÁTICA</span>
      <h2>O que são MDC e MMC?</h2>

      <p>
        O Máximo Divisor Comum (MDC) e o Mínimo Múltiplo Comum (MMC)
        são conceitos fundamentais da matemática. Eles permitem
        identificar relações entre números inteiros e são utilizados
        em problemas envolvendo divisibilidade, frações, proporções
        e organização de quantidades.
      </p>

      <div class="concept-grid">
        <article class="concept-card">
          <div class="concept-icon mdc-icon" aria-hidden="true">÷</div>
          <h3>Máximo Divisor Comum (MDC)</h3>
          <p>
            É o maior número inteiro positivo que consegue dividir
            dois ou mais números sem deixar resto.
          </p>
          <div class="concept-example">
            <strong>Exemplo: 24 e 36</strong>
            <span>Divisores comuns: 1, 2, 3, 4, 6 e 12.</span>
            <b>MDC = 12</b>
          </div>
        </article>

        <article class="concept-card">
          <div class="concept-icon mmc-icon" aria-hidden="true">×</div>
          <h3>Mínimo Múltiplo Comum (MMC)</h3>
          <p>
            É o menor número inteiro positivo que é múltiplo
            de dois ou mais números simultaneamente.
          </p>
          <div class="concept-example">
            <strong>Exemplo: 24 e 36</strong>
            <span>Primeiro múltiplo positivo comum: 72.</span>
            <b>MMC = 72</b>
          </div>
        </article>
      </div>

      <h2>Quando utilizar o MDC e o MMC?</h2>

      <div class="application-grid">
        <article class="application-card">
          <span>01</span>
          <h3>Divisão de quantidades</h3>
          <p>
            O MDC ajuda a dividir objetos ou materiais em grupos
            iguais, sem sobras e com o maior tamanho possível.
          </p>
        </article>

        <article class="application-card">
          <span>02</span>
          <h3>Organização de eventos</h3>
          <p>
            O MMC permite descobrir quando eventos que acontecem
            em intervalos diferentes voltarão a coincidir.
          </p>
        </article>

        <article class="application-card">
          <span>03</span>
          <h3>Operações com frações</h3>
          <p>
            O MMC é utilizado para encontrar denominadores comuns
            durante a soma e a subtração de frações.
          </p>
        </article>

        <article class="application-card">
          <span>04</span>
          <h3>Estudos e exercícios</h3>
          <p>
            Os dois conceitos aparecem em problemas de
            divisibilidade, fatoração e matemática básica.
          </p>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <span class="section-label">DÚVIDAS FREQUENTES</span>
      <h2>Perguntas sobre MDC e MMC</h2>

      <details>
        <summary>Qual é a diferença entre MDC e MMC?</summary>
        <p>
          O MDC é o maior divisor positivo comum entre dois números.
          Já o MMC é o menor múltiplo positivo comum entre eles.
          Os dois conceitos são utilizados em diferentes operações matemáticas.
        </p>
      </details>

      <details>
        <summary>Como calcular MDC de dois números?</summary>
        <p>
          Uma das maneiras mais eficientes é utilizar o algoritmo de
          Euclides, realizando divisões sucessivas até encontrar resto zero.
          O último resto diferente de zero corresponde ao MDC.
        </p>
      </details>

      <details>
        <summary>Como calcular MMC de dois números?</summary>
        <p>
          Você pode utilizar a fatoração em números primos ou a relação
          entre MMC e MDC. Para dois números não simultaneamente nulos,
          o MMC é o produto dos valores absolutos dividido pelo MDC.
        </p>
      </details>

      <details>
        <summary>O MDC pode ser maior que os números?</summary>
        <p>
          Não. O MDC de dois números não nulos não pode ser maior
          que o menor dos seus valores absolutos.
        </p>
      </details>

      <details>
        <summary>O MMC pode ser zero?</summary>
        <p>
          Se um dos números for zero e o outro for diferente de zero,
          o MMC é zero. Quando os dois números são zero, adotamos
          a convenção de MMC(0, 0) = 0 nesta calculadora.
        </p>
      </details>

      <details>
        <summary>Posso calcular MDC e MMC com números negativos?</summary>
        <p>
          Sim. O MDC e o MMC são calculados considerando os valores
          absolutos dos números. Assim, os resultados são apresentados
          como valores não negativos.
        </p>
      </details>

      <details>
        <summary>Preciso instalar algum programa?</summary>
        <p>
          Não. A calculadora funciona diretamente no navegador,
          sem instalação ou cadastro.
        </p>
      </details>

      <details>
        <summary>A calculadora é gratuita?</summary>
        <p>
          Sim. Você pode utilizar a ferramenta gratuitamente sempre
          que precisar calcular o MDC e o MMC.
        </p>
      </details>
    </section>

    <!-- CTA -->
    <section class="bottom-cta">
      <div>
        <span class="section-label">CALCULADORA DE GANHOS</span>
        <h2>Continue explorando nossas ferramentas matemáticas.</h2>
        <p>
          Encontre outros recursos gratuitos para facilitar seus cálculos.
        </p>
      </div>
      <a href="/matematica/" class="cta-button">
        <span>Ver calculadoras matemáticas</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </section>
  </main>

  <script>
    import {
      calcularMDC,
      calcularMMC
    } from '../../engines/math/advanced-math-engine';

    const inputA = document.querySelector<HTMLInputElement>('#num-a');
    const inputB = document.querySelector<HTMLInputElement>('#num-b');
    const calcButton = document.querySelector<HTMLButtonElement>('#calc-btn');
    const clearButton = document.querySelector<HTMLButtonElement>('#clear-btn');
    const errorMessage = document.querySelector<HTMLElement>('#error-message');

    const resultMdc = document.querySelector<HTMLElement>('#res-mdc');
    const resultMmc = document.querySelector<HTMLElement>('#res-mmc');
    const resultRelation = document.querySelector<HTMLElement>('#result-relation');

    const factorATitle = document.querySelector<HTMLElement>('#factor-a-title');
    const factorBTitle = document.querySelector<HTMLElement>('#factor-b-title');
    const factorA = document.querySelector<HTMLElement>('#factor-a');
    const factorB = document.querySelector<HTMLElement>('#factor-b');

    const euclidSteps = document.querySelector<HTMLElement>('#euclid-steps');
    const mmcCalculation = document.querySelector<HTMLElement>('#mmc-calculation');

    const numberFormatter = new Intl.NumberFormat('pt-BR');

    const MAX_SAFE = Number.MAX_SAFE_INTEGER;
    const MAX_FACTORIZATION = 1_000_000_000_000;

    function formatNumber(value: number): string {
      return numberFormatter.format(value);
    }

    function gcdSteps(a: number, b: number): string[] {
      let x = Math.abs(a);
      let y = Math.abs(b);

      const steps: string[] = [];

      if (x === 0 && y === 0) {
        return ['MDC(0, 0) = 0, pela convenção adotada.'];
      }

      if (x === 0 || y === 0) {
        const result = Math.max(x, y);
        steps.push(`MDC(${formatNumber(a)}, ${formatNumber(b)}) = ${formatNumber(result)}`);
        return steps;
      }

      while (y !== 0) {
        const quotient = Math.floor(x / y);
        const remainder = x % y;

        steps.push(
          `${formatNumber(x)} ÷ ${formatNumber(y)} = ${quotient}, resto ${formatNumber(remainder)}`
        );

        x = y;
        y = remainder;
      }

      steps.push(`MDC = ${formatNumber(x)}`);

      return steps;
    }

    function primeFactorization(value: number): string {
      let n = Math.abs(value);

      if (n === 0) return 'Não definida para zero.';
      if (n === 1) return '1 (sem fatores primos).';

      if (n > MAX_FACTORIZATION) {
        return 'Valor muito grande para exibir a fatoração.';
      }

      const factors: string[] = [];

      let exponent = 0;

      while (n % 2 === 0) {
        exponent++;
        n /= 2;
      }

      if (exponent > 0) {
        factors.push(exponent > 1 ? `2${toSuperscript(exponent)}` : '2');
      }

      for (let divisor = 3; divisor * divisor <= n; divisor += 2) {
        exponent = 0;

        while (n % divisor === 0) {
          exponent++;
          n /= divisor;
        }

        if (exponent > 0) {
          factors.push(
            exponent > 1
              ? `${formatNumber(divisor)}${toSuperscript(exponent)}`
              : formatNumber(divisor)
          );
        }
      }

      if (n > 1) {
        factors.push(formatNumber(n));
      }

      return factors.join(' × ');
    }

    function toSuperscript(value: number): string {
      const digits: Record<string, string> = {
        '0': '⁰',
        '1': '¹',
        '2': '²',
        '3': '³',
        '4': '⁴',
        '5': '⁵',
        '6': '⁶',
        '7': '⁷',
        '8': '⁸',
        '9': '⁹'
      };

      return String(value)
        .split('')
        .map(digit => digits[digit])
        .join('');
    }

    function showError(message: string): void {
      if (errorMessage) {
        errorMessage.textContent = message;
        errorMessage.hidden = false;
      }

      inputA?.setAttribute('aria-invalid', 'true');
      inputB?.setAttribute('aria-invalid', 'true');
    }

    function clearError(): void {
      if (errorMessage) {
        errorMessage.textContent = '';
        errorMessage.hidden = true;
      }

      inputA?.removeAttribute('aria-invalid');
      inputB?.removeAttribute('aria-invalid');
    }

    function clearResults(): void {
      if (resultMdc) resultMdc.textContent = '—';
      if (resultMmc) resultMmc.textContent = '—';
      if (resultRelation) resultRelation.textContent = 'Aguardando valores';

      if (factorATitle) factorATitle.textContent = '—';
      if (factorBTitle) factorBTitle.textContent = '—';
      if (factorA) factorA.textContent = '—';
      if (factorB) factorB.textContent = '—';

      if (euclidSteps) {
        euclidSteps.innerHTML = '<p class="steps-placeholder">Informe dois números para visualizar a resolução.</p>';
      }

      if (mmcCalculation) {
        mmcCalculation.textContent = 'Aguardando valores para calcular.';
      }
    }

    function runCalc(): void {
      if (!inputA || !inputB) return;

      clearError();

      const rawA = inputA.value.trim();
      const rawB = inputB.value.trim();

      if (rawA === '' || rawB === '') {
        clearResults();
        showError('Informe os dois números para realizar o cálculo.');
        return;
      }

      const a = Number(rawA);
      const b = Number(rawB);

      if (!Number.isSafeInteger(a) || !Number.isSafeInteger(b)) {
        clearResults();
        showError('Informe apenas números inteiros dentro do limite de precisão suportado.');
        return;
      }

      try {
        const mdc = Math.abs(calcularMDC(a, b));
        const mmc = Math.abs(calcularMMC(a, b));

        if (!Number.isSafeInteger(mdc) || !Number.isSafeInteger(mmc)) {
          clearResults();
          showError('O resultado ultrapassa o limite de precisão numérica suportado. Tente números menores.');
          return;
        }

        if (resultMdc) resultMdc.textContent = formatNumber(mdc);
        if (resultMmc) resultMmc.textContent = formatNumber(mmc);

        if (resultRelation) {
          if (a === 0 || b === 0) {
            resultRelation.textContent = 'Produto dos números = 0';
          } else {
            resultRelation.textContent =
              `${formatNumber(mdc)} × ${formatNumber(mmc)} = ${formatNumber(Math.abs(a * b))}`;
          }
        }

        if (factorATitle) factorATitle.textContent = formatNumber(a);
        if (factorBTitle) factorBTitle.textContent = formatNumber(b);

        if (factorA) factorA.textContent = primeFactorization(a);
        if (factorB) factorB.textContent = primeFactorization(b);

        if (euclidSteps) {
          euclidSteps.replaceChildren();

          gcdSteps(a, b).forEach((step, index, array) => {
            const element = document.createElement('div');

            element.className =
              index === array.length - 1
                ? 'euclid-final'
                : 'euclid-step';

            element.textContent = step;
            euclidSteps.appendChild(element);
          });
        }

        if (mmcCalculation) {
          if (a === 0 || b === 0) {
            mmcCalculation.textContent =
              `MMC(${formatNumber(a)}, ${formatNumber(b)}) = 0`;
          } else {
            mmcCalculation.textContent =
              `MMC(${formatNumber(a)}, ${formatNumber(b)}) = (${formatNumber(Math.abs(a))} × ${formatNumber(Math.abs(b))}) ÷ ${formatNumber(mdc)} = ${formatNumber(mmc)}`;
          }
        }
      } catch (error) {
        clearResults();
        showError('Não foi possível realizar o cálculo. Verifique os valores e tente novamente.');
        console.error('Erro ao calcular MDC e MMC:', error);
      }
    }

    calcButton?.addEventListener('click', runCalc);

    inputA?.addEventListener('input', runCalc);
    inputB?.addEventListener('input', runCalc);

    clearButton?.addEventListener('click', () => {
      if (inputA) inputA.value = '';
      if (inputB) inputB.value = '';

      clearError();
      clearResults();
      inputA?.focus();
    });

    document.querySelectorAll<HTMLButtonElement>('.example-btn').forEach(button => {
      button.addEventListener('click', () => {
        if (!inputA || !inputB) return;

        inputA.value = button.dataset.a || '';
        inputB.value = button.dataset.b || '';

        runCalc();
      });
    });

    runCalc();
  </script>

  <style>
    .mdc-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 20px 70px;
      color: var(--text-primary);
    }

    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      margin: 25px 0;
      color: var(--text-secondary);
      font-size: .84rem;
    }

    .breadcrumb a {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--color-primary);
    }

    .page-header {
      padding: 42px 0 35px;
      max-width: 820px;
    }

    .eyebrow,
    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--color-primary);
      font-size: .73rem;
      font-weight: 800;
      letter-spacing: 1.3px;
    }

    .eyebrow-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--color-primary);
    }

    .page-header h1 {
      margin: 18px 0 15px;
      font-size: clamp(2.2rem, 5vw, 3.4rem);
      line-height: 1.12;
      letter-spacing: -1.8px;
      font-weight: 850;
    }

    .page-header h1 span {
      color: var(--color-primary);
    }

    .page-header > p {
      max-width: 740px;
      color: var(--text-secondary);
      font-size: 1.02rem;
      line-height: 1.8;
    }

    .header-features {
      display: flex;
