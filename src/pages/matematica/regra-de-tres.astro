---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calculadora de Regra de Três Simples Online — Direta e Inversa | Calculadora de Ganhos"
  description="Resolva regra de três simples direta e inversa gratuitamente. Calcule proporções, descubra o valor de X e confira a resolução passo a passo."
>
  <main class="rule-page">
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/matematica/">Matemática</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Regra de Três Simples</span>
    </nav>

    <header class="page-header">
      <span class="eyebrow">FERRAMENTAS MATEMÁTICAS</span>
      <h1>Calculadora de Regra de Três Simples</h1>
      <p>
        Resolva problemas de proporção direta e inversa. Informe três valores,
        descubra o quarto valor desconhecido e acompanhe a explicação do cálculo.
      </p>
    </header>

    <section class="calculator card" aria-labelledby="calculator-title">
      <div class="calculator-heading">
        <div>
          <span class="section-label">CALCULADORA ONLINE</span>
          <h2 id="calculator-title">Informe os valores da proporção</h2>
        </div>
        <div class="calculator-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
      </div>

      <div class="type-selector" role="group" aria-label="Tipo de proporcionalidade">
        <button
          type="button"
          class="type-option active"
          data-type="direct"
          aria-pressed="true"
        >
          <span class="type-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </span>
          <span>
            <strong>Diretamente proporcional</strong>
            <small>Uma grandeza aumenta junto com a outra.</small>
          </span>
        </button>

        <button
          type="button"
          class="type-option"
          data-type="inverse"
          aria-pressed="false"
        >
          <span class="type-icon inverse-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="7" x2="16" y2="17"></line>
              <polyline points="12 17 16 17 16 13"></polyline>
              <polyline points="12 7 8 7 8 11"></polyline>
            </svg>
          </span>
          <span>
            <strong>Inversamente proporcional</strong>
            <small>Uma grandeza aumenta enquanto a outra diminui.</small>
          </span>
        </button>
      </div>

      <div class="calculator-grid">
        <div class="input-panel">
          <div class="proportion-explanation" id="proportion-explanation">
            Na proporção direta, quando uma grandeza aumenta, a outra também
            aumenta na mesma proporção.
          </div>

          <div class="proportion-label">
            <span>PRIMEIRA GRANDEZA</span>
            <span>SEGUNDA GRANDEZA</span>
          </div>

          <div class="proportion-grid">
            <div class="field">
              <label for="val-a">Valor A</label>
              <input
                type="number"
                id="val-a"
                value="10"
                step="any"
                inputmode="decimal"
                placeholder="Ex.: 10"
              />
            </div>

            <div class="field">
              <label for="val-b">Valor B</label>
              <input
                type="number"
                id="val-b"
                value="50"
                step="any"
                inputmode="decimal"
                placeholder="Ex.: 50"
              />
            </div>

            <div class="proportion-symbol" aria-hidden="true">↓</div>
            <div class="proportion-symbol" aria-hidden="true">↓</div>

            <div class="field">
              <label for="val-c">Valor C</label>
              <input
                type="number"
                id="val-c"
                value="30"
                step="any"
                inputmode="decimal"
                placeholder="Ex.: 30"
              />
            </div>

            <div class="field result-input">
              <label for="val-x">Valor X (desconhecido)</label>
              <input
                type="text"
                id="val-x"
                value="?"
                readonly
                aria-label="Resultado calculado de X"
              />
            </div>
          </div>

          <div class="proportion-relation" id="proportion-relation">
            10 está para 50 assim como 30 está para X.
          </div>

          <div class="examples">
            <span>Experimente um exemplo:</span>
            <button type="button" data-example="direct">Preço e quantidade</button>
            <button type="button" data-example="inverse">Velocidade e tempo</button>
            <button type="button" data-example="workers">Trabalhadores e prazo</button>
          </div>

          <button type="button" id="calc-btn" class="calculate-button">
            <span>Calcular valor de X</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </button>

          <p class="privacy-note">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Cálculos realizados diretamente no seu navegador.
          </p>
        </div>

        <div class="result-panel" aria-live="polite" aria-atomic="true">
          <div class="result-header">
            <span class="result-label">RESULTADO DO CÁLCULO</span>
            <span class="result-type" id="result-type">DIRETA</span>
          </div>

          <div class="main-result">
            <span class="result-caption">Valor encontrado para X</span>
            <strong id="res-x">150</strong>
          </div>

          <div class="formula-heading">
            <strong>Memória de cálculo</strong>
            <span class="formula-tag">PASSO A PASSO</span>
          </div>

          <div class="formula-item">
            <span>1. Montagem da proporção</span>
            <p id="formula-proportion">10 / 50 = 30 / X</p>
          </div>

          <div class="formula-item">
            <span>2. Multiplicação cruzada</span>
            <p id="formula-cross">10 × X = 50 × 30</p>
          </div>

          <div class="formula-item">
            <span>3. Resultado</span>
            <p id="formula-result">X = (50 × 30) ÷ 10 = 150</p>
          </div>

          <div class="result-observation" id="result-observation">
            <strong>Proporção direta</strong>
            <p>
              Como o valor da primeira grandeza aumentou, o valor da segunda
              também aumentou.
            </p>
          </div>
        </div>
      </div>

      <p class="error-message" id="error-message" role="alert" hidden></p>
    </section>

    <section class="info-section">
      <div class="section-heading">
        <span class="section-label">APRENDA MATEMÁTICA</span>
        <h2>O que é regra de três simples?</h2>
        <p>
          A regra de três simples é um método matemático utilizado para
          encontrar um valor desconhecido quando existe uma relação de
          proporcionalidade entre duas grandezas.
        </p>
      </div>

      <div class="concept-grid">
        <article class="concept-card">
          <div class="concept-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
          <h3>Regra de três direta</h3>
          <p>
            Duas grandezas são diretamente proporcionais quando aumentam
            ou diminuem juntas, mantendo a mesma relação proporcional.
          </p>

          <div class="example-box">
            <span>Exemplo prático</span>
            <strong>2 camisetas = R$ 100</strong>
            <strong>5 camisetas = X</strong>
            <small>Quanto maior a quantidade, maior o preço.</small>
          </div>

          <div class="formula-box">
            <span>Fórmula</span>
            <strong>X = (B × C) ÷ A</strong>
          </div>
        </article>

        <article class="concept-card">
          <div class="concept-icon inverse-concept" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="7" x2="16" y2="17"></line>
              <polyline points="12 17 16 17 16 13"></polyline>
              <polyline points="12 7 8 7 8 11"></polyline>
            </svg>
          </div>
          <h3>Regra de três inversa</h3>
          <p>
            Duas grandezas são inversamente proporcionais quando uma aumenta
            enquanto a outra diminui, mantendo o produto constante.
          </p>

          <div class="example-box">
            <span>Exemplo prático</span>
            <strong>4 trabalhadores = 12 dias</strong>
            <strong>8 trabalhadores = X</strong>
            <small>Mais trabalhadores podem reduzir o prazo.</small>
          </div>

          <div class="formula-box">
            <span>Fórmula</span>
            <strong>X = (A × B) ÷ C</strong>
          </div>
        </article>
      </div>
    </section>

    <section class="info-section">
      <div class="section-heading">
        <span class="section-label">EXEMPLOS RESOLVIDOS</span>
        <h2>Como aplicar a regra de três?</h2>
      </div>

      <div class="worked-example">
        <h3>Exemplo 1: proporção direta</h3>
        <p>
          Se 3 produtos custam R$ 60, quanto custarão 8 produtos,
          considerando que todos possuem o mesmo preço?
        </p>

        <div class="worked-equation">
          <span>3 produtos → R$ 60</span>
          <span>8 produtos → X</span>
        </div>

        <div class="worked-calculation">
          X = (60 × 8) ÷ 3
          <strong>X = R$ 160,00</strong>
        </div>
      </div>

      <div class="worked-example">
        <h3>Exemplo 2: proporção inversa</h3>
        <p>
          Se 4 trabalhadores realizam uma tarefa em 12 dias,
          em quantos dias 6 trabalhadores realizariam a mesma tarefa,
          considerando produtividade igual?
        </p>

        <div class="worked-equation">
          <span>4 trabalhadores → 12 dias</span>
          <span>6 trabalhadores → X dias</span>
        </div>

        <div class="worked-calculation">
          X = (4 × 12) ÷ 6
          <strong>X = 8 dias</strong>
        </div>
      </div>
    </section>

    <section class="info-section">
      <div class="section-heading">
        <span class="section-label">APLICAÇÕES PRÁTICAS</span>
        <h2>Onde a regra de três é utilizada?</h2>
      </div>

      <div class="uses-grid">
        <article class="use-card">
          <div class="use-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
          </div>
          <div>
            <h3>Compras e descontos</h3>
            <p>Comparação de preços, quantidades e valores proporcionais.</p>
          </div>
        </article>

        <article class="use-card">
          <div class="use-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div>
            <h3>Velocidade e tempo</h3>
            <p>Resolução de problemas envolvendo distância, velocidade e duração.</p>
          </div>
        </article>

        <article class="use-card">
          <div class="use-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <div>
            <h3>Trabalho e produtividade</h3>
            <p>Estimativas de prazo e quantidade de trabalhadores.</p>
          </div>
        </article>

        <article class="use-card">
          <div class="use-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
          </div>
          <div>
            <h3>Receitas e proporções</h3>
            <p>Ajuste de ingredientes conforme o número de porções.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="faq-section">
      <span class="section-label">DÚVIDAS FREQUENTES</span>
      <h2>Perguntas sobre regra de três</h2>

      <details>
        <summary>Qual é a diferença entre regra de três direta e inversa?</summary>
        <p>
          Na direta, as duas grandezas variam no mesmo sentido. Na inversa,
          elas variam em sentidos opostos. A identificação correta depende
          da relação entre as grandezas do problema.
        </p>
      </details>

      <details>
        <summary>Como saber se a regra de três é direta ou inversa?</summary>
        <p>
          Pergunte o que acontece com uma grandeza quando a outra aumenta.
          Se ambas aumentam ou ambas diminuem proporcionalmente, a relação
          é direta. Se uma aumenta e a outra diminui proporcionalmente,
          a relação é inversa.
        </p>
      </details>

      <details>
        <summary>Qual é a fórmula da regra de três simples direta?</summary>
        <p>
          Considerando A/B = C/X, a fórmula é X = (B × C) ÷ A.
        </p>
      </details>

      <details>
        <summary>Qual é a fórmula da regra de três simples inversa?</summary>
        <p>
          Considerando grandezas inversamente proporcionais, a fórmula
          é X = (A × B) ÷ C.
        </p>
      </details>

      <details>
        <summary>Posso utilizar números decimais?</summary>
        <p>
          Sim. A calculadora aceita números inteiros, decimais e negativos.
          Entretanto, o significado da proporcionalidade e a validade dos
          valores precisam ser considerados conforme o problema.
        </p>
      </details>

      <details>
        <summary>O que acontece se o valor A for zero?</summary>
        <p>
          Não é possível utilizar a fórmula da proporção direta quando A
          é zero, pois isso provocaria uma divisão por zero. Na proporção
          inversa, o valor C também não pode ser zero.
        </p>
      </details>
    </section>

    <section class="bottom-cta">
      <h2>Continue aprendendo matemática</h2>
      <p>
        Explore outras calculadoras gratuitas e encontre ferramentas
        para facilitar seus estudos e cálculos do dia a dia.
      </p>
      <a href="/matematica/" class="back-link">
        <span>Ver todas as ferramentas matemáticas</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </section>
  </main>

  <script>
    import { calculateRuleOfThreeSimple } from '../../engines/math/rule-of-three';

    type ProportionType = 'direct' | 'inverse';

    const aInput = document.getElementById('val-a') as HTMLInputElement;
    const bInput = document.getElementById('val-b') as HTMLInputElement;
    const cInput = document.getElementById('val-c') as HTMLInputElement;
    const xInput = document.getElementById('val-x') as HTMLInputElement;

    const resultOutput = document.getElementById('res-x')!;
    const relationOutput = document.getElementById('proportion-relation')!;
    const explanationOutput = document.getElementById('proportion-explanation')!;
    const typeOutput = document.getElementById('result-type')!;
    const observationOutput = document.getElementById('result-observation')!;
    const errorOutput = document.getElementById('error-message')!;

    const formulaProportion = document.getElementById('formula-proportion')!;
    const formulaCross = document.getElementById('formula-cross')!;
    const formulaResult = document.getElementById('formula-result')!;

    const typeButtons = document.querySelectorAll<HTMLButtonElement>('[data-type]');
    const exampleButtons = document.querySelectorAll<HTMLButtonElement>('[data-example]');

    let currentType: ProportionType = 'direct';

    function formatNumber(value: number): string {
      return value.toLocaleString('pt-BR', {
        maximumFractionDigits: 8
      });
    }

    function clearError() {
      errorOutput.hidden = true;
      errorOutput.textContent = '';
    }

    function updateObservation() {
      if (currentType === 'direct') {
        observationOutput.innerHTML =
          '<strong>Proporção direta</strong><p>As grandezas variam no mesmo sentido. A relação entre os valores permanece proporcional.</p>';
      } else {
        observationOutput.innerHTML =
          '<strong>Proporção inversa</strong><p>As grandezas variam em sentidos opostos. O produto dos valores correspondentes permanece constante.</p>';
      }
    }

    function clearResults() {
      resultOutput.textContent = '—';
      xInput.value = '—';

      if (currentType === 'direct') {
        formulaProportion.textContent = 'A / B = C / X';
        formulaCross.textContent = 'A × X = B × C';
        formulaResult.textContent = 'X = (B × C) ÷ A';
      } else {
        formulaProportion.textContent = 'A × B = C × X';
        formulaCross.textContent = 'A × B = C × X';
        formulaResult.textContent = 'X = (A × B) ÷ C';
      }

      updateObservation();
    }

    function showError(message: string) {
      clearResults();

      errorOutput.textContent = message;
      errorOutput.hidden = false;
    }

    function updateRelation() {
      if (currentType === 'direct') {
        relationOutput.textContent =
          `${aInput.value || 'A'} está para ${bInput.value || 'B'} assim como ${cInput.value || 'C'} está para X.`;
      } else {
        relationOutput.textContent =
          `${aInput.value || 'A'} corresponde a ${bInput.value || 'B'}, assim como ${cInput.value || 'C'} corresponde a X.`;
      }
    }

    function setType(type: ProportionType) {
      currentType = type;

      typeButtons.forEach((button) => {
        const active = button.dataset.type === type;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      if (type === 'direct') {
        typeOutput.textContent = 'DIRETA';

        explanationOutput.textContent =
          'Na proporção direta, quando uma grandeza aumenta, a outra também aumenta na mesma proporção.';
      } else {
        typeOutput.textContent = 'INVERSA';

        explanationOutput.textContent =
          'Na proporção inversa, quando uma grandeza aumenta, a outra diminui proporcionalmente.';
      }

      updateObservation();
      runCalc();
    }

    function runCalc() {
      clearError();
      updateRelation();

      const rawValues = [
        aInput.value.trim(),
        bInput.value.trim(),
        cInput.value.trim()
      ];

      if (rawValues.some((value) => value === '')) {
        showError('Preencha os três valores para calcular o resultado.');
        return;
      }

      const a = Number(rawValues[0]);
      const b = Number(rawValues[1]);
      const c = Number(rawValues[2]);

      if (![a, b, c].every(Number.isFinite)) {
        showError('Informe somente números válidos.');
        return;
      }

      if (currentType === 'direct' && a === 0) {
        showError(
          'O valor A não pode ser zero na proporção direta, pois seria necessário dividir por zero.'
        );
        return;
      }

      if (currentType === 'inverse' && c === 0) {
        showError(
          'O valor C não pode ser zero na proporção inversa, pois seria necessário dividir por zero.'
        );
        return;
      }

      try {
        /*
         * Direta:
         * X = (B × C) ÷ A
         *
         * Inversa:
         * X = (A × B) ÷ C
         *
         * Para a inversa, reorganizamos os argumentos da função:
         * calculateRuleOfThreeSimple(C, A, B)
         *
         * Assim, o motor existente é utilizado nos dois casos.
         */
        const result = currentType === 'direct'
          ? calculateRuleOfThreeSimple(a, b, c)
          : calculateRuleOfThreeSimple(c, a, b);

        if (!Number.isFinite(result)) {
          showError(
            'Não foi possível obter um resultado válido. Verifique os valores informados.'
          );
          return;
        }

        const formattedA = formatNumber(a);
        const formattedB = formatNumber(b);
        const formattedC = formatNumber(c);
        const formattedResult = formatNumber(result);

        resultOutput.textContent = formattedResult;
        xInput.value = formattedResult;

        if (currentType === 'direct') {
          formulaProportion.textContent =
            `${formattedA} / ${formattedB} = ${formattedC} / X`;

          formulaCross.textContent =
            `${formattedA} × X = ${formattedB} × ${formattedC}`;

          formulaResult.textContent =
            `X = (${formattedB} × ${formattedC}) ÷ ${formattedA} = ${formattedResult}`;
        } else {
          formulaProportion.textContent =
            `${formattedA} × ${formattedB} = ${formattedC} × X`;

          formulaCross.textContent =
            `${formattedA} × ${formattedB} = ${formattedC} × X`;

          formulaResult.textContent =
            `X = (${formattedA} × ${formattedB}) ÷ ${formattedC} = ${formattedResult}`;
        }

        updateObservation();
      } catch (error) {
        console.error('Erro no cálculo da regra de três:', error);

        showError(
          'Ocorreu um erro durante o cálculo. Tente novamente.'
        );
      }
    }

    const examples: Record<string, {
      type: ProportionType;
      a: number;
      b: number;
      c: number;
    }> = {
      direct: {
        type: 'direct',
        a: 2,
        b: 100,
        c: 5
      },
      inverse: {
        type: 'inverse',
        a: 60,
        b: 2,
        c: 120
      },
      workers: {
        type: 'inverse',
        a: 4,
        b: 12,
        c: 6
      }
    };

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const type = button.dataset.type;

        if (type === 'direct' || type === 'inverse') {
          setType(type);
        }
      });
    });

    exampleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const example = examples[button.dataset.example || ''];

        if (!example) return;

        aInput.value = String(example.a);
        bInput.value = String(example.b);
        cInput.value = String(example.c);

        setType(example.type);
      });
    });

    document.getElementById('calc-btn')?.addEventListener('click', runCalc);

    [aInput, bInput, cInput].forEach((input) => {
      input.addEventListener('input', runCalc);
    });

    runCalc();
  </script>

