---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calculadora de PA e PG Online — Progressões Aritméticas e Geométricas | Calculadora de Ganhos"
  description="Calcule termos e somas de Progressões Aritméticas (PA) e Geométricas (PG). Descubra sequências, razões e fórmulas gratuitamente."
>
  <main class="progression-page">
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/matematica/">Matemática</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Progressões (PA e PG)</span>
    </nav>

    <header class="page-header">
      <span class="eyebrow">FERRAMENTAS MATEMÁTICAS</span>
      <h1>Calculadora de PA e PG</h1>
      <p>
        Resolva progressões aritméticas e geométricas com facilidade.
        Calcule qualquer termo, descubra a soma acumulada e visualize
        a sequência numérica completa.
      </p>
    </header>

    <section class="calculator card" aria-labelledby="calculator-title">
      <div class="calculator-heading">
        <div>
          <span class="section-label">CALCULADORA ONLINE</span>
          <h2 id="calculator-title">Parâmetros da progressão</h2>
        </div>
        <div class="calculator-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </div>
      </div>

      <div class="progression-selector" role="group" aria-label="Tipo de progressão">
        <button
          type="button"
          class="progression-option active"
          data-type="pa"
          aria-pressed="true"
        >
          <span class="option-symbol">PA</span>
          <span>
            <strong>Progressão Aritmética</strong>
            <small>Adição ou subtração constante</small>
          </span>
        </button>

        <button
          type="button"
          class="progression-option"
          data-type="pg"
          aria-pressed="false"
        >
          <span class="option-symbol">PG</span>
          <span>
            <strong>Progressão Geométrica</strong>
            <small>Multiplicação por uma razão constante</small>
          </span>
        </button>
      </div>

      <div class="calculator-content">
        <div class="input-panel">
          <div class="mode-description" id="mode-description">
            Na PA, cada termo é obtido adicionando a mesma razão ao termo anterior.
          </div>

          <div class="field">
            <label for="val-a1">Primeiro termo (a₁)</label>
            <input
              type="number"
              id="val-a1"
              value="3"
              step="any"
              inputmode="decimal"
              placeholder="Ex.: 3"
            />
            <small>Valor inicial da sequência numérica.</small>
          </div>

          <div class="field">
            <label for="val-razao" id="ratio-label">Razão (r)</label>
            <input
              type="number"
              id="val-razao"
              value="2"
              step="any"
              inputmode="decimal"
              placeholder="Ex.: 2"
            />
            <small id="ratio-description">
              Valor somado ou subtraído a cada termo.
            </small>
          </div>

          <div class="field">
            <label for="val-n">Posição do termo desejado (n)</label>
            <input
              type="number"
              id="val-n"
              value="10"
              min="1"
              max="10000"
              step="1"
              inputmode="numeric"
              placeholder="Ex.: 10"
            />
            <small>Informe a posição do termo que deseja calcular.</small>
          </div>

          <div class="examples">
            <span>Exemplos rápidos:</span>
            <button type="button" data-example="pa-basic">PA crescente</button>
            <button type="button" data-example="pa-negative">PA decrescente</button>
            <button type="button" data-example="pg-basic">PG crescente</button>
            <button type="button" data-example="pg-fraction">PG fracionária</button>
          </div>

          <button type="button" id="calc-btn" class="calculate-button">
            <span>Calcular progressão</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </button>

          <p class="privacy-note">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Cálculos realizados diretamente no seu navegador.
          </p>
        </div>

        <div class="result-panel" aria-live="polite" aria-atomic="true">
          <div class="result-header">
            <span class="result-label">RESULTADOS DA PROGRESSÃO</span>
            <span class="result-type" id="result-type">PA</span>
          </div>

          <div class="main-result">
            <span class="result-caption" id="label-termo">Valor do termo (a₁₀)</span>
            <strong id="res-termo">21</strong>
          </div>

          <div class="secondary-result">
            <span class="result-caption">Soma dos primeiros termos (Sₙ)</span>
            <strong id="res-soma">120</strong>
          </div>

          <div class="result-divider" aria-hidden="true"></div>

          <div class="formula-heading">
            <strong>Memória de cálculo</strong>
            <span class="formula-tag">FÓRMULA</span>
          </div>

          <div class="formula-item">
            <span>Termo geral</span>
            <p id="formula-termo">aₙ = a₁ + (n − 1) × r</p>
          </div>

          <div class="formula-item">
            <span>Soma dos termos</span>
            <p id="formula-soma">Sₙ = n × (a₁ + aₙ) ÷ 2</p>
          </div>

          <p class="result-footnote" id="result-footnote">
            A PA possui uma diferença constante entre termos consecutivos.
          </p>
        </div>
      </div>

      <p class="error-message" id="error-message" role="alert" hidden></p>

      <div class="sequence-section">
        <div class="sequence-heading">
          <div>
            <span class="section-label">VISUALIZAÇÃO</span>
            <h3>Sequência numérica</h3>
          </div>
          <span class="sequence-count" id="sequence-count">10 termos</span>
        </div>

        <div class="sequence-list" id="sequence-list" aria-live="polite">
          <span class="sequence-term">3</span>
          <span class="sequence-term">5</span>
          <span class="sequence-term">7</span>
          <span class="sequence-term">9</span>
          <span class="sequence-term">11</span>
          <span class="sequence-term">13</span>
          <span class="sequence-term">15</span>
          <span class="sequence-term">17</span>
          <span class="sequence-term">19</span>
          <span class="sequence-term">21</span>
        </div>

        <p class="sequence-note" id="sequence-note">
          Exibindo os primeiros termos da progressão.
        </p>
      </div>
    </section>

    <section class="info-section">
      <div class="section-heading">
        <span class="section-label">ENTENDA AS PROGRESSÕES</span>
        <h2>O que são PA e PG?</h2>
        <p>
          Progressões são sequências numéricas que seguem uma regra de formação.
          As duas mais estudadas na matemática são a Progressão Aritmética e
          a Progressão Geométrica.
        </p>
      </div>

      <div class="concept-grid">
        <article class="concept-card">
          <div class="concept-icon">PA</div>
          <h3>Progressão Aritmética</h3>
          <p>
            É uma sequência em que a diferença entre dois termos consecutivos
            permanece constante. Essa diferença é chamada de razão (r).
          </p>

          <div class="sequence-example">
            <span>Exemplo de PA:</span>
            <strong>2, 5, 8, 11, 14, 17...</strong>
            <small>Razão: r = 3</small>
          </div>

          <div class="concept-formula">
            <span>Termo geral</span>
            <strong>aₙ = a₁ + (n − 1) × r</strong>
          </div>

          <div class="concept-formula">
            <span>Soma dos n primeiros termos</span>
            <strong>Sₙ = n × (a₁ + aₙ) ÷ 2</strong>
          </div>
        </article>

        <article class="concept-card">
          <div class="concept-icon pg-icon">PG</div>
          <h3>Progressão Geométrica</h3>
          <p>
            É uma sequência em que cada termo é obtido multiplicando o termo
            anterior por uma constante chamada razão (q).
          </p>

          <div class="sequence-example">
            <span>Exemplo de PG:</span>
            <strong>2, 6, 18, 54, 162...</strong>
            <small>Razão: q = 3</small>
          </div>

          <div class="concept-formula">
            <span>Termo geral</span>
            <strong>aₙ = a₁ × q⁽ⁿ⁻¹⁾</strong>
          </div>

          <div class="concept-formula">
            <span>Soma dos n primeiros termos (q ≠ 1)</span>
            <strong>Sₙ = a₁ × (qⁿ − 1) ÷ (q − 1)</strong>
          </div>
        </article>
      </div>
    </section>

    <section class="info-section">
      <div class="section-heading">
        <span class="section-label">CLASSIFICAÇÃO</span>
        <h2>Tipos de progressões</h2>
        <p>
          Dependendo do valor da razão, uma progressão pode apresentar
          comportamentos diferentes.
        </p>
      </div>

      <div class="classification-grid">
        <article class="classification-card">
          <span class="classification-dot increasing" aria-hidden="true"></span>
          <h3>Progressão crescente</h3>
          <p>Os termos aumentam conforme a sequência avança.</p>
          <strong>PA: razão positiva (r &gt; 0)</strong>
          <strong>PG: depende do primeiro termo e da razão.</strong>
        </article>

        <article class="classification-card">
          <span class="classification-dot decreasing" aria-hidden="true"></span>
          <h3>Progressão decrescente</h3>
          <p>Os termos diminuem conforme a sequência avança.</p>
          <strong>PA: razão negativa (r &lt; 0)</strong>
          <strong>PG: depende do primeiro termo e da razão.</strong>
        </article>

        <article class="classification-card">
          <span class="classification-dot constant" aria-hidden="true"></span>
          <h3>Progressão constante</h3>
          <p>Todos os termos apresentam o mesmo valor.</p>
          <strong>PA: razão igual a zero.</strong>
          <strong>PG: razão igual a 1, quando a₁ é constante.</strong>
        </article>
      </div>

      <div class="notice-card">
        <strong>Importante sobre a PG:</strong>
        <p>
          Quando a razão é negativa, os sinais dos termos podem alternar.
          Quando a razão está entre -1 e 1, os valores absolutos dos termos
          tendem a diminuir, desde que a sequência não seja nula.
        </p>
      </div>
    </section>

    <section class="info-section">
      <div class="section-heading">
        <span class="section-label">APLICAÇÕES PRÁTICAS</span>
        <h2>Onde as progressões são utilizadas?</h2>
      </div>

      <div class="uses-grid">
        <article class="use-card">
          <div class="use-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
          <div>
            <h3>Estudos e concursos</h3>
            <p>Resolução de exercícios de matemática, vestibulares e provas.</p>
          </div>
        </article>

        <article class="use-card">
          <div class="use-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div>
            <h3>Finanças</h3>
            <p>Modelagem de crescimento, juros compostos e sequências de valores.</p>
          </div>
        </article>

        <article class="use-card">
          <div class="use-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <div>
            <h3>Estatística e análise</h3>
            <p>Identificação de padrões e comportamentos em sequências numéricas.</p>
          </div>
        </article>

        <article class="use-card">
          <div class="use-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </div>
          <div>
            <h3>Ciência e tecnologia</h3>
            <p>Representação matemática de padrões e fenômenos de crescimento.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="faq-section">
      <span class="section-label">DÚVIDAS FREQUENTES</span>
      <h2>Perguntas sobre PA e PG</h2>

      <details>
        <summary>Qual é a diferença entre PA e PG?</summary>
        <p>
          Na PA, a diferença entre termos consecutivos é constante.
          Na PG, cada termo é obtido multiplicando o anterior por uma
          razão constante.
        </p>
      </details>

      <details>
        <summary>Como descobrir a razão de uma PA?</summary>
        <p>
          Subtraia um termo pelo seu antecessor. Por exemplo, na sequência
          3, 7, 11, 15, a razão é 4, pois 7 − 3 = 4.
        </p>
      </details>

      <details>
        <summary>Como descobrir a razão de uma PG?</summary>
        <p>
          Divida um termo pelo seu antecessor, desde que o antecessor
          seja diferente de zero. Na sequência 2, 6, 18, 54, a razão
          é 3, pois 6 ÷ 2 = 3.
        </p>
      </details>

      <details>
        <summary>O que significa o primeiro termo (a₁)?</summary>
        <p>
          É o valor que inicia a progressão. Todos os outros termos são
          calculados a partir dele e da razão da sequência.
        </p>
      </details>

      <details>
        <summary>O que significa a posição n?</summary>
        <p>
          É a posição do termo que você deseja encontrar. Por exemplo,
          n = 10 significa que você deseja calcular o décimo termo da
          progressão e a soma dos dez primeiros termos.
        </p>
      </details>

      <details>
        <summary>Uma progressão pode ter razão negativa ou decimal?</summary>
        <p>
          Sim. Tanto a PA quanto a PG podem utilizar razões negativas,
          positivas, inteiras, decimais ou fracionárias.
        </p>
      </details>

      <details>
        <summary>Qual é a soma dos termos de uma PG quando a razão é 1?</summary>
        <p>
          Quando q = 1, todos os termos são iguais ao primeiro termo.
          Portanto, a soma dos n primeiros termos é Sₙ = n × a₁.
        </p>
      </details>
    </section>

    <section class="bottom-cta">
      <h2>Continue explorando ferramentas matemáticas</h2>
      <p>
        Encontre outras calculadoras gratuitas para facilitar seus estudos
        e resolver problemas do cotidiano.
      </p>
      <a href="/matematica/" class="back-link">
        <span>Ver todas as ferramentas matemáticas</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </section>
  </main>

  <script>
    import { calcularPA, calcularPG } from '../../engines/math/advanced-math-engine';

    type ProgressionType = 'pa' | 'pg';

    const typeButtons = document.querySelectorAll<HTMLButtonElement>('[data-type]');
    const exampleButtons = document.querySelectorAll<HTMLButtonElement>('[data-example]');

    const typeLabel = document.getElementById('result-type')!;
    const description = document.getElementById('mode-description')!;
    const ratioLabel = document.getElementById('ratio-label')!;
    const ratioDescription = document.getElementById('ratio-description')!;

    const a1Input = document.getElementById('val-a1') as HTMLInputElement;
    const ratioInput = document.getElementById('val-razao') as HTMLInputElement;
    const nInput = document.getElementById('val-n') as HTMLInputElement;

    const termOutput = document.getElementById('res-termo')!;
    const sumOutput = document.getElementById('res-soma')!;
    const termLabel = document.getElementById('label-termo')!;

    const termFormula = document.getElementById('formula-termo')!;
    const sumFormula = document.getElementById('formula-soma')!;
    const footnote = document.getElementById('result-footnote')!;

    const sequenceList = document.getElementById('sequence-list')!;
    const sequenceCount = document.getElementById('sequence-count')!;
    const sequenceNote = document.getElementById('sequence-note')!;

    const errorMessage = document.getElementById('error-message')!;

    let currentType: ProgressionType = 'pa';

    const formatNumber = (value: number): string => {
      return value.toLocaleString('pt-BR', {
        maximumFractionDigits: 8
      });
    };

    function showError(message: string) {
      errorMessage.textContent = message;
      errorMessage.hidden = false;
    }

    function clearError() {
      errorMessage.textContent = '';
      errorMessage.hidden = true;
    }

    function setType(type: ProgressionType) {
      currentType = type;
      clearError();

      typeButtons.forEach((button) => {
        const active = button.dataset.type === type;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      typeLabel.textContent = type.toUpperCase();

      if (type === 'pa') {
        description.textContent =
          'Na PA, cada termo é obtido adicionando a mesma razão ao termo anterior.';

        ratioLabel.textContent = 'Razão (r)';
        ratioDescription.textContent =
          'Valor somado ou subtraído a cada termo.';

        termFormula.textContent = 'aₙ = a₁ + (n − 1) × r';
        sumFormula.textContent = 'Sₙ = n × (a₁ + aₙ) ÷ 2';

        footnote.textContent =
          'A PA possui uma diferença constante entre termos consecutivos.';
      } else {
        description.textContent =
          'Na PG, cada termo é obtido multiplicando o anterior por uma razão constante.';

        ratioLabel.textContent = 'Razão (q)';
        ratioDescription.textContent =
          'Fator pelo qual cada termo é multiplicado.';

        termFormula.textContent = 'aₙ = a₁ × q⁽ⁿ⁻¹⁾';
        sumFormula.textContent = 'Sₙ = a₁ × (qⁿ − 1) ÷ (q − 1), q ≠ 1';

        footnote.textContent =
          'Quando q = 1, a soma é calculada por Sₙ = n × a₁.';
      }

      runCalc();
    }

    function updateSequence(a1: number, ratio: number, n: number) {
      const visibleTerms = Math.min(n, 30);
      const fragment = document.createDocumentFragment();

      let current = a1;
      let rendered = 0;

      for (let i = 0; i < visibleTerms; i++) {
        if (!Number.isFinite(current)) {
          break;
        }

        const item = document.createElement('span');
        item.className = 'sequence-term';
        item.textContent = formatNumber(current);

        if (i === visibleTerms - 1 && n <= 30) {
          item.classList.add('last-term');
        }

        fragment.appendChild(item);
        rendered++;

        current = currentType === 'pa'
          ? current + ratio
          : current * ratio;
      }

      sequenceList.replaceChildren(fragment);

      if (n > 30) {
        const more = document.createElement('span');
        more.className = 'sequence-more';
        more.textContent = `+ ${n - 30} termos`;
        sequenceList.appendChild(more);
      }

      sequenceCount.textContent = `${n.toLocaleString('pt-BR')} ${n === 1 ? 'termo' : 'termos'}`;

      if (rendered < visibleTerms) {
        sequenceNote.textContent =
          'A visualização foi interrompida porque os valores ultrapassaram o limite numérico.';
      } else if (n > 30) {
        sequenceNote.textContent =
          'Exibindo os primeiros 30 termos. O termo e a soma consideram a posição total informada.';
      } else {
        sequenceNote.textContent =
          'Exibindo todos os termos da progressão calculada.';
      }
    }

    function runCalc() {
      clearError();

      const a1Raw = a1Input.value.trim();
      const ratioRaw = ratioInput.value.trim();
      const nRaw = nInput.value.trim();

      if (!a1Raw || !ratioRaw || !nRaw) {
        showError('Preencha todos os campos para calcular a progressão.');
        return;
      }

      const a1 = Number(a1Raw);
      const razao = Number(ratioRaw);
      const n = Number(nRaw);

      if (!Number.isFinite(a1) || !Number.isFinite(razao) || !Number.isFinite(n)) {
        showError('Informe somente valores numéricos válidos.');
        return;
      }

      if (!Number.isInteger(n) || n < 1 || n > 10000) {
        showError('A posição do termo deve ser um número inteiro entre 1 e 10.000.');
        return;
      }

      try {
        const resultado = currentType === 'pa'
          ? calcularPA({ a1, razao, n })
          : calcularPG({ a1, razao, n });

        const termo = resultado.termoN;
        const soma = resultado.somaN;

        if (!Number.isFinite(termo) || !Number.isFinite(soma)) {
          showError('O resultado ultrapassou o limite numérico permitido. Tente utilizar valores menores.');
          return;
        }

        termLabel.textContent = `Valor do termo (a${n})`;
        termOutput.textContent = formatNumber(termo);
        sumOutput.textContent = formatNumber(soma);

        if (currentType === 'pa') {
          termFormula.textContent =
            `a${n} = ${formatNumber(a1)} + (${n} − 1) × ${formatNumber(razao)} = ${formatNumber(termo)}`;

          sumFormula.textContent =
            `S${n} = ${n} × (${formatNumber(a1)} + ${formatNumber(termo)}) ÷ 2 = ${formatNumber(soma)}`;
        } else {
          termFormula.textContent =
            `a${n} = ${formatNumber(a1)} × ${formatNumber(razao)}⁽${n}⁻¹⁾ = ${formatNumber(termo)}`;

          if (razao === 1) {
            sumFormula.textContent =
              `S${n} = ${n} × ${formatNumber(a1)} = ${formatNumber(soma)}`;
          } else {
            sumFormula.textContent =
              `S${n} = ${formatNumber(a1)} × (${formatNumber(razao)}^${n} − 1) ÷ (${formatNumber(razao)} − 1) = ${formatNumber(soma)}`;
          }
        }

        updateSequence(a1, razao, n);
      } catch (error) {
        console.error('Erro ao calcular progressão:', error);
        showError('Não foi possível calcular a progressão. Verifique os valores e tente novamente.');
      }
    }

    const examples: Record<string, {
      type: ProgressionType;
      a1: number;
      razao: number;
      n: number;
    }> = {
      'pa-basic': { type: 'pa', a1: 2, razao: 3, n: 10 },
      'pa-negative': { type: 'pa', a1: 20, razao: -2, n: 10 },
      'pg-basic': { type: 'pg', a1: 2, razao: 3, n: 6 },
      'pg-fraction': { type: 'pg', a1: 80, razao: 0.5, n: 8 }
    };

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const type = button.dataset.type as ProgressionType;
        if (type === 'pa' || type === 'pg') {
          setType(type);
        }
      });
    });

    exampleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const example = examples[button.dataset.example || ''];

        if (!example) return;

        a1Input.value = String(example.a1);
        ratioInput.value = String(example.razao);
        nInput.value = String(example.n);

        setType(example.type);
      });
    });

    document.getElementById('calc-btn')?.addEventListener('click', runCalc);

    [a1Input, ratioInput, nInput].forEach((input) => {
      input.addEventListener('input', runCalc);
    });

    runCalc();
  </script>

