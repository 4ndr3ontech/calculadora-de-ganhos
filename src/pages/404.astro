---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página Não Encontrada — Calculadora de Ganhos" description="A página que você procurou não foi encontrada ou foi movida.">
  <div style="text-align: center; padding: 4rem 0;">
    <h1 style="font-size: 4rem; color: var(--color-primary); margin-bottom: 1rem;">404</h1>
    <h2 style="margin-bottom: 1rem;">Página não encontrada</h2>
    <p style="color: var(--text-secondary); margin-bottom: 2rem;">A página que você está procurando não existe ou foi alterada.</p>
    <a href="/" class="btn btn-primary">Voltar para o Início</a>
  </div>
</BaseLayout>