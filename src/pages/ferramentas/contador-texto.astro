
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contador de Palavras e Caracteres Online Grátis | Calculadora de Ganhos"
  description="Conte palavras, caracteres com e sem espaços, frases, linhas e parágrafos. Analise seu texto gratuitamente e estime o tempo de leitura em segundos."
>
  <div class="text-counter-page">
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/ferramentas/">Ferramentas</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Contador de Texto</span>
    </nav>

    <header class="hero">
      <span class="eyebrow">FERRAMENTA GRATUITA</span>
      <h1>Contador de Palavras e Caracteres</h1>

      <p>
        Analise seus textos em tempo real. Descubra a quantidade de palavras,
        caracteres, frases, parágrafos e o tempo estimado de leitura,
        sem precisar instalar programas.
      </p>
    </header>

    <section class="counter-section" aria-label="Analisador de texto">
      <div class="editor-header">
        <div>
          <h2>Seu texto</h2>
          <p>Digite ou cole o conteúdo no campo abaixo.</p>
        </div>

        <div class="editor-actions">
          <button type="button" id="copy-btn" class="secondary-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <span>Copiar texto</span>
          </button>

          <button type="button" id="clear-btn" class="clear-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 6h18"/>
              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
            </svg>
            <span>Limpar</span>
          </button>
        </div>
      </div>

      <label for="text-input" class="sr-only">
        Digite ou cole seu texto
      </label>

      <textarea
        id="text-input"
        placeholder="Comece a digitar ou cole seu texto aqui..."
        spellcheck="true"
        autocomplete="off"
        aria-describedby="editor-status"
      ></textarea>

      <div class="editor-footer">
        <span id="editor-status" role="status" aria-live="polite">
          Aguardando texto...
        </span>

        <span>As estatísticas são atualizadas automaticamente.</span>
      </div>
    </section>

    <section class="statistics-section" aria-labelledby="statistics-title">
      <div class="section-heading">
        <div>
          <span class="section-label">ANÁLISE DO CONTEÚDO</span>
          <h2 id="statistics-title">Estatísticas do texto</h2>
          <p>Confira os principais indicadores do conteúdo informado.</p>
        </div>

        <span class="live-indicator">
          <span aria-hidden="true"></span>
          Em tempo real
        </span>
      </div>

      <div class="stats-grid" aria-live="polite" aria-atomic="false">
        <article class="stat-card stat-highlight">
          <span class="stat-icon" aria-hidden="true">W</span>
          <span class="stat-label">Palavras</span>
          <strong id="stat-words">0</strong>
          <small>Quantidade de palavras</small>
        </article>

        <article class="stat-card">
          <span class="stat-icon" aria-hidden="true">Aa</span>
          <span class="stat-label">Caracteres</span>
          <strong id="stat-chars">0</strong>
          <small>Incluindo espaços</small>
        </article>

        <article class="stat-card">
          <span class="stat-icon" aria-hidden="true">A</span>
          <span class="stat-label">Sem espaços</span>
          <strong id="stat-no-spaces">0</strong>
          <small>Caracteres sem espaços em branco</small>
        </article>

        <article class="stat-card">
          <span class="stat-icon" aria-hidden="true">¶</span>
          <span class="stat-label">Parágrafos</span>
          <strong id="stat-paragraphs">0</strong>
          <small>Blocos de texto separados</small>
        </article>

        <article class="stat-card">
          <span class="stat-icon" aria-hidden="true">.</span>
          <span class="stat-label">Frases</span>
          <strong id="stat-sentences">0</strong>
          <small>Estimativa de frases identificadas</small>
        </article>

        <article class="stat-card">
          <span class="stat-icon" aria-hidden="true">↵</span>
          <span class="stat-label">Linhas</span>
          <strong id="stat-lines">0</strong>
          <small>Linhas do texto</small>
        </article>
      </div>
    </section>

    <section class="reading-card" aria-labelledby="reading-title">
      <div class="reading-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>

      <div>
        <span class="section-label">ESTIMATIVA DE LEITURA</span>
        <h2 id="stat-reading">0 min</h2>
        <p>
          Tempo aproximado considerando uma velocidade média de
          200 palavras por minuto.
        </p>
      </div>
    </section>

    <section class="content-section">
      <span class="section-label">SOBRE A FERRAMENTA</span>
      <h2>O que é um contador de palavras e caracteres?</h2>

      <p>
        Um contador de palavras e caracteres é uma ferramenta utilizada
        para analisar a estrutura e o tamanho de um texto. Ele permite
        identificar quantas palavras e caracteres foram utilizados,
        além de apresentar informações complementares, como parágrafos,
        frases e tempo estimado de leitura.
      </p>

      <p>
        Esse tipo de análise é especialmente útil para estudantes,
        profissionais de comunicação, redatores, produtores de conteúdo,
        pesquisadores e pessoas que precisam respeitar limites de
        tamanho em documentos ou publicações.
      </p>

      <p>
        Com o contador da Calculadora de Ganhos, basta inserir o conteúdo
        no campo de texto. Os indicadores são atualizados automaticamente,
        sem a necessidade de enviar formulários ou atualizar a página.
      </p>
    </section>

    <section class="content-section">
      <span class="section-label">ENTENDA OS INDICADORES</span>
      <h2>O que cada estatística significa?</h2>

      <div class="explanation-list">
        <article>
          <h3>Palavras</h3>
          <p>
            Representa a quantidade de termos identificados no texto,
            separados por espaços em branco. Sequências de espaços
            consecutivos não geram palavras adicionais.
          </p>
        </article>

        <article>
          <h3>Caracteres com espaços</h3>
          <p>
            Conta os caracteres digitados, incluindo letras,
            números, pontuação, espaços e quebras de linha.
          </p>
        </article>

        <article>
          <h3>Caracteres sem espaços</h3>
          <p>
            Apresenta a quantidade de caracteres após remover espaços
            em branco, incluindo tabulações e quebras de linha.
          </p>
        </article>

        <article>
          <h3>Parágrafos</h3>
          <p>
            Identifica blocos de conteúdo separados por uma ou mais
            linhas em branco, desconsiderando blocos vazios.
          </p>
        </article>

        <article>
          <h3>Frases</h3>
          <p>
            Apresenta uma estimativa de frases com base nos sinais
            de pontuação final, como ponto, interrogação e exclamação.
            Abreviações podem influenciar o resultado.
          </p>
        </article>

        <article>
          <h3>Linhas</h3>
          <p>
            Conta as linhas existentes no conteúdo, considerando as
            quebras de linha inseridas pelo usuário. Um texto vazio
            apresenta zero linhas.
          </p>
        </article>

        <article>
          <h3>Tempo de leitura</h3>
          <p>
            Estima quanto tempo uma pessoa levaria para ler o conteúdo,
            considerando uma velocidade média de 200 palavras por minuto.
          </p>
        </article>
      </div>
    </section>

    <section class="content-section">
      <span class="section-label">APLICAÇÕES PRÁTICAS</span>
      <h2>Para que utilizar um contador de texto?</h2>

      <div class="applications-grid">
        <article class="application-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <h3>Trabalhos acadêmicos</h3>
          <p>
            Verifique o tamanho de resumos, introduções, redações
            e outros conteúdos acadêmicos.
          </p>
        </article>

        <article class="application-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/>
              <path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>
            </svg>
          </div>
          <h3>Produção de conteúdo</h3>
          <p>
            Analise artigos, textos para blogs, descrições e materiais
            de comunicação.
          </p>
        </article>

        <article class="application-card">
          <div class="icon-badge icon-badge-amber" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
              <path d="M12 18h.01"/>
            </svg>
          </div>
          <h3>Redes sociais</h3>
          <p>
            Acompanhe o tamanho de legendas, publicações e mensagens
            antes de compartilhar.
          </p>
        </article>

        <article class="application-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
          </div>
          <h3>Documentos profissionais</h3>
          <p>
            Confira a extensão de relatórios, propostas, apresentações
            e textos corporativos.
          </p>
        </article>
      </div>
    </section>

    <section class="content-section">
      <span class="section-label">COMO UTILIZAR</span>
      <h2>Como contar palavras e caracteres?</h2>

      <ol class="steps-list">
        <li>
          <span class="step-number">01</span>
          <div>
            <h3>Insira seu texto</h3>
            <p>
              Digite ou cole o conteúdo que deseja analisar na área
              de edição.
            </p>
          </div>
        </li>

        <li>
          <span class="step-number">02</span>
          <div>
            <h3>Acompanhe as estatísticas</h3>
            <p>
              Os indicadores são calculados automaticamente enquanto
              você escreve ou modifica o conteúdo.
            </p>
          </div>
        </li>

        <li>
          <span class="step-number">03</span>
          <div>
            <h3>Confira o tempo de leitura</h3>
            <p>
              Consulte a estimativa de leitura com base na quantidade
              de palavras identificadas.
            </p>
          </div>
        </li>

        <li>
          <span class="step-number">04</span>
          <div>
            <h3>Copie ou limpe o conteúdo</h3>
            <p>
              Utilize os botões disponíveis para copiar o texto
              ou começar uma nova análise.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section class="faq-section">
      <span class="section-label">DÚVIDAS FREQUENTES</span>
      <h2>Perguntas frequentes sobre contagem de palavras</h2>

      <details class="faq-item">
        <summary>O contador de palavras é gratuito?</summary>
        <p>
          Sim. A ferramenta pode ser utilizada gratuitamente,
          diretamente pelo navegador.
        </p>
      </details>

      <details class="faq-item">
        <summary>O contador atualiza os resultados automaticamente?</summary>
        <p>
          Sim. As estatísticas são recalculadas sempre que você digita,
          remove ou modifica o conteúdo do campo de texto.
        </p>
      </details>

      <details class="faq-item">
        <summary>Qual é a diferença entre caracteres com e sem espaços?</summary>
        <p>
          A contagem com espaços considera todos os caracteres do texto.
          A contagem sem espaços desconsidera espaços em branco,
          tabulações e quebras de linha.
        </p>
      </details>

      <details class="faq-item">
        <summary>Como o tempo de leitura é calculado?</summary>
        <p>
          A ferramenta divide a quantidade de palavras por uma velocidade
          de referência de 200 palavras por minuto e arredonda o resultado
          para cima, em minutos inteiros.
        </p>
      </details>

      <details class="faq-item">
        <summary>O contador identifica frases automaticamente?</summary>
        <p>
          Sim. A ferramenta utiliza sinais de pontuação final, como ponto,
          interrogação e exclamação, para estimar a quantidade de frases.
          Abreviações, reticências e casos especiais podem influenciar
          essa contagem.
        </p>
      </details>

      <details class="faq-item">
        <summary>Meu texto é enviado para algum servidor?</summary>
        <p>
          A análise desta ferramenta é realizada diretamente no navegador.
          O código da calculadora não envia o conteúdo digitado para um
          servidor. Entretanto, outros recursos do site, como serviços
          de hospedagem e métricas de acesso, podem operar separadamente,
          conforme as políticas de privacidade aplicáveis.
        </p>
      </details>

      <details class="faq-item">
        <summary>Posso utilizar a ferramenta pelo celular?</summary>
        <p>
          Sim. A interface é adaptável para smartphones, tablets
          e computadores.
        </p>
      </details>
    </section>

    <aside class="notice">
      <div class="notice-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 16v-4"/>
          <path d="M12 8h.01"/>
        </svg>
        <strong>Importante:</strong>
      </div>
      <p>
        A contagem de palavras é realizada com base na separação por
        espaços em branco. Dependendo das regras de uma instituição,
        plataforma ou editora, a metodologia de contagem pode ser diferente.
        O tempo de leitura é apenas uma estimativa e varia conforme
        a velocidade de cada pessoa.
      </p>
    </aside>
  </div>

  <script>
    let pageController: AbortController | null = null;

    function initPage() {
      // Remove eventos anteriores para evitar duplicidade.
      pageController?.abort();
      pageController = new AbortController();

      const { signal } = pageController;

      const textarea = document.getElementById('text-input') as HTMLTextAreaElement | null;
      const statWords = document.getElementById('stat-words');
      const statChars = document.getElementById('stat-chars');
      const statNoSpaces = document.getElementById('stat-no-spaces');
      const statParagraphs = document.getElementById('stat-paragraphs');
      const statSentences = document.getElementById('stat-sentences');
      const statLines = document.getElementById('stat-lines');
      const statReading = document.getElementById('stat-reading');
      const editorStatus = document.getElementById('editor-status');

      const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement | null;
      const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement | null;

      if (!textarea) return;

      const formatNumber = (value: number) =>
        value.toLocaleString('pt-BR');

      /**
       * Conta caracteres Unicode considerando grafemas.
       *
       * Um grafema representa um caractere percebido visualmente
       * pelo usuário, mesmo quando é formado por vários pontos
       * de código Unicode, como emojis compostos e letras acentuadas.
       */
      function countCharacters(value: string): number {
        if (typeof Intl.Segmenter !== 'undefined') {
          const segmenter = new Intl.Segmenter('pt-BR', {
            granularity: 'grapheme'
          });

          return Array.from(segmenter.segment(value)).length;
        }

        // Compatibilidade com navegadores sem Intl.Segmenter.
        return Array.from(value).length;
      }

      /**
       * Estima a quantidade de frases com base na pontuação final.
       * Abreviações e construções especiais podem afetar o resultado.
       */
      function countSentences(value: string): number {
        const normalized = value.trim();

        if (!normalized) return 0;

        const matches = normalized.match(
          /[^.!?。！？]+(?:[.!?。！？]+["'”’»)\]]*)?|[.!?。！？]+["'”’»)\]]*/gu
        );

        return (matches || [])
          .filter(sentence => /[\p{L}\p{N}]/u.test(sentence))
          .length;
      }

      /**
       * Conta parágrafos separados por uma ou mais linhas em branco.
       */
      function countParagraphs(value: string): number {
        const normalized = value.trim();

        if (!normalized) return 0;

        return normalized
          .split(/\r?\n(?:[ \t]*\r?\n)+/u)
          .filter(paragraph => paragraph.trim().length > 0)
          .length;
      }

      function analyzeText() {
        const text = textarea.value;
        const trimmedText = text.trim();

        const words = trimmedText
          ? trimmedText.split(/\s+/u).length
          : 0;

        const chars = countCharacters(text);

        const charsNoSpaces = countCharacters(
          text.replace(/\s/gu, '')
        );

        const paragraphs = countParagraphs(text);

        const sentences = countSentences(text);

        const lines = text.length === 0
          ? 0
          : text.split(/\r\n|\r|\n/u).length;

        const readingMinutes = Math.ceil(words / 200);

        if (statWords) {
          statWords.textContent = formatNumber(words);
        }

        if (statChars) {
          statChars.textContent = formatNumber(chars);
        }

        if (statNoSpaces) {
          statNoSpaces.textContent = formatNumber(charsNoSpaces);
        }

        if (statParagraphs) {
          statParagraphs.textContent = formatNumber(paragraphs);
        }

        if (statSentences) {
          statSentences.textContent = formatNumber(sentences);
        }

        if (statLines) {
          statLines.textContent = formatNumber(lines);
        }

        if (statReading) {
          if (words === 0) {
            statReading.textContent = '0 min';
          } else if (readingMinutes === 1) {
            statReading.textContent = '1 min';
          } else {
            statReading.textContent =
              `${formatNumber(readingMinutes)} min`;
          }
        }

        if (editorStatus) {
          editorStatus.textContent = words === 0
            ? 'Aguardando texto...'
            : `${formatNumber(words)} ${words === 1 ? 'palavra analisada' : 'palavras analisadas'}`;
        }
      }

      async function copyText() {
        const text = textarea.value;

        if (!text) {
          if (editorStatus) {
            editorStatus.textContent = 'Não há texto para copiar.';
          }
          return;
        }

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            // Alternativa para navegadores sem Clipboard API.
            textarea.focus();
            textarea.select();

            const copied = document.execCommand('copy');

            if (!copied) {
              throw new Error('Falha ao copiar texto.');
            }

            textarea.setSelectionRange(textarea.value.length, textarea.value.length);
          }

          if (editorStatus) {
            editorStatus.textContent = 'Texto copiado com sucesso!';
          }
        } catch {
          if (editorStatus) {
            editorStatus.textContent =
              'Não foi possível copiar. Verifique as permissões do navegador.';
          }
        }
      }

      textarea.addEventListener('input', analyzeText, { signal });

      clearBtn?.addEventListener('click', () => {
        textarea.value = '';
        analyzeText();
        textarea.focus();

        if (editorStatus) {
          editorStatus.textContent = 'Texto removido.';
        }
      }, { signal });

      copyBtn?.addEventListener('click', copyText, { signal });

      analyzeText();
    }

    // Inicialização normal e suporte a navegação com Astro View Transitions.
    initPage();
    document.addEventListener('astro:page-load', initPage);
  </script>

  <style>
    .text-counter-page {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0.5rem 0 4rem;
      color: var(--text-primary);
    }

    .breadcrumb {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 1.75rem;
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .breadcrumb a {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--color-primary);
    }

    .hero {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .eyebrow,
    .section-label {
      display: inline-block;
      margin-bottom: 0.75rem;
      color: var(--color-primary);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.1em;
    }

    .hero h1 {
      margin: 0 0 0.9rem;
      color: var(--text-primary);
      font-size: clamp(2rem, 5vw, 2.7rem);
      line-height: 1.2;
    }

    .hero p {
      max-width: 760px;
      margin: 0 auto;
      color: var(--text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    /* ÍCONES SVG PADRONIZADOS */

    .icon-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(6, 95, 70, 0.1);
      color: var(--color-primary);
      flex-shrink: 0;
    }

    .icon-badge-amber {
      background: rgba(217, 119, 6, 0.12);
      color: #d97706;
    }

