    .privacy-section {
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.65rem;
      margin-bottom: 3.5rem;
      border: 1px solid var(--border-color);
      border-radius: 14px;
      background: var(--bg-secondary);
