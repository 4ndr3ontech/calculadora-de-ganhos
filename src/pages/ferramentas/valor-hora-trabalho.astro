  <script>
    import { calculateFreelanceRate } from '../../engines/business/freelance-rate-engine';
    import { formatBRL } from '../../engines/common/currency';

    let pageController: AbortController | null = null;

    function initPage() {
      // Remove os eventos da inicialização anterior.
      pageController?.abort();

      pageController = new AbortController();
      const { signal } = pageController;

      const desiredIncomeInput = document.getElementById('desired-income') as HTMLInputElement | null;
      const personalExpInput = document.getElementById('personal-exp') as HTMLInputElement | null;
      const businessExpInput = document.getElementById('business-exp') as HTMLInputElement | null;
      const taxesInput = document.getElementById('taxes') as HTMLInputElement | null;
      const hoursDayInput = document.getElementById('hours-day') as HTMLInputElement | null;
      const daysWeekInput = document.getElementById('days-week') as HTMLInputElement | null;
      const calcBtn = document.getElementById('calc-btn');

      const hourlyOutput = document.getElementById('res-hourly');
      const dailyOutput = document.getElementById('res-daily');
      const monthlyOutput = document.getElementById('res-monthly-gross');
      const errorOutput = document.getElementById('calc-error');

      if (
        !desiredIncomeInput ||
        !personalExpInput ||
        !businessExpInput ||
        !taxesInput ||
        !hoursDayInput ||
        !daysWeekInput ||
        !calcBtn ||
        !hourlyOutput ||
        !dailyOutput ||
        !monthlyOutput ||
        !errorOutput
      ) {
        return;
      }

      function showError(message: string) {
        errorOutput.textContent = message;
        errorOutput.hidden = false;

        hourlyOutput.textContent = '—';
        dailyOutput.textContent = '—';
        monthlyOutput.textContent = '—';
      }

      function runCalc() {
        const rawValues = [
          desiredIncomeInput.value,
          personalExpInput.value,
          businessExpInput.value,
          taxesInput.value,
          hoursDayInput.value,
          daysWeekInput.value,
        ];

        if (rawValues.some(value => value.trim() === '')) {
          showError('Preencha todos os campos antes de calcular.');
          return;
        }

        const desiredIncome = Number(desiredIncomeInput.value);
        const personalExp = Number(personalExpInput.value);
        const businessExp = Number(businessExpInput.value);
        const taxes = Number(taxesInput.value);
        const hoursDay = Number(hoursDayInput.value);
        const daysWeek = Number(daysWeekInput.value);

        const values = [
          desiredIncome,
          personalExp,
          businessExp,
          taxes,
          hoursDay,
          daysWeek,
        ];

        if (values.some(value => !Number.isFinite(value))) {
          showError('Preencha todos os campos com valores numéricos válidos.');
          return;
        }

        if (
          desiredIncome < 0 ||
          personalExp < 0 ||
          businessExp < 0
        ) {
          showError('Os valores financeiros não podem ser negativos.');
          return;
        }

        if (taxes < 0 || taxes >= 100) {
          showError('O percentual de impostos deve estar entre 0% e 99,99%.');
          return;
        }

        if (hoursDay < 1 || hoursDay > 12) {
          showError('Informe uma jornada diária entre 1 e 12 horas.');
          return;
        }

        if (!Number.isInteger(daysWeek) || daysWeek < 1 || daysWeek > 7) {
          showError('Informe uma quantidade de 1 a 7 dias por semana.');
          return;
        }

        if (desiredIncome + personalExp + businessExp <= 0) {
          showError('Informe uma meta de renda ou algum custo mensal.');
          return;
        }

        // Limpa o erro antes de executar uma nova simulação.
        errorOutput.textContent = '';
        errorOutput.hidden = true;

        try {
          const result = calculateFreelanceRate({
            desiredNetIncome: desiredIncome,
            personalExpenses: personalExp,
            businessExpenses: businessExp,
            estimatedTaxesPercentage: taxes,
            hoursPerDay: hoursDay,
            daysPerWeek: daysWeek,
            vacationWeeksPerYear: 4,
          });

          if (
            !Number.isFinite(result.hourlyRate) ||
            !Number.isFinite(result.dailyRate) ||
            !Number.isFinite(result.totalMonthlyNeeds) ||
            result.hourlyRate <= 0 ||
            result.dailyRate <= 0 ||
            result.totalMonthlyNeeds <= 0
          ) {
            showError('Não foi possível calcular os valores informados. Confira os dados e tente novamente.');
            return;
          }

          hourlyOutput.textContent = formatBRL(result.hourlyRate);
          dailyOutput.textContent = formatBRL(result.dailyRate);
          monthlyOutput.textContent = formatBRL(result.totalMonthlyNeeds);
        } catch (error) {
          console.error('Erro ao calcular valor da hora:', error);
          showError('Ocorreu um erro durante o cálculo. Confira os dados informados.');
        }
      }

      calcBtn.addEventListener('click', runCalc, { signal });

      [
        desiredIncomeInput,
        personalExpInput,
        businessExpInput,
        taxesInput,
        hoursDayInput,
        daysWeekInput,
      ].forEach(input => {
        input.addEventListener('input', runCalc, { signal });
        input.addEventListener('change', runCalc, { signal });
      });

      runCalc();
    }

    // Inicialização inicial e compatibilidade com navegação do Astro.
    initPage();
    document.addEventListener('astro:page-load', initPage);
  </script>

