    }

    .comparison-card p {
      margin: 0;
      color: var(--text-secondary);
      line-height: 1.75;
    }

    .faq-section {
      margin-bottom: 3.5rem;
    }

    .faq-item {
      border-bottom: 1px solid var(--border-color);
    }

    .faq-item summary {
      padding: 1.2rem 2rem 1.2rem 0;
      position: relative;
      cursor: pointer;
      color: var(--text-primary);
      font-weight: 650;
      line-height: 1.5;
      list-style: none;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item summary::after {
      content: '+';
      position: absolute;
      right: 0.3rem;
      color: var(--color-primary);
      font-size: 1.35rem;
    }

    .faq-item[open] summary::after {
      content: '−';
    }

    .faq-item p {
      margin: 0;
      padding: 0 1rem 1.2rem 0;
      color: var(--text-secondary);
      font-size: 0.94rem;
      line-height: 1.75;
    }

    .final-notice {
      padding: 1.4rem 1.5rem;
      margin-bottom: 2.5rem;
      border: 1px solid var(--border-color);
      border-left: 4px solid var(--color-primary);
      border-radius: 10px;
      background: var(--bg-secondary);
    }

    .notice-title {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      margin-bottom: 0.5rem;
      color: var(--color-primary);
    }

    .notice-title strong {
      color: var(--text-primary);
    }

    .final-notice p {
      margin: 0;
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.75;
    }

    .final-cta {
      padding: 2.25rem 1.75rem;
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: var(--bg-secondary);
      text-align: center;
    }

    .final-cta h2 {
      margin: 0 0 0.75rem;
      font-size: clamp(1.45rem, 3vw, 1.85rem);
    }

    .final-cta p {
      max-width: 650px;
      margin: 0 auto 1.5rem;
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.75;
    }

    .cta-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      padding: 0.8rem 1.4rem;
      border-radius: 9px;
      background: var(--color-primary);
      color: #ffffff;
      font-size: 0.92rem;
      font-weight: 700;
      text-decoration: none;
      transition: opacity 0.2s ease;
    }

    .cta-link:hover {
      opacity: 0.88;
    }

    .cta-link:focus-visible,
    .btn:focus-visible,
    .breadcrumb a:focus-visible {
      outline: 3px solid var(--color-primary);
      outline-offset: 3px;
    }

    @media (max-width: 768px) {
      .calc-grid,
      .explanation-grid,
      .comparison-card {
        grid-template-columns: 1fr;
      }

      .attention-section,
      .privacy-section {
        flex-direction: column;
      }
    }

    @media (max-width: 480px) {
      .hours-grid,
      .example-data {
        grid-template-columns: 1fr;
      }

      .card {
        padding: 1.25rem;
      }

      .hero-highlights {
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</BaseLayout>