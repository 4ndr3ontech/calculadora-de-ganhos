---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Gerador de Senhas Seguras Online Grátis | Calculadora de Ganhos"
  description="Gere senhas fortes e aleatórias gratuitamente. Personalize o tamanho, escolha letras, números e símbolos. Geração realizada diretamente no seu navegador."
>
  <div class="password-page">

    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/ferramentas/">Ferramentas</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Gerador de Senhas</span>
    </nav>

    <header class="hero">
      <span class="eyebrow">SEGURANÇA DIGITAL</span>

      <h1>Gerador de Senhas Seguras</h1>

      <p>
        Crie senhas aleatórias e personalizadas para proteger suas contas
        e serviços online. Escolha o tamanho e os tipos de caracteres
        desejados. A geração acontece diretamente no seu navegador.
      </p>
    </header>

    <section class="generator-section" aria-labelledby="generator-title">

      <div class="generator-header">
        <div>
          <span class="section-label">SUA NOVA SENHA</span>
          <h2 id="generator-title">Gerador de senhas</h2>
        </div>

        <span class="privacy-badge">
          <span aria-hidden="true"></span>
          Processamento local
        </span>
      </div>

      <div class="password-output-wrapper">
        <label for="password-output" class="sr-only">
          Senha gerada
        </label>

        <input
          type="password"
          id="password-output"
          readonly
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="Sua senha aparecerá aqui"
        />

        <button
          type="button"
          id="toggle-password"
          class="icon-btn"
          aria-label="Mostrar senha"
          aria-pressed="false"
          title="Mostrar ou ocultar senha"
        >
          <span id="toggle-icon-show" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </span>

          <span id="toggle-icon-hide" aria-hidden="true" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/>
            </svg>
          </span>
        </button>

        <button
          type="button"
          id="copy-btn"
          class="copy-btn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span id="copy-btn-text">Copiar</span>
        </button>
      </div>

      <div class="strength-container">
        <div class="strength-heading">
          <span>Força estimada</span>
          <strong id="strength-label">Aguardando senha</strong>
        </div>

        <div
          class="strength-bar"
          role="progressbar"
          aria-label="Estimativa de força da senha"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-valuetext="Aguardando senha"
          id="strength-progress"
        >
          <span id="strength-fill"></span>
        </div>

        <p id="strength-description" aria-live="polite">
          Gere uma senha para visualizar a estimativa.
        </p>
      </div>

      <div class="divider"></div>

      <div class="length-section">
        <div class="option-heading">
          <label for="pass-length">Tamanho da senha</label>
          <strong><span id="length-val">20</span> caracteres</strong>
        </div>

        <input
          type="range"
          id="pass-length"
          min="8"
          max="64"
          step="1"
          value="20"
        />

        <div class="range-labels">
          <span>8 caracteres</span>
          <span>64 caracteres</span>
        </div>
      </div>

      <div class="divider"></div>

      <div class="character-section">
        <h3>Tipos de caracteres</h3>

        <p>
          Selecione os grupos que deseja utilizar na composição da senha.
        </p>

        <div class="character-options">

          <label class="character-option">
            <input type="checkbox" id="inc-upper" checked />
            <span class="custom-check"></span>

            <span class="option-content">
              <strong>Letras maiúsculas</strong>
              <small>ABCDEFGHIJKLMNOPQRSTUVWXYZ</small>
            </span>
          </label>

          <label class="character-option">
            <input type="checkbox" id="inc-lower" checked />
            <span class="custom-check"></span>

            <span class="option-content">
              <strong>Letras minúsculas</strong>
              <small>abcdefghijklmnopqrstuvwxyz</small>
            </span>
          </label>

          <label class="character-option">
            <input type="checkbox" id="inc-numbers" checked />
            <span class="custom-check"></span>

            <span class="option-content">
              <strong>Números</strong>
              <small>0123456789</small>
            </span>
          </label>

          <label class="character-option">
            <input type="checkbox" id="inc-symbols" checked />
            <span class="custom-check"></span>

            <span class="option-content">
              <strong>Símbolos especiais</strong>
              <small>!@#$%^&amp;*()_+-=[]</small>
            </span>
          </label>

        </div>
      </div>

      <div id="generator-error" class="generator-error" role="alert" hidden>
        Selecione pelo menos um tipo de caractere.
      </div>

      <button
        type="button"
        id="generate-btn"
        class="generate-btn"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/>
        </svg>
        <span>Gerar nova senha</span>
      </button>

      <p class="generator-status" id="generator-status" role="status" aria-live="polite">
        Sua senha será gerada automaticamente.
      </p>

    </section>

    <section class="security-notice">
      <div class="icon-badge" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>

      <div>
        <strong>Privacidade e segurança</strong>
        <p>
          A senha é gerada diretamente no seu navegador utilizando
          recursos criptográficos do próprio dispositivo. Esta ferramenta
          não envia a senha gerada para servidores.
        </p>
      </div>
    </section>

    <section class="content-section">
      <span class="section-label">ENTENDA A FERRAMENTA</span>
      <h2>Por que utilizar um gerador de senhas seguras?</h2>

      <p>
        Senhas são uma das principais formas de proteção de contas digitais.
        Elas ajudam a controlar o acesso a e-mails, redes sociais, serviços
        bancários, plataformas de trabalho e diversos outros sistemas.
      </p>

      <p>
        O problema é que muitas pessoas utilizam combinações previsíveis,
        como datas de nascimento, nomes, sequências numéricas ou a mesma
        senha em diferentes serviços. Essas práticas podem facilitar
        tentativas de acesso não autorizado.
      </p>

      <p>
        Um gerador de senhas permite criar combinações aleatórias com
        diferentes tipos de caracteres, reduzindo a dependência de padrões
        fáceis de adivinhar.
      </p>

      <p>
        Com esta ferramenta, você pode definir o comprimento da senha e
        escolher entre letras maiúsculas, letras minúsculas, números
        e símbolos especiais.
      </p>
    </section>

    <section class="content-section">
      <span class="section-label">BOAS PRÁTICAS</span>
      <h2>O que caracteriza uma senha forte?</h2>

      <div class="security-grid">

        <article class="security-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/>
            </svg>
          </div>
          <h3>Comprimento adequado</h3>
          <p>
            Senhas mais longas geralmente oferecem maior quantidade
            de combinações possíveis e dificultam ataques de tentativa
            e erro.
          </p>
        </article>

        <article class="security-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"/><path d="m18 14 4 4-4 4"/>
            </svg>
          </div>
          <h3>Combinações variadas</h3>
          <p>
            A utilização de diferentes grupos de caracteres amplia
            o conjunto de possibilidades para a formação da senha.
          </p>
        </article>

        <article class="security-card">
          <div class="icon-badge icon-badge-amber" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/>
            </svg>
          </div>
          <h3>Sem padrões previsíveis</h3>
          <p>
            Evite nomes, datas, sequências simples, palavras comuns
            e informações pessoais facilmente descobertas.
          </p>
        </article>

        <article class="security-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <h3>Senhas exclusivas</h3>
          <p>
            Utilize uma senha diferente para cada serviço, evitando
            que o comprometimento de uma conta afete outras.
          </p>
        </article>

      </div>
    </section>

    <section class="content-section">
      <span class="section-label">COMO FUNCIONA</span>
      <h2>Como gerar uma senha segura?</h2>

      <ol class="steps-list">
        <li>
          <span class="step-number">01</span>
          <div>
            <h3>Escolha o comprimento</h3>
            <p>
              Ajuste o controle deslizante para definir a quantidade
              de caracteres desejada.
            </p>
          </div>
        </li>

        <li>
          <span class="step-number">02</span>
          <div>
            <h3>Selecione os caracteres</h3>
            <p>
              Escolha se deseja incluir letras maiúsculas, minúsculas,
              números e símbolos especiais.
            </p>
          </div>
        </li>

        <li>
          <span class="step-number">03</span>
          <div>
            <h3>Gere sua senha</h3>
            <p>
              Clique no botão para criar uma nova combinação aleatória.
            </p>
          </div>
        </li>

        <li>
          <span class="step-number">04</span>
          <div>
            <h3>Copie e armazene com segurança</h3>
            <p>
              Copie a senha e guarde-a em um gerenciador de senhas
              confiável.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section class="content-section">
      <span class="section-label">SEGURANÇA DIGITAL</span>
      <h2>Como proteger suas contas além de uma senha forte?</h2>

      <p>
        Uma senha complexa é importante, mas não representa a única
        medida necessária para proteger uma conta. A segurança digital
        depende também de hábitos adequados e recursos adicionais.
      </p>

      <div class="recommendations">
        <div>
          <strong>Utilize autenticação multifator</strong>
          <p>
            Sempre que disponível, ative uma segunda etapa de verificação
            para dificultar acessos indevidos.
          </p>
        </div>

        <div>
          <strong>Utilize um gerenciador de senhas</strong>
          <p>
            Um gerenciador confiável ajuda a armazenar e organizar
            senhas exclusivas sem precisar memorizar todas elas.
          </p>
        </div>

        <div>
          <strong>Desconfie de mensagens suspeitas</strong>
          <p>
            Não informe suas credenciais em links recebidos por mensagens
            ou páginas cuja autenticidade não tenha sido verificada.
          </p>
        </div>

        <div>
          <strong>Não compartilhe suas senhas</strong>
          <p>
            Mantenha suas credenciais privadas e evite armazená-las
            em documentos desprotegidos.
          </p>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <span class="section-label">DÚVIDAS FREQUENTES</span>
      <h2>Perguntas frequentes sobre senhas seguras</h2>

      <details class="faq-item">
        <summary>O gerador de senhas é gratuito?</summary>
        <p>
          Sim. A ferramenta pode ser utilizada gratuitamente,
          diretamente pelo navegador, sem necessidade de cadastro.
        </p>
      </details>

      <details class="faq-item">
        <summary>As senhas geradas são enviadas para algum servidor?</summary>
        <p>
          Não. A geração acontece localmente no navegador por meio
          da API criptográfica Web Crypto. O código desta ferramenta
          não transmite a senha gerada para um servidor.
        </p>
      </details>

      <details class="faq-item">
        <summary>Qual é o tamanho recomendado para uma senha?</summary>
        <p>
          Senhas longas e exclusivas são geralmente mais resistentes
          a tentativas de adivinhação. Sempre considere também os
          requisitos do serviço em que a senha será utilizada.
        </p>
      </details>

      <details class="faq-item">
        <summary>É melhor utilizar letras, números e símbolos?</summary>
        <p>
          A combinação de diferentes grupos de caracteres aumenta
          o conjunto de possibilidades. Entretanto, o comprimento
          e a aleatoriedade também são fatores fundamentais.
        </p>
      </details>

      <details class="faq-item">
        <summary>Posso utilizar a mesma senha em vários sites?</summary>
        <p>
          Não é recomendado. Se um serviço sofrer uma exposição
          de credenciais, a reutilização pode colocar outras contas
          em risco.
        </p>
      </details>

      <details class="faq-item">
        <summary>O indicador de força garante que minha senha é segura?</summary>
        <p>
          Não. O indicador apresenta uma estimativa matemática baseada
          no tamanho da senha e na quantidade de caracteres disponíveis.
          Ele não avalia vazamentos, políticas do serviço, armazenamento
          ou todos os possíveis riscos de segurança.
        </p>
      </details>

      <details class="faq-item">
        <summary>Por que alguns sites não aceitam determinados símbolos?</summary>
        <p>
          Cada serviço pode estabelecer regras próprias para criação
          de senhas. Se uma plataforma rejeitar algum caractere,
          ajuste as opções do gerador para atender aos requisitos dela.
        </p>
      </details>

      <details class="faq-item">
        <summary>Como devo armazenar minha senha?</summary>
        <p>
          Prefira um gerenciador de senhas confiável, protegido por
          autenticação forte. Evite deixar credenciais em arquivos
          de texto sem proteção ou compartilhá-las com outras pessoas.
        </p>
      </details>
    </section>

    <aside class="final-notice">
      <div class="notice-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        </svg>
        <strong>Importante sobre segurança:</strong>
      </div>
      <p>
        Esta ferramenta auxilia na criação de senhas aleatórias, mas
        não garante a segurança de uma conta ou dispositivo. A proteção
        também depende do serviço utilizado, do armazenamento das
        credenciais, da autenticação adicional e dos hábitos do usuário.
        Sempre verifique os requisitos da plataforma em que pretende
        utilizar a senha.
      </p>
    </aside>

  </div>

  <script>
    let pageController: AbortController | null = null;
    let copyTimeout: ReturnType<typeof setTimeout> | undefined;

    function initPage() {
      pageController?.abort();

      if (copyTimeout) {
        clearTimeout(copyTimeout);
        copyTimeout = undefined;
      }

      pageController = new AbortController();

      const { signal } = pageController;

      const output = document.getElementById('password-output') as HTMLInputElement | null;
      const lengthInput = document.getElementById('pass-length') as HTMLInputElement | null;
      const lengthVal = document.getElementById('length-val');

      const upperCheck = document.getElementById('inc-upper') as HTMLInputElement | null;
      const lowerCheck = document.getElementById('inc-lower') as HTMLInputElement | null;
      const numbersCheck = document.getElementById('inc-numbers') as HTMLInputElement | null;
      const symbolsCheck = document.getElementById('inc-symbols') as HTMLInputElement | null;

      const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement | null;
      const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement | null;
      const copyBtnText = document.getElementById('copy-btn-text');

      const toggleBtn = document.getElementById('toggle-password') as HTMLButtonElement | null;
      const toggleIconShow = document.getElementById('toggle-icon-show');
      const toggleIconHide = document.getElementById('toggle-icon-hide');

      const strengthLabel = document.getElementById('strength-label');
      const strengthFill = document.getElementById('strength-fill') as HTMLElement | null;
      const strengthProgress = document.getElementById('strength-progress');
      const strengthDescription = document.getElementById('strength-description');

      const generatorError = document.getElementById('generator-error') as HTMLElement | null;
      const generatorStatus = document.getElementById('generator-status');

      if (
        !output ||
        !lengthInput ||
        !upperCheck ||
        !lowerCheck ||
        !numbersCheck ||
        !symbolsCheck
      ) {
        return;
      }

      const charsUpper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const charsLower = 'abcdefghijklmnopqrstuvwxyz';
      const charsNumbers = '0123456789';
      const charsSymbols = '!@#$%^&*()_+-=[]{}|;:,.<>?';

      let currentPassword = '';

      /**
       * Retorna um inteiro aleatório uniforme no intervalo [0, max).
       * O rejection sampling evita o viés de módulo.
       */
      function secureRandomInt(max: number): number {
        if (
          !Number.isSafeInteger(max) ||
          max < 1 ||
          max > 0x100000000
        ) {
          throw new Error('Intervalo aleatório inválido.');
        }

        const range = 0x100000000;
        const limit = Math.floor(range / max) * max;
        const randomArray = new Uint32Array(1);

        let value: number;

        do {
          window.crypto.getRandomValues(randomArray);
          value = randomArray[0];
        } while (value >= limit);

        return value % max;
      }

      function getSelectedGroups(): string[] {
        const groups: string[] = [];

        if (upperCheck.checked) groups.push(charsUpper);
        if (lowerCheck.checked) groups.push(charsLower);
        if (numbersCheck.checked) groups.push(charsNumbers);
        if (symbolsCheck.checked) groups.push(charsSymbols);

        return groups;
      }

      /**
       * Calcula exatamente o número de senhas possíveis que:
       * - possuem o comprimento informado;
       * - utilizam os grupos selecionados;
       * - contêm pelo menos um caractere de cada grupo.
       *
       * Os grupos são disjuntos. A inclusão-exclusão calcula
       * o espaço de combinações sem enumerar todas as senhas.
       */
      function calculateValidPasswordSpace(
        length: number,
        groups: string[]
      ): bigint {
        const poolSize = groups.reduce(
          (total, group) => total + group.length,
          0
        );

        let total = 0n;
        const combinations = 1 << groups.length;

        for (let mask = 0; mask < combinations; mask++) {
          let excludedCharacters = 0;
          let selectedCount = 0;

          for (let index = 0; index < groups.length; index++) {
            if ((mask & (1 << index)) !== 0) {
              excludedCharacters += groups[index].length;
              selectedCount++;
            }
          }

          const remainingCharacters = poolSize - excludedCharacters;

          const combinationsForSubset =
            BigInt(remainingCharacters) ** BigInt(length);

          if (selectedCount % 2 === 0) {
            total += combinationsForSubset;
          } else {
            total -= combinationsForSubset;
          }
        }

        return total;
      }

      /**
       * Calcula log2 de um BigInt evitando converter o número
       * inteiro diretamente para Number.
       */
      function log2BigInt(value: bigint): number {
        if (value <= 0n) {
          throw new Error('Espaço de combinações inválido.');
        }

        const binaryLength = value.toString(2).length;
        const shift = Math.max(0, binaryLength - 53);
        const leadingBits = Number(value >> BigInt(shift));

        return Math.log2(leadingBits) + shift;
      }

      /**
       * Gera uma senha uniforme entre todas as combinações válidas.
       *
       * Sorteia todos os caracteres independentemente e rejeita
       * a sequência inteira quando algum grupo obrigatório estiver
       * ausente. Assim, todas as senhas válidas têm a mesma
       * probabilidade de serem produzidas.
       */
      function generateUniformPassword(
        length: number,
        groups: string[]
      ): string {
        const allChars = groups.join('');

        while (true) {
          const passwordChars: string[] = [];

          for (let index = 0; index < length; index++) {
            passwordChars.push(
              allChars[secureRandomInt(allChars.length)]
            );
          }

          const containsAllGroups = groups.every((group) =>
            passwordChars.some((character) => group.includes(character))
          );

          if (containsAllGroups) {
            return passwordChars.join('');
          }
        }
      }

      function updateStrength(length: number, groups: string[]) {
        if (
          !strengthLabel ||
          !strengthFill ||
          !strengthDescription ||
          !strengthProgress
        ) {
          return;
        }

        if (!length || !groups.length) {
          strengthLabel.textContent = 'Indisponível';
          strengthFill.style.width = '0%';
          strengthFill.dataset.level = 'weak';

          strengthProgress.setAttribute('aria-valuenow', '0');
          strengthProgress.setAttribute('aria-valuetext', 'Indisponível');

          strengthDescription.textContent =
            'Selecione pelo menos um tipo de caractere.';

          return;
        }

        const validPasswordSpace = calculateValidPasswordSpace(
          length,
          groups
        );

        const estimatedEntropy = log2BigInt(validPasswordSpace);

        let label = '';
        let description = '';
        let percentage = 0;
        let level = 'weak';

        if (estimatedEntropy < 40) {
          label = 'Baixa';
          description =
            'O espaço de combinações é reduzido. Considere aumentar o comprimento da senha.';
          percentage = 25;
          level = 'weak';
        } else if (estimatedEntropy < 60) {
          label = 'Moderada';
          description =
            'Uma senha mais longa pode aumentar a resistência a tentativas de adivinhação.';
          percentage = 50;
          level = 'medium';
        } else if (estimatedEntropy < 80) {
          label = 'Forte';
          description =
            'A senha possui um espaço elevado de combinações teóricas.';
          percentage = 75;
          level = 'strong';
        } else {
          label = 'Muito forte';
          description =
            'O espaço matemático de combinações é amplo.';
          percentage = 100;
          level = 'very-strong';
        }

        strengthLabel.textContent = label;
        strengthDescription.textContent = description;

        strengthFill.style.width = `${percentage}%`;
        strengthFill.dataset.level = level;

        strengthProgress.setAttribute(
          'aria-valuenow',
          percentage.toString()
        );

        strengthProgress.setAttribute(
          'aria-valuetext',
          `${label}. Espaço de combinações equivalente a aproximadamente ${Math.floor(estimatedEntropy)} bits.`
        );
      }

      function setToggleState(visible: boolean) {
        if (!output || !toggleBtn) return;

        output.type = visible ? 'text' : 'password';

        toggleBtn.setAttribute(
          'aria-pressed',
          visible.toString()
        );

        toggleBtn.setAttribute(
          'aria-label',
          visible ? 'Ocultar senha' : 'Mostrar senha'
        );

        if (toggleIconShow) {
          toggleIconShow.hidden = visible;
        }

        if (toggleIconHide) {
          toggleIconHide.hidden = !visible;
        }
      }

      function showError(message: string) {
        currentPassword = '';
        output.value = '';

        setToggleState(false);

        if (generatorError) {
          generatorError.hidden = false;
          generatorError.textContent = message;
        }

        if (generatorStatus) {
          generatorStatus.textContent = message;
        }

        if (copyBtnText) {
          copyBtnText.textContent = 'Copiar';
        }

        updateStrength(0, []);
      }

      function generatePassword() {
        const groups = getSelectedGroups();

        const minLength = Number.parseInt(lengthInput.min, 10) || 8;
        const maxLength = Number.parseInt(lengthInput.max, 10) || 64;

        let length = Number.parseInt(lengthInput.value, 10);

        if (!Number.isFinite(length)) {
          length = 20;
        }

        length = Math.min(
          maxLength,
          Math.max(minLength, length)
        );

        lengthInput.value = length.toString();

        if (lengthVal) {
          lengthVal.textContent = length.toString();
        }

        if (groups.length === 0) {
          showError('Selecione pelo menos um tipo de caractere.');
          return;
        }

        if (length < groups.length) {
          showError(
            'Aumente o tamanho da senha para incluir todos os grupos selecionados.'
          );
          return;
        }

        if (generatorError) {
          generatorError.hidden = true;
        }

        try {
          if (
            !window.crypto ||
            typeof window.crypto.getRandomValues !== 'function'
          ) {
            throw new Error(
              'Seu navegador não oferece suporte à geração criptográfica segura.'
            );
          }

          currentPassword = generateUniformPassword(length, groups);
          output.value = currentPassword;

          setToggleState(false);

          if (copyTimeout) {
            clearTimeout(copyTimeout);
            copyTimeout = undefined;
          }

          if (copyBtnText) {
            copyBtnText.textContent = 'Copiar';
          }

          updateStrength(length, groups);

          if (generatorStatus) {
            generatorStatus.textContent =
              'Nova senha gerada com sucesso.';
          }

        } catch (error) {
          currentPassword = '';
          output.value = '';

          setToggleState(false);

          if (generatorError) {
            generatorError.hidden = false;
            generatorError.textContent =
              error instanceof Error
                ? error.message
                : 'Não foi possível gerar a senha.';
          }

          if (generatorStatus) {
            generatorStatus.textContent =
              error instanceof Error
                ? error.message
                : 'Não foi possível gerar a senha.';
          }

          updateStrength(0, []);
        }
      }

      function togglePasswordVisibility() {
        if (!currentPassword || !output) return;

        const isVisible = output.type === 'text';

        setToggleState(!isVisible);
      }

      async function copyPassword() {
        if (!currentPassword) {
          if (generatorStatus) {
            generatorStatus.textContent =
              'Gere uma senha antes de copiar.';
          }

          return;
        }

        try {
          if (
            navigator.clipboard &&
            typeof navigator.clipboard.writeText === 'function'
          ) {
            await navigator.clipboard.writeText(currentPassword);
          } else {
            const temporaryInput = document.createElement('textarea');

            temporaryInput.value = currentPassword;
            temporaryInput.setAttribute('readonly', '');
            temporaryInput.setAttribute('aria-hidden', 'true');

            temporaryInput.style.position = 'fixed';
            temporaryInput.style.opacity = '0';
            temporaryInput.style.pointerEvents = 'none';
            temporaryInput.style.left = '-9999px';

            document.body.appendChild(temporaryInput);

            temporaryInput.select();
            temporaryInput.setSelectionRange(
              0,
              temporaryInput.value.length
            );

            const copied = document.execCommand('copy');

            temporaryInput.remove();

            if (!copied) {
              throw new Error('A cópia não foi autorizada pelo navegador.');
            }
          }

          if (copyBtnText) {
            copyBtnText.textContent = 'Copiada!';
          }

          if (generatorStatus) {
            generatorStatus.textContent =
              'Senha copiada para a área de transferência.';
          }

          if (copyTimeout) {
            clearTimeout(copyTimeout);
          }

          copyTimeout = setTimeout(() => {
            if (copyBtnText) {
              copyBtnText.textContent = 'Copiar';
            }

            copyTimeout = undefined;
          }, 2000);

        } catch {
          if (generatorStatus) {
            generatorStatus.textContent =
              'Não foi possível copiar. Verifique as permissões do navegador ou copie a senha manualmente.';
          }

          if (copyBtnText) {
            copyBtnText.textContent = 'Tentar novamente';
          }
        }
      }

      lengthInput.addEventListener('input', generatePassword, { signal });

      upperCheck.addEventListener('change', generatePassword, { signal });
      lowerCheck.addEventListener('change', generatePassword, { signal });
      numbersCheck.addEventListener('change', generatePassword, { signal });
      symbolsCheck.addEventListener('change', generatePassword, { signal });

      generateBtn?.addEventListener('click', generatePassword, { signal });
      copyBtn?.addEventListener('click', copyPassword, { signal });
      toggleBtn?.addEventListener('click', togglePasswordVisibility, { signal });

      generatePassword();
    }

    initPage();

    document.addEventListener('astro:page-load', initPage);
  </script>

