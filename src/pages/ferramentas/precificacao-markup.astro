  <script>
    import { calculateMarkupPricing } from '../../engines/business/pricing-engine';
    import { formatBRL } from '../../engines/common/currency';

    let pageController: AbortController | null = null;

    function roundToCents(value: number): number {
      return Math.round((value + Number.EPSILON) * 100) / 100;
    }

    function initPage() {
      // Evita listeners duplicados em navegações do Astro.
      pageController?.abort();
      pageController = new AbortController();

      const { signal } = pageController;

      const unitCostInput = document.getElementById('unit-cost') as HTMLInputElement | null;
      const expensesInput = document.getElementById('op-expenses') as HTMLInputElement | null;
      const profitInput = document.getElementById('desired-profit') as HTMLInputElement | null;

      const calcBtn = document.getElementById('calc-btn') as HTMLButtonElement | null;

      const priceOutput = document.getElementById('res-price');
      const markupOutput = document.getElementById('res-markup');
      const profitOutput = document.getElementById('res-profit');
      const errorOutput = document.getElementById('calc-error');

      if (
        !unitCostInput ||
        !expensesInput ||
        !profitInput ||
        !calcBtn ||
        !priceOutput ||
        !markupOutput ||
        !profitOutput ||
        !errorOutput
      ) {
        return;
      }

      function resetResults() {
        priceOutput.textContent = '—';
        markupOutput.textContent = '—';
        profitOutput.textContent = '—';
      }

      function showError(message: string) {
        errorOutput.textContent = message;
        errorOutput.hidden = false;
        resetResults();
      }

      function clearError() {
        errorOutput.textContent = '';
        errorOutput.hidden = true;
      }

      function runCalc() {
        clearError();

        const rawValues = [
          unitCostInput.value.trim(),
          expensesInput.value.trim(),
          profitInput.value.trim(),
        ];

        if (rawValues.some(value => value === '')) {
          showError('Preencha todos os campos para realizar o cálculo.');
          return;
        }

        const unitCostValue = Number(unitCostInput.value);
        const opExpenses = Number(expensesInput.value);
        const desiredProfit = Number(profitInput.value);

        const inputs = [unitCostValue, opExpenses, desiredProfit];

        if (inputs.some(value => !Number.isFinite(value))) {
          showError('Informe valores numéricos válidos.');
          return;
        }

        if (unitCostValue <= 0) {
          showError('O custo unitário deve ser maior que zero.');
          return;
        }

        if (opExpenses < 0 || opExpenses > 99.99) {
          showError('As despesas e os impostos devem estar entre 0% e 99,99%.');
          return;
        }

        if (desiredProfit < 0 || desiredProfit > 99.99) {
          showError('A margem de lucro deve estar entre 0% e 99,99%.');
          return;
        }

        if (opExpenses + desiredProfit >= 100) {
          showError(
            'A soma das despesas e do lucro desejado precisa ser inferior a 100%.'
          );
          return;
        }

        // Valores monetários são tratados com precisão de centavos.
        const unitCost = roundToCents(unitCostValue);

        if (unitCost <= 0) {
          showError('O custo unitário precisa ser maior que zero.');
          return;
        }

        try {
          const result = calculateMarkupPricing({
            unitCost,
            operatingExpensesPercentage: opExpenses,
            desiredProfitPercentage: desiredProfit,
          });

          if (
            !result ||
            !Number.isFinite(result.suggestedSalePrice) ||
            !Number.isFinite(result.markupMultiplier)
          ) {
            showError('Não foi possível calcular os valores informados.');
            return;
          }

          // O preço apresentado ao usuário é arredondado para centavos.
          const salePrice = roundToCents(result.suggestedSalePrice);

          if (!Number.isFinite(salePrice) || salePrice <= 0) {
            showError('O preço calculado não é válido. Confira os valores informados.');
            return;
          }

          // Recalcula o lucro usando o mesmo preço que será exibido.
          // Isso evita diferenças entre o resultado visual e o valor monetário.
          const operatingExpensesValue = salePrice * (opExpenses / 100);

          const netProfit = roundToCents(
            salePrice - unitCost - operatingExpensesValue
          );

          const markupMultiplier = result.markupMultiplier;

          if (
            !Number.isFinite(netProfit) ||
            !Number.isFinite(markupMultiplier)
          ) {
            showError('Não foi possível calcular os valores informados.');
            return;
          }

          priceOutput.textContent = formatBRL(salePrice);
          markupOutput.textContent = `${markupMultiplier.toFixed(2).replace('.', ',')}x`;
          profitOutput.textContent = formatBRL(netProfit);

          // Diferencia visualmente um resultado positivo de um negativo.
          profitOutput.classList.toggle('negative-profit', netProfit < 0);
        } catch {
          showError('Ocorreu um erro ao realizar o cálculo. Confira os dados.');
        }
      }

      calcBtn.addEventListener('click', runCalc, { signal });

      [unitCostInput, expensesInput, profitInput].forEach(input => {
        input.addEventListener('input', runCalc, { signal });
      });

      runCalc();
    }

    // Inicialização normal e suporte a View Transitions do Astro.
    initPage();
    document.addEventListener('astro:page-load', initPage);
  </script>

