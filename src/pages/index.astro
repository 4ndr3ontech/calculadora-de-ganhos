---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchTools from '../components/SearchTools.astro';
---

<BaseLayout
  title="Calculadora de Ganhos | Calculadoras Financeiras, Trabalhistas e Matemáticas"
  description="Calculadoras gratuitas para simular salário líquido, rescisão CLT, férias, juros compostos, financiamentos, porcentagens e muito mais. Faça seus cálculos online."
>
  <div class="home">

    <!-- HERO COM MOCKUP FLUTUANTE -->
    <header class="hero">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-grid">
        <div class="hero-text">
          <span class="eyebrow">CALCULADORAS GRATUITAS PARA O SEU DIA A DIA</span>

          <h1>
            Seus números mais claros.
            <span>Decisões mais conscientes.</span>
          </h1>

          <p class="hero-description">
            Calcule, simule e compare diferentes cenários financeiros,
            trabalhistas e matemáticos. Ferramentas práticas para entender
            valores e planejar melhor, direto no navegador.
          </p>

          <div class="hero-search">
            <SearchTools />
          </div>

          <div class="quick-links">
            <span class="quick-links-label">Mais acessadas:</span>

            <div class="quick-chips">
              <a href="/trabalhista/calculadora-salario-liquido/">
                Salário líquido
              </a>
              <a href="/financas/juros-compostos/">
                Juros compostos
              </a>
              <a href="/trabalhista/rescisao/">
                Rescisão CLT
              </a>
              <a href="/trabalhista/ferias/">
                Férias
              </a>
              <a href="/financas/financiamento-imobiliario/">
                Financiamento
              </a>
            </div>
          </div>

          <div class="hero-benefits">
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Sem cadastro
            </span>
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Uso gratuito
            </span>
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Resultados explicados
            </span>
          </div>
        </div>

        <!-- CARTÃO VISUAL ILUSTRATIVO (MOCKUP DE SIMULAÇÃO DO PORTAL) -->
        <div class="hero-visual" aria-hidden="true">
          <span class="floating-symbol symbol-one">R$</span>
          <span class="floating-symbol symbol-two">%</span>
          <span class="floating-symbol symbol-three">∑</span>

          <div class="mockup-card home-mockup">
            <div class="mockup-top">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <span class="mockup-badge">Simulação rápida</span>
            </div>

            <!-- VISOR PRINCIPAL -->
            <div class="sim-screen">
              <div class="sim-screen-top">
                <span class="sim-label">Resultado estimado</span>
                <span class="sim-pill">+14,2% a.a.</span>
              </div>
              <div class="sim-value">R$ 18.450,00</div>
            </div>

            <!-- MINI BARRAS COMPARATIVAS -->
            <div class="sim-bars">
              <div class="sim-bar-row">
                <span>Valor aplicado</span>
                <strong>R$ 12.000,00</strong>
              </div>
              <div class="sim-track">
                <span class="sim-fill-base"></span>
              </div>

              <div class="sim-bar-row">
                <span>Rendimento acumulado</span>
                <strong class="is-accent">+ R$ 6.450,00</strong>
              </div>
              <div class="sim-track">
                <span class="sim-fill-accent"></span>
              </div>
            </div>

            <!-- ATALHOS DE ÁREA -->
            <div class="sim-tags">
              <span>Finanças</span>
              <span>CLT</span>
              <span>Matemática</span>
            </div>

            <div class="mockup-row-footer">
              <span>Calculadora de Ganhos</span>
              <span class="mockup-dot"></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- INDICADORES DO PORTAL -->
    <section class="highlights" aria-label="Características do portal">
      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
            <line x1="8" y1="6" x2="16" y2="6"></line>
            <line x1="16" y1="14" x2="16" y2="18"></line>
            <path d="M16 10h.01"></path>
            <path d="M12 10h.01"></path>
            <path d="M8 10h.01"></path>
            <path d="M12 14h.01"></path>
            <path d="M8 14h.01"></path>
            <path d="M12 18h.01"></path>
            <path d="M8 18h.01"></path>
          </svg>
        </div>
        <div>
          <strong>Diversas ferramentas</strong>
          <small>Para diferentes necessidades</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
        </div>
        <div>
          <strong>Simulações práticas</strong>
          <small>Compare diferentes cenários</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <polyline points="6.5 2 20 2 20 22 6.5 22"></polyline>
            <line x1="10" y1="6" x2="16" y2="6"></line>
            <line x1="10" y1="10" x2="16" y2="10"></line>
          </svg>
        </div>
        <div>
          <strong>Conteúdo explicativo</strong>
          <small>Entenda como os cálculos funcionam</small>
        </div>
      </div>
    </section>

    <!-- CATEGORIAS -->
    <section class="categories-section" id="categorias">
      <div class="section-heading">
        <div>
          <span class="eyebrow">EXPLORE POR CATEGORIA</span>
          <h2>O que você precisa calcular hoje?</h2>
          <p>
            Encontre a ferramenta adequada para sua necessidade.
            Nossas calculadoras estão organizadas por assunto para facilitar
            sua navegação.
          </p>
        </div>
      </div>

      <div class="categories-grid">

        <a href="/financas/" class="category-card category-finance">
          <div class="category-top">
            <div class="category-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <span class="category-arrow" aria-hidden="true">↗</span>
          </div>

          <span class="category-kicker">DINHEIRO E PLANEJAMENTO</span>
          <h3>Finanças e Investimentos</h3>
          <p>
            Simule juros compostos, investimentos, empréstimos e
            financiamentos. Entenda custos, parcelas e possibilidades
            para organizar melhor seu dinheiro.
          </p>

          <span class="category-link">Explorar ferramentas <span aria-hidden="true">→</span></span>
        </a>

        <a href="/trabalhista/" class="category-card category-work">
          <div class="category-top">
            <div class="category-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <span class="category-arrow" aria-hidden="true">↗</span>
          </div>

          <span class="category-kicker">TRABALHO E REMUNERAÇÃO</span>
          <h3>Calculadoras Trabalhistas</h3>
          <p>
            Estime salário líquido, férias, décimo terceiro, rescisão,
            FGTS, horas extras e outros valores relacionados ao trabalho.
          </p>

          <span class="category-link">Explorar ferramentas <span aria-hidden="true">→</span></span>
        </a>

        <a href="/matematica/" class="category-card category-math">
          <div class="category-top">
            <div class="category-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="9" x2="20" y2="9"></line>
                <line x1="4" y1="15" x2="20" y2="15"></line>
                <line x1="10" y1="3" x2="8" y2="21"></line>
                <line x1="16" y1="3" x2="14" y2="21"></line>
              </svg>
            </div>
            <span class="category-arrow" aria-hidden="true">↗</span>
          </div>

          <span class="category-kicker">OPERAÇÕES E FÓRMULAS</span>
          <h3>Matemática e Cálculos</h3>
          <p>
            Resolva porcentagens, regra de três, médias, descontos,
            MDC, MMC, progressões e outras operações matemáticas.
          </p>

          <span class="category-link">Explorar ferramentas <span aria-hidden="true">→</span></span>
        </a>

        <a href="/conversores/" class="category-card category-tools">
          <div class="category-top">
            <div class="category-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="17 1 21 5 17 9"></polyline>
                <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                <polyline points="7 23 3 19 7 15"></polyline>
                <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
              </svg>
            </div>
            <span class="category-arrow" aria-hidden="true">↗</span>
          </div>

          <span class="category-kicker">FACILIDADE E PRODUTIVIDADE</span>
          <h3>Conversores e Utilitários</h3>
          <p>
            Resolva tarefas cotidianas com conversores, cálculo de dias
            úteis e ferramentas digitais úteis para diferentes situações.
          </p>

          <span class="category-link">Explorar ferramentas <span aria-hidden="true">→</span></span>
        </a>

      </div>
    </section>

    <!-- FERRAMENTAS POPULARES -->
    <section class="popular-section">
      <div class="section-heading popular-heading">
        <div>
          <span class="eyebrow">COMECE POR AQUI</span>
          <h2>Ferramentas para situações do dia a dia</h2>
          <p>
            Alguns dos cálculos mais procurados para ajudar você a encontrar
            rapidamente o que precisa.
          </p>
        </div>

        <a href="/trabalhista/" class="text-link">
          Ver ferramentas <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="popular-grid">
        <a href="/trabalhista/calculadora-salario-liquido/" class="popular-card">
          <div class="popular-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div class="popular-card-body">
            <strong>Salário líquido</strong>
            <small>Estime o valor após os descontos.</small>
          </div>
          <span class="popular-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/financas/juros-compostos/" class="popular-card">
          <div class="popular-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
          </div>
          <div class="popular-card-body">
            <strong>Juros compostos</strong>
            <small>Simule a evolução do seu dinheiro.</small>
          </div>
          <span class="popular-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/trabalhista/rescisao/" class="popular-card">
          <div class="popular-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <div class="popular-card-body">
            <strong>Rescisão CLT</strong>
            <small>Estime valores do encerramento do contrato.</small>
          </div>
          <span class="popular-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/trabalhista/ferias/" class="popular-card">
          <div class="popular-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
              <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
            </svg>
          </div>
          <div class="popular-card-body">
            <strong>Férias</strong>
            <small>Simule o pagamento das suas férias.</small>
          </div>
          <span class="popular-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/financas/financiamento-imobiliario/" class="popular-card">
          <div class="popular-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          <div class="popular-card-body">
            <strong>Financiamento imobiliário</strong>
            <small>Compare parcelas e condições de financiamento.</small>
          </div>
          <span class="popular-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/matematica/" class="popular-card">
          <div class="popular-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="9" x2="20" y2="9"></line>
              <line x1="4" y1="15" x2="20" y2="15"></line>
              <line x1="10" y1="3" x2="8" y2="21"></line>
              <line x1="16" y1="3" x2="14" y2="21"></line>
            </svg>
          </div>
          <div class="popular-card-body">
            <strong>Calculadoras matemáticas</strong>
            <small>Resolva operações e problemas matemáticos.</small>
          </div>
          <span class="popular-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- COMO FUNCIONA -->
    <section class="how-section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">COMO FUNCIONA</span>
          <h2>Calcular ficou mais simples</h2>
          <p>
            Você informa os dados, acompanha o resultado e pode testar
            diferentes cenários sempre que precisar.
          </p>
        </div>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <span class="step-number">01</span>
          <div class="step-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3>Encontre a ferramenta</h3>
          <p>
            Pesquise pelo nome ou escolha uma das categorias disponíveis.
          </p>
        </article>

        <article class="step-card">
          <span class="step-number">02</span>
          <div class="step-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
              <path d="M6 8h.01"></path>
              <path d="M10 8h.01"></path>
              <path d="M14 8h.01"></path>
              <path d="M18 8h.01"></path>
              <path d="M6 12h.01"></path>
              <path d="M10 12h.01"></path>
              <path d="M14 12h.01"></path>
              <path d="M18 12h.01"></path>
              <path d="M6 16h6"></path>
              <path d="M16 16h2"></path>
            </svg>
          </div>
          <h3>Informe os dados</h3>
          <p>
            Preencha os campos com os valores, taxas e períodos solicitados.
          </p>
        </article>

        <article class="step-card">
          <span class="step-number">03</span>
          <div class="step-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <h3>Confira o resultado</h3>
          <p>
            Visualize a estimativa e consulte as explicações da calculadora.
          </p>
        </article>

        <article class="step-card">
          <span class="step-number">04</span>
          <div class="step-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 4 23 10 17 10"></polyline>
              <polyline points="1 20 1 14 7 14"></polyline>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
          </div>
          <h3>Compare possibilidades</h3>
          <p>
            Modifique os dados e analise outros cenários para sua decisão.
          </p>
        </article>
      </div>
    </section>

    <!-- DIFERENCIAIS -->
    <section class="trust-section">
      <div class="trust-content">
        <div class="trust-intro">
          <span class="eyebrow">NOSSO COMPROMISSO</span>
          <h2>Não basta apresentar um número. É importante entender de onde ele vem.</h2>
          <p>
            Acreditamos que uma boa ferramenta deve ser fácil de utilizar
            e também ajudar a compreender o resultado. Por isso, buscamos
            combinar cálculos objetivos com orientações claras.
          </p>
        </div>

        <div class="trust-list">
          <article class="trust-item">
            <span class="trust-check" aria-hidden="true">✓</span>
            <div>
              <h3>Clareza nas informações</h3>
              <p>Explicações em linguagem acessível e instruções objetivas.</p>
            </div>
          </article>

          <article class="trust-item">
            <span class="trust-check" aria-hidden="true">✓</span>
            <div>
              <h3>Transparência nos cálculos</h3>
              <p>Informações sobre variáveis e critérios utilizados nas simulações.</p>
            </div>
          </article>

          <article class="trust-item">
            <span class="trust-check" aria-hidden="true">✓</span>
            <div>
              <h3>Atenção às regras aplicáveis</h3>
              <p>Revisão dos parâmetros conforme as referências e regras pertinentes a cada ferramenta.</p>
            </div>
          </article>

          <article class="trust-item">
            <span class="trust-check" aria-hidden="true">✓</span>
            <div>
              <h3>Acesso simplificado</h3>
              <p>Ferramentas disponíveis diretamente pelo navegador, sem cadastro obrigatório.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- AVISO -->
    <section class="disclaimer-section">
      <div class="disclaimer-icon" aria-hidden="true">ⓘ</div>
      <div>
        <h2>Sobre os resultados das calculadoras</h2>
        <p>
          As ferramentas da Calculadora de Ganhos possuem finalidade
          informativa e educacional. Os resultados são estimativas baseadas
          nos dados inseridos e nas regras implementadas em cada calculadora.
        </p>
        <p>
          Situações específicas, legislação, contratos, convenções coletivas,
          tarifas e condições particulares podem modificar os valores finais.
          Quando necessário, consulte um profissional qualificado ou uma fonte
          oficial antes de tomar decisões financeiras ou trabalhistas.
