---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Simulador de Investimentos e Rentabilidade — Calculadora de Ganhos"
  description="Simule seus investimentos com juros compostos, aporte inicial e contribuições mensais. Descubra quanto poderá acumular e quanto seu dinheiro poderá render."
>
  <main class="page-container">
    <nav class="breadcrumb" aria-label="Navegação">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/financas/">Finanças</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Simulador de Investimentos</span>
    </nav>

    <header class="page-header">
      <span class="eyebrow">PLANEJAMENTO FINANCEIRO</span>
      <h1>Simulador de Investimentos</h1>
      <p>
        Descubra quanto seu patrimônio pode crescer com investimentos,
        aportes mensais e juros compostos. Projete diferentes cenários
        e entenda o impacto do tempo na construção do seu patrimônio.
      </p>
    </header>

    <section class="calculator-section" aria-label="Simulador de investimentos">
      <div class="calculator-grid">
        <!-- Parâmetros -->
        <div class="card input-card">
          <div class="card-heading">
            <div class="icon-badge" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>
              </svg>
            </div>
            <div>
              <h3>Parâmetros do investimento</h3>
              <p>Configure os valores da sua simulação.</p>
            </div>
          </div>

          <form id="investment-form">
            <div class="field-group">
              <label for="initial">Aporte inicial</label>
              <div class="input-wrapper">
                <span class="input-prefix">R$</span>
                <input
                  type="number"
                  id="initial"
                  value="5000"
                  min="0"
                  step="0.01"
                  required
                />
              </div>
              <small>
                Valor que você pretende investir inicialmente.
                Informe zero caso queira começar sem capital inicial.
              </small>
            </div>

            <div class="field-group">
              <label for="monthly">Aporte mensal</label>
              <div class="input-wrapper">
                <span class="input-prefix">R$</span>
                <input
                  type="number"
                  id="monthly"
                  value="1000"
                  min="0"
                  step="0.01"
                  required
                />
              </div>
              <small>
                Quantia que será adicionada ao investimento todos os meses.
              </small>
            </div>

            <div class="field-group">
              <label for="rate">Rentabilidade anual estimada</label>
              <div class="input-wrapper">
                <input
                  type="number"
                  id="rate"
                  value="12"
                  min="-99"
                  max="1000"
                  step="0.01"
                  required
                />
                <span class="input-suffix">% a.a.</span>
              </div>
              <small>
                Taxa anual utilizada para projetar o crescimento do patrimônio.
              </small>
            </div>

            <div class="field-group">
              <label for="years">Período do investimento</label>
              <div class="input-wrapper">
                <input
                  type="number"
                  id="years"
                  value="15"
                  min="0"
                  max="100"
                  step="1"
                  required
                />
                <span class="input-suffix">anos</span>
              </div>
              <small>
                Tempo durante o qual o dinheiro permanecerá investido.
              </small>
            </div>

            <div id="form-error" class="error-message" role="alert" hidden></div>

            <button type="submit" class="btn-calculate">
              <span>Simular investimento</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </button>

            <button type="button" id="reset-btn" class="btn-reset">
              Restaurar valores iniciais
            </button>
          </form>
        </div>

        <!-- Resultados -->
        <div class="card result-card" aria-live="polite">
          <div>
            <div class="card-heading">
              <div class="icon-badge result-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/>
                </svg>
              </div>
              <div>
                <h3>Projeção de patrimônio</h3>
                <p>Confira o resultado estimado ao final do período.</p>
              </div>
            </div>

            <div class="main-result total-panel">
              <span class="result-label">Patrimônio bruto acumulado</span>
              <strong id="res-final">R$ 0,00</strong>
              <span class="savings-caption">
                Valor projetado ao término do investimento.
              </span>
            </div>

            <div class="result-breakdown">
              <div class="result-row">
                <div>
                  <span class="result-dot invested-dot"></span>
                  <div>
                    <strong>Total investido</strong>
                    <span>Dinheiro aplicado do próprio bolso</span>
                  </div>
                </div>
                <strong id="res-invested">R$ 0,00</strong>
              </div>

              <div class="result-row">
                <div>
                  <span class="result-dot interest-dot"></span>
                  <div>
                    <strong>Rendimento bruto</strong>
                    <span>Ganho estimado com os juros</span>
                  </div>
                </div>
                <strong id="res-interest" class="interest-value">R$ 0,00</strong>
              </div>

              <div class="result-row">
                <div>
                  <span class="result-dot"></span>
                  <div>
                    <strong>Aporte inicial</strong>
                    <span>Capital investido no início</span>
                  </div>
                </div>
                <strong id="res-initial">R$ 0,00</strong>
              </div>

              <div class="result-row">
                <div>
                  <span class="result-dot"></span>
                  <div>
                    <strong>Período</strong>
                    <span>Duração da aplicação</span>
                  </div>
                </div>
                <strong id="res-period">15 anos</strong>
              </div>
            </div>

            <div class="result-insight">
              <span class="insight-icon" aria-hidden="true">💡</span>
              <p id="result-message">
                Informe os parâmetros e clique em simular para visualizar
                a projeção do seu patrimônio.
              </p>
            </div>
          </div>

          <p class="result-disclaimer">
            <strong>Importante:</strong>
            esta é uma simulação matemática baseada em taxa constante.
            Os resultados são estimativas e não representam garantia de
            rentabilidade. Não estão descontados impostos, taxas, inflação
            ou eventuais oscilações de mercado.
          </p>
        </div>
      </div>
    </section>

    <!-- Conteúdo educativo -->
    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">ENTENDA SEUS INVESTIMENTOS</span>
        <h2>Como funciona o simulador de investimentos?</h2>
      </div>

      <p>
        O simulador utiliza o conceito de juros compostos para projetar
        o crescimento de um investimento ao longo do tempo. Você informa
        o capital inicial, os aportes mensais, a rentabilidade anual
        estimada e o prazo da aplicação.
      </p>

      <p>
        Com essas informações, é possível visualizar quanto do patrimônio
        acumulado corresponde ao dinheiro que saiu do seu bolso e quanto
        representa o rendimento gerado pela aplicação.
      </p>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>O que são juros compostos?</h2>
      </div>

      <p>
        Juros compostos são calculados sobre o capital inicial somado aos
        rendimentos acumulados anteriormente. Isso significa que os ganhos
        de um período também podem gerar novos ganhos nos períodos seguintes.
      </p>

      <p>
        Ao longo do tempo, esse efeito pode contribuir significativamente
        para o crescimento do patrimônio, principalmente quando os
        investimentos são mantidos por períodos mais longos.
      </p>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Por que investir mensalmente?</h2>
      </div>

      <div class="info-grid comparison-grid">
        <article class="info-card">
          <div class="step-number" aria-hidden="true">💵</div>
          <h3>Aportes frequentes</h3>
          <p>
            Investir regularmente permite adicionar recursos ao patrimônio
            mesmo sem começar com um valor elevado.
          </p>
          <ul>
            <li>Criação de disciplina financeira.</li>
            <li>Acumulação gradual de capital.</li>
            <li>Possibilidade de aproveitar os juros compostos.</li>
          </ul>
        </article>

        <article class="info-card">
          <div class="step-number" aria-hidden="true">⏳</div>
          <h3>Tempo de investimento</h3>
          <p>
            Quanto maior o período de permanência, maior pode ser o efeito
            da capitalização dos rendimentos.
          </p>
          <ul>
            <li>Mais períodos de capitalização.</li>
            <li>Maior potencial de acumulação.</li>
            <li>Planejamento de objetivos de longo prazo.</li>
          </ul>
        </article>
      </div>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Como o cálculo é realizado?</h2>
      </div>

      <p>
        A simulação considera o capital inicial, os aportes mensais e
        a taxa de rentabilidade convertida para uma taxa equivalente
        mensal, conforme a metodologia utilizada pelo motor de cálculo.
      </p>

      <div class="formula-card">
        <h3>Elementos considerados na simulação</h3>
        <div class="formula">
          Capital inicial + Aportes mensais + Juros compostos
        </div>
        <p>
          O montante final corresponde ao capital investido somado
          aos rendimentos acumulados durante o período simulado.
        </p>
      </div>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Renda fixa e renda variável: qual a diferença?</h2>
      </div>

      <p>
        Na renda fixa, a remuneração segue condições estabelecidas no momento
        da aplicação. Alguns investimentos possuem taxas prefixadas, enquanto
        outros acompanham indicadores como CDI, Selic ou inflação.
      </p>

      <p>
        Na renda variável, os resultados podem oscilar conforme as condições
        do mercado. Ações, fundos imobiliários e outros ativos podem apresentar
        períodos de valorização e desvalorização.
      </p>

      <p>
        Por isso, uma taxa fixa utilizada na calculadora deve ser entendida
        como uma hipótese de simulação, e não como uma previsão garantida
        para investimentos reais.
      </p>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>O que é rentabilidade real?</h2>
      </div>

      <p>
        Rentabilidade nominal é o rendimento apresentado antes de considerar
        a inflação. Já a rentabilidade real representa o ganho de poder
        de compra depois de descontar o efeito da inflação.
      </p>

      <p>
        Por exemplo, se um investimento rende 10% em um ano e a inflação
        no mesmo período é de 4%, o ganho real será inferior aos 10%
        apresentados nominalmente.
      </p>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>O simulador considera impostos e taxas?</h2>
      </div>

      <p>
        Não. O resultado apresentado é bruto e não desconta Imposto de Renda,
        IOF, taxas de administração, custódia ou outros custos. A tributação
        depende do tipo de investimento e do prazo da aplicação.
      </p>

      <p>
        Para avaliar uma aplicação real, consulte as condições do produto,
        os custos envolvidos e a rentabilidade líquida estimada.
      </p>
    </section>

    <!-- FAQ -->
    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">DÚVIDAS FREQUENTES</span>
        <h2>Perguntas sobre investimentos e rentabilidade</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>O que é aporte inicial?</summary>
          <p>
            É o valor aplicado no início do investimento. Ele representa
            o capital que começa a gerar rendimentos desde o primeiro
            período de capitalização.
          </p>
        </details>

        <details class="faq-item">
          <summary>O que são aportes mensais?</summary>
          <p>
            São contribuições periódicas adicionadas ao investimento.
            Podem ser valores fixos ou variáveis, conforme a estratégia
            e a disponibilidade financeira do investidor.
          </p>
        </details>

        <details class="faq-item">
          <summary>Quanto maior a taxa de juros, maior o patrimônio?</summary>
          <p>
            Em uma simulação matemática com os demais parâmetros constantes,
            uma taxa maior produz um montante projetado maior. Entretanto,
            rentabilidades mais elevadas podem envolver riscos maiores
            nos investimentos reais.
          </p>
        </details>

        <details class="faq-item">
          <summary>A calculadora garante o rendimento apresentado?</summary>
          <p>
            Não. O resultado é apenas uma projeção baseada em uma taxa
            constante. Investimentos reais podem apresentar oscilações,
            mudanças de rentabilidade, custos e tributação.
          </p>
        </details>

        <details class="faq-item">
          <summary>Qual é a diferença entre rendimento bruto e líquido?</summary>
          <p>
            O rendimento bruto não desconta impostos e custos. O rendimento
            líquido representa o valor restante depois da dedução dos encargos
            aplicáveis ao investimento.
          </p>
        </details>

        <details class="faq-item">
          <summary>Vale a pena começar a investir com pouco dinheiro?</summary>
          <p>
            A possibilidade depende do produto financeiro escolhido. Muitos
            investimentos permitem aplicações iniciais pequenas. A regularidade
            dos aportes e o planejamento podem ser mais importantes do que
            começar com um valor elevado.
          </p>
        </details>

        <details class="faq-item">
          <summary>O simulador considera a inflação?</summary>
          <p>
            Não. Os resultados são apresentados em valores nominais. Para
            conhecer o poder de compra futuro do patrimônio, é necessário
            considerar também uma estimativa de inflação.
          </p>
        </details>
      </div>
    </section>

    <aside class="disclaimer final-note" style="margin-top: 3rem;">
      <div class="notice-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        </svg>
        <strong>Calculadora de Ganhos</strong>
      </div>
      <p>
        Utilize nossas ferramentas para simular cenários, organizar
        seu planejamento financeiro e tomar decisões mais conscientes.
      </p>
      <a href="/financas/">Explorar outras ferramentas financeiras →</a>
    </aside>
  </main>

  <script>
    import { calculateCompoundInterest } from '../../engines/finance/compound-interest';
    import { formatBRL } from '../../engines/common/currency';

    const form = document.getElementById('investment-form') as HTMLFormElement;

    const initialInput = document.getElementById('initial') as HTMLInputElement;
    const monthlyInput = document.getElementById('monthly') as HTMLInputElement;
    const rateInput = document.getElementById('rate') as HTMLInputElement;
    const yearsInput = document.getElementById('years') as HTMLInputElement;

    const errorElement = document.getElementById('form-error') as HTMLDivElement;

    const finalElement = document.getElementById('res-final')!;
    const investedElement = document.getElementById('res-invested')!;
    const interestElement = document.getElementById('res-interest')!;
    const initialElement = document.getElementById('res-initial')!;
    const periodElement = document.getElementById('res-period')!;
    const messageElement = document.getElementById('result-message')!;

    function showError(message: string) {
      errorElement.textContent = message;
      errorElement.hidden = false;
    }

    function clearError() {
      errorElement.textContent = '';
      errorElement.hidden = true;
    }

    function runCalc() {
      clearError();

      const initial = Number(initialInput.value);
      const monthly = Number(monthlyInput.value);
      const rate = Number(rateInput.value);
      const years = Number(yearsInput.value);

      if (!Number.isFinite(initial) || initial < 0) {
        showError('Informe um aporte inicial igual ou maior que zero.');
        return;
      }

      if (!Number.isFinite(monthly) || monthly < 0) {
        showError('Informe um aporte mensal igual ou maior que zero.');
        return;
      }

      if (!Number.isFinite(rate) || rate < -99 || rate > 1000) {
        showError('Informe uma rentabilidade anual entre -99% e 1000%.');
        return;
      }

      if (!Number.isInteger(years) || years < 0 || years > 100) {
        showError('Informe um período inteiro entre 0 e 100 anos.');
        return;
      }

      if (initial === 0 && monthly === 0) {
        showError('Informe um aporte inicial ou mensal maior que zero.');
        return;
      }

      const months = years * 12;

      try {
        const result = calculateCompoundInterest({
          initialCapital: initial,
          monthlyContribution: monthly,
          annualInterestRate: rate,
          months,
        });

        if (
          !Number.isFinite(result.finalAmount) ||
          !Number.isFinite(result.totalInvested) ||
          !Number.isFinite(result.totalInterest)
        ) {
          throw new Error('O motor retornou valores inválidos para a simulação.');
        }

        finalElement.textContent = formatBRL(result.finalAmount);
        investedElement.textContent = formatBRL(result.totalInvested);
        interestElement.textContent = formatBRL(result.totalInterest);
        initialElement.textContent = formatBRL(initial);

        periodElement.textContent =
          years === 1 ? '1 ano' : `${years} anos`;

        messageElement.textContent =
          'Simulação concluída. O patrimônio apresentado representa uma projeção bruta baseada na taxa e nos aportes informados.';
      } catch (error) {
        console.error('Erro na simulação de investimentos:', error);

        showError(
          error instanceof Error
            ? error.message
            : 'Não foi possível realizar a simulação. Verifique os dados informados.'
        );
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      runCalc();
    });

    document.getElementById('reset-btn')?.addEventListener('click', () => {
      initialInput.value = '5000';
      monthlyInput.value = '1000';
      rateInput.value = '12';
      yearsInput.value = '15';

      runCalc();
    });

    runCalc();
  </script>

  <style>
    .page-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0.5rem 0 4rem;
      color: var(--text-primary);
    }

    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 1.75rem;
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .breadcrumb a,
    .back-link a {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover,
    .back-link a:hover {
      color: var(--color-primary);
    }

    .page-header {
      max-width: 790px;
      margin-bottom: 3rem;
    }

    .eyebrow,
    .section-kicker,
    .section-label {
      display: inline-block;
      margin-bottom: 0.75rem;
      color: var(--color-primary);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.1em;
    }

    .page-header h1 {
      margin: 0 0 0.9rem;
      color: var(--text-primary);
      font-size: clamp(2rem, 5vw, 2.7rem);
      line-height: 1.2;
    }

    .page-header > p {
      max-width: 790px;
      margin: 0;
      color: var(--text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .icon-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(6, 95, 70, 0.1);
      color: var(--color-primary);
      flex-shrink: 0;
    }

    :global([data-theme="dark"]) .icon-badge {
      background: rgba(16, 185, 129, 0.14);
    }

    .calculator-section {
      margin-bottom: 3.5rem;
      scroll-margin-top: 2rem;
    }

    .section-heading {
      margin-bottom: 1.5rem;
    }

    .section-heading h2 {
      margin: 0 0 0.6rem;
      font-size: 1.65rem;
      line-height: 1.3;
    }

    .section-heading > p {
      max-width: 760px;
      margin: 0;
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.75;
    }

    .calculator-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      align-items: stretch;
    }

    .card {
      min-width: 0;
      padding: 1.65rem;
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: var(--bg-secondary);
    }

    .card-heading {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1.4rem;
    }

    .card-heading h3 {
      margin: 0;
      font-size: 1.2rem;
    }

    .card-heading p {
      margin: 0.2rem 0 0;
      color: var(--text-secondary);
      font-size: 0.82rem;
    }

    .input-card .card-heading h3 {
      color: var(--color-primary);
    }

    .field-group {
      margin-bottom: 1.25rem;
    }

    .field-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
      font-weight: 650;
      line-height: 1.5;
    }

    .input-wrapper {
      display: flex;
      align-items: center;
      border: 1px solid var(--border-color);
      border-radius: 9px;
      background: var(--bg-primary);
      overflow: hidden;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-wrapper:focus-within {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(6, 95, 70, 0.12);
    }

    :global([data-theme="dark"]) .input-wrapper:focus-within {
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.16);
    }

    .input-wrapper input {
      width: 100%;
      min-width: 0;
      min-height: 46px;
      padding: 0.75rem 0.9rem;
      border: none;
      outline: none;
      background: transparent;
      color: var(--text-primary);
      font: inherit;
      box-sizing: border-box;
    }

    .input-prefix,
    .input-suffix {
      padding: 0 0.85rem;
      color: var(--text-secondary);
      font-size: 0.85rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .input-prefix {
      border-right: 1px solid var(--border-color);
    }

    .input-suffix {
      border-left: 1px solid var(--border-color);
    }

    .field-group small {
      display: block;
