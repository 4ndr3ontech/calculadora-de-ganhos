
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Simulador de Financiamento Imobiliário SAC — Calcule Parcelas e Juros | Calculadora de Ganhos"
  description="Simule um financiamento imobiliário pelo sistema SAC. Calcule valor financiado, primeira parcela, juros totais e custo do imóvel."
>
  <div class="financing-page">
    <!-- NAVEGAÇÃO -->
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/financas/">Finanças</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Financiamento Imobiliário SAC</span>
    </nav>

    <!-- CABEÇALHO -->
    <header class="hero">
      <span class="eyebrow">PLANEJAMENTO FINANCEIRO</span>

      <h1>Simulador de Financiamento Imobiliário SAC</h1>

      <p>
        Descubra quanto você precisará financiar para comprar um imóvel,
        estime o valor da primeira parcela e veja o impacto dos juros
        ao longo do contrato.
      </p>

      <div class="hero-highlights">
        <div class="highlight">
          <span class="highlight-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
          </span>
          <span>Simulação gratuita</span>
        </div>

        <div class="highlight">
          <span class="highlight-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
          </span>
          <span>Amortização constante</span>
        </div>

        <div class="highlight">
          <span class="highlight-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
          </span>
          <span>Cálculo de juros totais</span>
        </div>
      </div>
    </header>

    <!-- CALCULADORA -->
    <section class="calculator-section" id="calculadora" aria-labelledby="calculator-title">
      <div class="section-heading">
        <span class="section-label">SIMULADOR GRATUITO</span>
        <h2 id="calculator-title">Informe os dados do financiamento</h2>
        <p>
          Preencha o valor do imóvel, a entrada, a taxa de juros e o prazo
          desejado para realizar a simulação.
        </p>
      </div>

      <div class="calc-grid">
        <!-- ENTRADAS -->
        <div class="card input-card">
          <h3>Dados do imóvel</h3>

          <div class="field-group">
            <label for="prop-value">Valor do imóvel (R$)</label>
            <div class="input-wrapper">
              <span class="input-prefix">R$</span>
              <input
                type="number"
                id="prop-value"
                value="350000"
                min="1"
                max="100000000"
                step="10000"
                inputmode="decimal"
                aria-describedby="prop-value-help"
              />
            </div>
            <small id="prop-value-help">
              Preço de compra do imóvel que você deseja financiar.
            </small>
          </div>

          <div class="field-group">
            <label for="down-payment">Valor da entrada (R$)</label>
            <div class="input-wrapper">
              <span class="input-prefix">R$</span>
              <input
                type="number"
                id="down-payment"
                value="70000"
                min="0"
                max="100000000"
                step="5000"
                inputmode="decimal"
                aria-describedby="down-payment-help"
              />
            </div>
            <small id="down-payment-help">
              Valor que será pago inicialmente com recursos próprios.
            </small>
          </div>

          <div class="field-row">
            <div class="field-group">
              <label for="rate">Taxa anual (% a.a.)</label>
              <div class="input-wrapper">
                <input
                  type="number"
                  id="rate"
                  value="9.5"
                  min="0"
                  max="100"
                  step="0.1"
                  inputmode="decimal"
                  aria-describedby="rate-help"
                />
                <span class="input-suffix">%</span>
              </div>
              <small id="rate-help">
                Taxa anual de referência da proposta.
              </small>
            </div>

            <div class="field-group">
              <label for="years">Prazo (anos)</label>
              <div class="input-wrapper">
                <input
                  type="number"
                  id="years"
                  value="30"
                  min="1"
                  max="40"
                  step="1"
                  inputmode="numeric"
                  aria-describedby="years-help"
                />
                <span class="input-suffix">anos</span>
              </div>
              <small id="years-help">
                Convertido em meses para o cálculo.
              </small>
            </div>
          </div>

          <div class="simulation-summary">
            <div>
              <span>Entrada informada</span>
              <strong id="summary-entry">R$ 70.000,00</strong>
            </div>
            <div>
              <span>Percentual de entrada</span>
              <strong id="summary-percent">20,00%</strong>
            </div>
          </div>

          <button id="calc-btn" class="btn btn-primary" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>
            </svg>
            <span>Calcular financiamento</span>
          </button>

          <p class="input-note">
            Os cálculos são executados no navegador por esta ferramenta.
            Não informe dados pessoais, bancários ou documentos.
          </p>
        </div>

        <!-- RESULTADOS -->
        <div class="card result-card" aria-live="polite" aria-atomic="true">
          <div>
            <span class="section-label">RESULTADO DA SIMULAÇÃO</span>
            <h3>Resumo do financiamento</h3>

            <div class="main-result">
              <span>Primeira parcela estimada (SAC)</span>
              <strong id="res-first">R$ 0,00</strong>
              <small class="result-description">
                A parcela tende a diminuir ao longo do contrato.
              </small>
            </div>

            <div class="result-line">
              <span>
                <span class="result-dot blue" aria-hidden="true"></span>
                Valor financiado
              </span>
              <strong id="res-financed">R$ 0,00</strong>
            </div>

            <div class="result-line">
              <span>
                <span class="result-dot red" aria-hidden="true"></span>
                Total de juros
              </span>
              <strong id="res-interest" class="interest-value">R$ 0,00</strong>
            </div>

            <div class="result-line">
              <span>
                <span class="result-dot green" aria-hidden="true"></span>
                Total pago no financiamento
              </span>
              <strong id="res-total">R$ 0,00</strong>
            </div>

            <p id="calc-error" class="calc-error" role="alert" hidden></p>
          </div>

          <div class="result-observation">
            <strong>Como interpretar:</strong>
            <p>
              O valor financiado corresponde ao imóvel descontando a entrada.
              Os juros representam o custo financeiro do crédito ao longo do
              prazo simulado. A estimativa não representa proposta ou aprovação
              de crédito.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- INTRODUÇÃO -->
    <section class="content-section" aria-labelledby="what-title">
      <div class="section-heading">
        <span class="section-label">ENTENDA O SISTEMA SAC</span>
        <h2 id="what-title">O que é financiamento imobiliário SAC?</h2>
        <p>
          SAC significa Sistema de Amortização Constante. É um modelo de
          financiamento no qual a amortização do saldo devedor é constante
          durante o contrato, permitindo planejar a compra do seu imóvel com
          mais previsibilidade.
        </p>
      </div>

      <div class="explanation-grid">
        <article class="explanation-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/>
            </svg>
          </div>
          <h3>Parcelas decrescentes</h3>
          <p>
            Como o saldo devedor diminui a cada pagamento, os juros cobrados
            sobre esse saldo também tendem a diminuir. Por isso, as parcelas
            normalmente ficam menores com o passar do tempo.
          </p>
        </article>

        <article class="explanation-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h3>Amortização constante</h3>
          <p>
            Uma parte fixa do valor financiado é amortizada em cada parcela.
            Isso significa que o saldo devedor é reduzido de maneira regular
            durante o contrato.
          </p>
        </article>

        <article class="explanation-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/>
            </svg>
          </div>
          <h3>Juros sobre o saldo devedor</h3>
          <p>
            Os juros são calculados sobre o saldo que ainda falta pagar.
            Conforme a dívida diminui, o valor destinado aos juros também
            tende a cair.
          </p>
        </article>
      </div>
    </section>

    <!-- METODOLOGIA -->
    <section class="content-section" aria-labelledby="methodology-title">
      <div class="section-heading">
        <span class="section-label">METODOLOGIA DE CÁLCULO</span>
        <h2 id="methodology-title">Como funciona o cálculo?</h2>
        <p>
          A simulação considera os principais parâmetros de um financiamento
          imobiliário com amortização pelo sistema SAC.
        </p>
      </div>

      <div class="methodology-box">
        <div>
          <h3>1. Valor financiado</h3>
          <p>
            O valor financiado é obtido subtraindo a entrada do preço informado
            para o imóvel.
          </p>
          <div class="formula">
            Valor financiado = Valor do imóvel − Entrada
          </div>
        </div>

        <div>
          <h3>2. Quantidade de parcelas</h3>
          <p>
            O prazo informado em anos é convertido em meses para determinar
            a duração da simulação.
          </p>
          <div class="formula">
            Prazo em meses = Anos × 12
          </div>
        </div>

        <div>
          <h3>3. Amortização</h3>
          <p>
            No sistema SAC, o valor amortizado mensalmente é constante.
            Em uma representação simplificada, ele corresponde ao saldo
            financiado dividido pelo número de parcelas.
          </p>
          <div class="formula">
            Amortização mensal = Valor financiado ÷ Número de parcelas
          </div>
        </div>

        <div>
          <h3>4. Composição da parcela</h3>
          <p>
            Cada prestação é composta por uma parte de amortização e outra
            de juros. Como o saldo devedor diminui, os juros tendem a cair
            ao longo do tempo.
          </p>
          <div class="formula">
            Parcela = Amortização + Juros do período
          </div>
        </div>

        <div class="methodology-note">
          <strong>Atenção:</strong>
          as fórmulas acima explicam o funcionamento conceitual do SAC.
          A conversão da taxa anual para mensal, os critérios de arredondamento
          e os valores finais exibidos dependem da implementação de
          <code>calculateFinancingSAC</code> utilizada nesta página.
        </div>
      </div>
    </section>

    <!-- EXEMPLO PRÁTICO -->
    <section class="content-section" aria-labelledby="example-title">
      <div class="section-heading">
        <span class="section-label">EXEMPLO PRÁTICO</span>
        <h2 id="example-title">Simulação de compra de um imóvel</h2>
        <p>
          Considere um imóvel de R$ 350 mil, com entrada de R$ 70 mil,
          taxa anual informada de 9,5% e prazo de 30 anos.
        </p>
      </div>

      <div class="example-card">
        <h3>Exemplo ilustrativo — Imóvel de R$ 350.000,00</h3>

        <div class="example-data">
          <div>
            <span>Valor do imóvel</span>
            <strong>R$ 350.000,00</strong>
          </div>

          <div>
            <span>Entrada</span>
            <strong>R$ 70.000,00</strong>
          </div>

          <div>
            <span>Percentual de entrada</span>
            <strong>20%</strong>
          </div>

          <div>
            <span>Valor financiado</span>
            <strong>R$ 280.000,00</strong>
          </div>

          <div>
            <span>Taxa anual informada</span>
            <strong>9,5%</strong>
          </div>

          <div>
            <span>Prazo</span>
            <strong>360 meses</strong>
          </div>
        </div>

        <p>
          Os dados acima representam apenas os parâmetros de entrada.
          Os valores de parcelas e juros devem ser calculados pela ferramenta
          e não constituem uma proposta bancária.
        </p>
      </div>
    </section>

    <!-- COMPARAÇÃO -->
    <section class="content-section" aria-labelledby="comparison-title">
      <div class="section-heading">
        <span class="section-label">COMPARAÇÃO</span>
        <h2 id="comparison-title">SAC ou Tabela Price: qual a diferença?</h2>
        <p>
          Os dois sistemas são utilizados em operações de financiamento,
          mas possuem formas diferentes de distribuir amortização e juros.
        </p>
      </div>

      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Característica</th>
              <th>SAC</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Amortização</td>
              <td>Constante</td>
              <td>Variável</td>
            </tr>
            <tr>
              <td>Parcelas</td>
              <td>Geralmente decrescentes</td>
              <td>Geralmente constantes</td>
            </tr>
            <tr>
              <td>Saldo devedor</td>
              <td>Diminui de forma regular</td>
              <td>Diminui de forma gradual</td>
            </tr>
            <tr>
              <td>Início do contrato</td>
              <td>Parcela inicial geralmente maior</td>
              <td>Prestação inicial geralmente menor</td>
            </tr>
            <tr>
              <td>Perfil</td>
              <td>Quem consegue suportar parcelas iniciais maiores</td>
              <td>Quem busca maior previsibilidade da prestação</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="comparison-note">
        A comparação efetiva depende das taxas, prazos, condições contratuais
        e demais encargos de cada proposta.
      </p>
    </section>

    <!-- DICAS DE PLANEJAMENTO -->
    <section class="content-section" aria-labelledby="tips-title">
      <div class="section-heading">
        <span class="section-label">PLANEJAMENTO</span>
        <h2 id="tips-title">O que avaliar antes de financiar um imóvel?</h2>
      </div>

      <div class="instruction-list">
        <article class="instruction-card">
          <span class="step-number">01</span>
          <div>
            <h3>Organize o valor da entrada</h3>
            <p>
              Uma entrada maior reduz o valor financiado e pode diminuir
              o custo total dos juros, dependendo das condições do contrato.
            </p>
          </div>
        </article>

        <article class="instruction-card">
          <span class="step-number">02</span>
          <div>
            <h3>Compare propostas de diferentes bancos</h3>
            <p>
              Observe taxas, custo efetivo total, seguros, tarifas e
              condições de amortização. Não escolha uma proposta apenas
              pelo valor da primeira parcela.
            </p>
          </div>
        </article>

        <article class="instruction-card">
          <span class="step-number">03</span>
          <div>
            <h3>Considere as despesas adicionais</h3>
            <p>
              ITBI, escritura, registro, avaliação do imóvel, seguros
              obrigatórios e tarifas podem aumentar o custo da aquisição.
            </p>
          </div>
        </article>

        <article class="instruction-card">
          <span class="step-number">04</span>
          <div>
            <h3>Não comprometa todo o orçamento</h3>
            <p>
              Considere despesas domésticas, condomínio, IPTU, manutenção
              e uma reserva para imprevistos antes de assumir a prestação.
            </p>
          </div>
        </article>

        <article class="instruction-card">
          <span class="step-number">05</span>
          <div>
            <h3>Analise a possibilidade de amortização antecipada</h3>
            <p>
              Pagamentos extras podem reduzir o saldo devedor e os juros
              futuros, conforme as condições do contrato e as regras
              da instituição financeira.
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading">
        <span class="section-label">DÚVIDAS FREQUENTES</span>
        <h2 id="faq-title">Perguntas sobre financiamento SAC</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>O que significa SAC?</summary>
          <p>
            SAC significa Sistema de Amortização Constante. Nesse modelo,
            a amortização do saldo devedor é constante, enquanto os juros
            tendem a diminuir conforme a dívida é reduzida.
          </p>
        </details>

        <details class="faq-item">
          <summary>As parcelas do SAC diminuem todos os meses?</summary>
          <p>
            Em uma operação com taxa e condições constantes, as parcelas
            tendem a diminuir ao longo do contrato. Entretanto, seguros,
            encargos, indexadores e outras condições contratuais podem
            alterar o valor efetivamente cobrado.
          </p>
        </details>

        <details class="faq-item">
          <summary>O que acontece se eu aumentar a entrada?</summary>
          <p>
            Uma entrada maior reduz o valor que precisa ser financiado.
            Isso normalmente diminui a amortização total necessária e
            os juros calculados sobre o saldo devedor.
          </p>
        </details>

        <details class="faq-item">
          <summary>O simulador inclui seguro MIP e DFI?</summary>
          <p>
            Não há campos específicos para esses seguros nesta calculadora.
            Portanto, não considere esses valores incluídos no resultado
            sem verificar a implementação do motor de cálculo.
          </p>
        </details>

        <details class="faq-item">
          <summary>O resultado inclui ITBI e cartório?</summary>
          <p>
            Não há campos para ITBI, escritura, registro ou outras despesas
            de aquisição. Esses valores devem ser considerados separadamente
            no planejamento financeiro.
          </p>
        </details>

        <details class="faq-item">
          <summary>Qual é a diferença entre taxa de juros e CET?</summary>
          <p>
            A taxa de juros representa o custo dos juros do financiamento.
            O Custo Efetivo Total (CET) reúne os encargos e despesas
            considerados na operação, permitindo uma comparação mais
            abrangente entre propostas.
          </p>
        </details>

        <details class="faq-item">
          <summary>Esta simulação garante aprovação do financiamento?</summary>
          <p>
            Não. A ferramenta apresenta uma estimativa matemática.
            A aprovação depende da análise de crédito, avaliação do imóvel,
            documentação, políticas e critérios da instituição financeira.
          </p>
        </details>
      </div>
    </section>

    <!-- AVISO LEGAL -->
    <aside class="final-notice">
      <div class="notice-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        </svg>
        <strong>Aviso importante:</strong>
      </div>
      <p>
        Esta ferramenta possui finalidade informativa e educacional.
        Os resultados são estimativas e não constituem proposta,
        aprovação de crédito ou aconselhamento financeiro. As condições reais
        dependem do contrato e da instituição financeira. Consulte o CET e
        todos os encargos antes de contratar.
      </p>
    </aside>

    <!-- CTA -->
    <section class="final-cta">
      <span class="section-label">CALCULADORA DE GANHOS</span>
      <h2>Planeje seu financiamento antes de fechar negócio</h2>
      <p>
        Simule diferentes valores de entrada, taxas e prazos para entender
        melhor o compromisso financeiro que acompanha a compra de um imóvel.
      </p>
      <a href="#calculadora" class="cta-link">
        <span>Voltar ao simulador</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>
        </svg>
      </a>
    </section>
  </div>

  <script>
    import { calculateFinancingSAC } from '../../engines/finance/financing';
    import { formatBRL } from '../../engines/common/currency';

    let pageController: AbortController | null = null;

    function initPage() {
      // Remove os eventos da inicialização anterior.
      pageController?.abort();

      pageController = new AbortController();

      const { signal } = pageController;

      const propertyInput = document.getElementById('prop-value') as HTMLInputElement | null;
      const downPaymentInput = document.getElementById('down-payment') as HTMLInputElement | null;
      const rateInput = document.getElementById('rate') as HTMLInputElement | null;
      const yearsInput = document.getElementById('years') as HTMLInputElement | null;

      const errorElement = document.getElementById('calc-error');
      const calculateButton = document.getElementById('calc-btn');

      const summaryEntryOutput = document.getElementById('summary-entry');
      const summaryPercentOutput = document.getElementById('summary-percent');

      const firstOutput = document.getElementById('res-first');
      const financedOutput = document.getElementById('res-financed');
      const interestOutput = document.getElementById('res-interest');
      const totalOutput = document.getElementById('res-total');

      // Verifica se todos os elementos necessários existem.
      if (
        !propertyInput ||
        !downPaymentInput ||
        !rateInput ||
        !yearsInput ||
        !errorElement ||
        !calculateButton ||
        !summaryEntryOutput ||
        !summaryPercentOutput ||
        !firstOutput ||
        !financedOutput ||
        !interestOutput ||
        !totalOutput
      ) {
        return;
      }

      const fields = {
        propertyValue: propertyInput,
        downPayment: downPaymentInput,
        rate: rateInput,
        years: yearsInput,
      };

      const outputs = {
        first: firstOutput,
        financed: financedOutput,
        interest: interestOutput,
        total: totalOutput,
      };

      interface FinancingValues {
        propertyValue: number;
        downPayment: number;
        rate: number;
        years: number;
      }

      function readNumber(input: HTMLInputElement): number | null {
        const rawValue = input.value.trim();

        if (rawValue === '') {
          return null;
        }

        const number = Number(rawValue);

        return Number.isFinite(number) ? number : null;
      }

      function readValues(): FinancingValues | null {
        const propertyValue = readNumber(fields.propertyValue);
        const downPayment = readNumber(fields.downPayment);
        const rate = readNumber(fields.rate);
        const years = readNumber(fields.years);

        if (
          propertyValue === null ||
          downPayment === null ||
          rate === null ||
          years === null
        ) {
          return null;
        }

        return {
          propertyValue,
          downPayment,
          rate,
          years,
        };
      }

      function updateEntrySummary() {
        const propertyValue = readNumber(fields.propertyValue);
        const downPayment = readNumber(fields.downPayment);

        if (
          propertyValue === null ||
          downPayment === null ||
          propertyValue <= 0 ||
          downPayment < 0 ||
          downPayment >= propertyValue
        ) {
          summaryEntryOutput.textContent = '—';
          summaryPercentOutput.textContent = '—';
          return;
        }

        const percentage = (downPayment / propertyValue) * 100;

        summaryEntryOutput.textContent = formatBRL(downPayment);

        summaryPercentOutput.textContent = `${percentage.toLocaleString('pt-BR', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        })}%`;
      }

      function validateInputs(values: FinancingValues): string | null {
        if (
          values.propertyValue <= 0 ||
          values.propertyValue > 100000000
        ) {
          return 'Informe um valor de imóvel maior que zero e de até R$ 100 milhões.';
        }

        if (
          values.downPayment < 0 ||
          values.downPayment >= values.propertyValue
        ) {
          return 'A entrada deve ser igual ou maior que zero e menor que o valor do imóvel.';
        }

        if (values.rate < 0 || values.rate > 100) {
          return 'Informe uma taxa anual entre 0% e 100%.';
        }

        if (
          !Number.isInteger(values.years) ||
          values.years < 1 ||
          values.years > 40
        ) {
          return 'Informe um prazo inteiro entre 1 e 40 anos.';
        }

        return null;
      }

      function resetResults() {
        outputs.first.textContent = '—';
        outputs.financed.textContent = '—';
        outputs.interest.textContent = '—';
        outputs.total.textContent = '—';
      }

      function showError(message: string) {
        errorElement.textContent = message;
        errorElement.hidden = false;

        resetResults();
      }

      function clearError() {
        errorElement.textContent = '';
        errorElement.hidden = true;
      }

      function runCalc() {
        updateEntrySummary();

        const values = readValues();

        if (!values) {
          showError('Preencha todos os campos com valores numéricos válidos.');
          return;
        }

        const validationError = validateInputs(values);

        if (validationError) {
          showError(validationError);
          return;
        }

        clearError();

        try {
          const months = values.years * 12;

          const result = calculateFinancingSAC({
            propertyValue: values.propertyValue,
            downPayment: values.downPayment,
            annualInterestRate: values.rate,
            months,
          });

          if (
            !result ||
            !Array.isArray(result.schedule) ||
            !Number.isFinite(result.financedAmount) ||
            !Number.isFinite(result.totalInterest) ||
            !Number.isFinite(result.totalPayment) ||
            result.financedAmount < 0 ||
            result.totalInterest < 0 ||
            result.totalPayment < 0
          ) {
            throw new Error('O motor retornou resultados inválidos.');
          }

          if (result.schedule.length === 0) {
            throw new Error('O cronograma de parcelas está vazio.');
          }

          const firstInstallment = result.schedule[0]?.installment;

          if (
            typeof firstInstallment !== 'number' ||
            !Number.isFinite(firstInstallment) ||
            firstInstallment < 0
          ) {
            throw new Error('A primeira parcela retornada é inválida.');
          }

          outputs.first.textContent = formatBRL(firstInstallment);
          outputs.financed.textContent = formatBRL(result.financedAmount);
          outputs.interest.textContent = formatBRL(result.totalInterest);
          outputs.total.textContent = formatBRL(result.totalPayment);
        } catch (error) {
          console.error('Erro ao calcular financiamento SAC:', error);

          showError(
            'Não foi possível calcular o financiamento. Confira os dados e tente novamente.'
          );
        }
      }

      // Botão de cálculo.
      calculateButton.addEventListener('click', runCalc, { signal });

      // Atualização automática dos resultados e do resumo.
      Object.values(fields).forEach((input) => {
        input.addEventListener('input', runCalc, { signal });
        input.addEventListener('change', runCalc, { signal });
      });

      // Executa uma simulação inicial com os valores padrão.
      runCalc();
    }

    // Inicialização inicial.
    initPage();

    // Reexecuta após navegações feitas pelo Astro.
    document.addEventListener('astro:page-load', initPage);
  </script>

