---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calculadora de Quitação e Amortização de Financiamento — Calculadora de Ganhos"
  description="Simule a amortização ou quitação do seu financiamento. Descubra a economia estimada de juros e compare a redução do prazo com a redução da prestação."
>
  <main class="page-container">
    <nav class="breadcrumb" aria-label="Navegação">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/financas/">Finanças</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Quitação e Amortização</span>
    </nav>

    <header class="page-header">
      <span class="eyebrow">PLANEJAMENTO FINANCEIRO</span>
      <h1>Calculadora de Amortização e Quitação</h1>
      <p>
        Descubra quanto você pode economizar ao antecipar pagamentos do seu
        financiamento. Compare as opções de reduzir o prazo ou diminuir o
        valor das parcelas.
      </p>
    </header>

    <section class="calculator-section" aria-label="Simulador de amortização">
      <div class="calculator-grid">
        <!-- Entradas -->
        <div class="card input-card">
          <div class="card-heading">
            <div class="icon-badge" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </div>
            <div>
              <h3>Dados do financiamento</h3>
              <p>Informe os dados atuais do seu contrato.</p>
            </div>
          </div>

          <form id="amortization-form">
            <div class="field-group">
              <label for="balance">Saldo devedor atual</label>
              <div class="input-wrapper">
                <span class="input-prefix">R$</span>
                <input
                  type="number"
                  id="balance"
                  value="250000"
                  min="0.01"
                  step="0.01"
                  required
                />
              </div>
              <small>Valor que ainda falta pagar ao banco.</small>
            </div>

            <div class="field-group">
              <label for="months">Prazo restante</label>
              <div class="input-wrapper">
                <input
                  type="number"
                  id="months"
                  value="240"
                  min="1"
                  max="600"
                  step="1"
                  required
                />
                <span class="input-suffix">meses</span>
              </div>
              <small>Quantidade de parcelas que ainda faltam.</small>
            </div>

            <div class="field-group">
              <label for="interest-rate">Taxa de juros anual</label>
              <div class="input-wrapper">
                <input
                  type="number"
                  id="interest-rate"
                  value="9.5"
                  min="0"
                  max="100"
                  step="0.01"
                  required
                />
                <span class="input-suffix">% a.a.</span>
              </div>
              <small>Taxa anual informada no contrato.</small>
            </div>

            <div class="field-group">
              <label for="amort-amount">Valor extra para amortização</label>
              <div class="input-wrapper">
                <span class="input-prefix">R$</span>
                <input
                  type="number"
                  id="amort-amount"
                  value="30000"
                  min="0.01"
                  step="0.01"
                  required
                />
              </div>
              <small>
                Informe o valor que pretende utilizar, inclusive recursos
                próprios ou FGTS, quando permitido.
              </small>
            </div>

            <div class="field-group">
              <label for="amort-type">Como deseja amortizar?</label>
              <select id="amort-type">
                <option value="prazo">Reduzir o prazo do financiamento</option>
                <option value="prestacao">Reduzir o valor da prestação</option>
              </select>
              <small>
                Escolha entre terminar de pagar antes ou diminuir o compromisso
                mensal.
              </small>
            </div>

            <div id="form-error" class="error-message" role="alert" hidden></div>

            <button type="submit" class="btn-calculate">
              <span>Calcular economia</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </button>

            <button type="button" id="reset-btn" class="btn-reset">
              Restaurar valores iniciais
            </button>
          </form>
        </div>

        <!-- Resultados -->
        <div class="card result-card" aria-live="polite">
          <div>
            <div class="card-heading">
              <div class="icon-badge result-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/>
                </svg>
              </div>
              <div>
                <h3>Resultado da simulação</h3>
                <p>Veja o impacto estimado da amortização.</p>
              </div>
            </div>

            <div class="main-result savings-panel">
              <span class="result-label">Economia estimada de juros</span>
              <strong id="res-saved">R$ 0,00</strong>
              <span class="savings-caption">
                Valor estimado que você deixa de pagar em juros.
              </span>
            </div>

            <div class="result-breakdown">
              <div id="result-detail-prazo" class="result-row">
                <div>
                  <span class="result-dot invested-dot"></span>
                  <div>
                    <strong>Redução do prazo</strong>
                    <span>Tempo retirado do financiamento</span>
                  </div>
                </div>
                <strong id="res-months">0 meses</strong>
              </div>

              <div id="result-detail-prestacao" class="result-row" hidden>
                <div>
                  <span class="result-dot invested-dot"></span>
                  <div>
                    <strong>Nova prestação estimada</strong>
                    <span>Valor mensal após a amortização</span>
                  </div>
                </div>
                <strong id="res-payment">R$ 0,00</strong>
              </div>

              <div class="result-row">
                <div>
                  <span class="result-dot interest-dot"></span>
                  <div>
                    <strong>Valor amortizado</strong>
                    <span>Recurso extra utilizado</span>
                  </div>
                </div>
                <strong id="res-amort">R$ 0,00</strong>
              </div>

              <div class="result-row">
                <div>
                  <span class="result-dot"></span>
                  <div>
                    <strong>Saldo devedor informado</strong>
                    <span>Antes da amortização</span>
                  </div>
                </div>
                <strong id="res-balance">R$ 0,00</strong>
              </div>
            </div>

            <div class="result-insight">
              <span class="insight-icon" aria-hidden="true">💡</span>
              <p id="result-message">
                Preencha os dados e clique em calcular para visualizar sua
                simulação.
              </p>
            </div>
          </div>

          <p class="result-disclaimer">
            <strong>Importante:</strong>
            esta ferramenta apresenta uma estimativa matemática. O resultado
            efetivo depende do sistema de amortização, das condições do contrato,
            dos encargos, dos seguros e das regras aplicáveis ao financiamento.
          </p>
        </div>
      </div>
    </section>

    <!-- Conteúdo educativo -->
    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">ENTENDA A SIMULAÇÃO</span>
        <h2>O que é amortização de financiamento?</h2>
      </div>

      <p>
        Amortizar significa antecipar o pagamento de uma parte do saldo
        devedor de um financiamento. Ao utilizar um valor extra para reduzir
        a dívida, você pode diminuir o tempo necessário para quitar o contrato
        ou reduzir o valor das prestações futuras.
      </p>

      <p>
        Essa estratégia é bastante utilizada em financiamentos imobiliários,
        mas também pode ser considerada em outros tipos de crédito, conforme
        as condições estabelecidas pela instituição financeira.
      </p>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Reduzir o prazo ou reduzir a prestação?</h2>
      </div>

      <div class="info-grid comparison-grid">
        <article class="info-card">
          <div class="step-number" aria-hidden="true">⏱</div>
          <h3>Reduzir o prazo</h3>
          <p>
            O valor das parcelas pode permanecer semelhante, mas a quantidade
            de meses restantes diminui. Essa alternativa costuma proporcionar
            uma economia maior de juros, dependendo do contrato.
          </p>
          <ul>
            <li>Antecipação da quitação.</li>
            <li>Menos tempo de financiamento.</li>
            <li>Potencial de redução dos juros totais.</li>
          </ul>
        </article>

        <article class="info-card">
          <div class="step-number" aria-hidden="true">↓</div>
          <h3>Reduzir a prestação</h3>
          <p>
            O prazo restante é mantido e o valor das parcelas é recalculado.
            Essa alternativa pode ajudar a liberar parte da renda mensal.
          </p>
          <ul>
            <li>Parcelas mensais menores.</li>
            <li>Mais espaço no orçamento.</li>
            <li>Manutenção do prazo restante.</li>
          </ul>
        </article>
      </div>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Como funciona o cálculo?</h2>
      </div>

      <p>
        A simulação utiliza o saldo devedor, o prazo restante, a taxa de juros
        anual e o valor extra que será destinado à amortização. Com essas
        informações, o motor de cálculo estima o efeito financeiro da
        antecipação conforme a modalidade escolhida.
      </p>

      <div class="formula-card">
        <h3>Dados utilizados na simulação</h3>
        <div class="formula">
          Saldo devedor + Prazo restante + Taxa de juros + Amortização extra
        </div>
        <p>
          Os resultados dependem das regras matemáticas implementadas no
          simulador e não substituem o demonstrativo oficial do banco.
        </p>
      </div>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Posso utilizar o FGTS para amortizar?</h2>
      </div>

      <p>
        Em determinadas modalidades de financiamento habitacional, o FGTS
        pode ser utilizado para amortizar o saldo devedor, reduzir o valor
        das prestações ou quitar o contrato, desde que sejam atendidos os
        requisitos legais e as regras vigentes.
      </p>

      <p>
        Antes de solicitar a operação, consulte a instituição financeira
        responsável pelo contrato para verificar as condições de utilização
        do fundo.
      </p>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Quando vale a pena amortizar?</h2>
      </div>

      <p>
        A decisão depende da taxa de juros do financiamento, do dinheiro
        disponível, da sua reserva de emergência e de outras prioridades
        financeiras. Compare a economia estimada com o rendimento que esse
        mesmo dinheiro poderia gerar em outra aplicação.
      </p>
    </section>

    <!-- FAQ -->
    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">DÚVIDAS FREQUENTES</span>
        <h2>Perguntas sobre amortização e quitação</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>Amortizar reduz o valor total do financiamento?</summary>
          <p>
            A amortização reduz o saldo devedor. Como consequência, pode diminuir
            os juros futuros e o custo total da dívida. O resultado depende das
            condições do contrato e da forma escolhida para amortizar.
          </p>
        </details>

        <details class="faq-item">
          <summary>É melhor reduzir o prazo ou o valor da parcela?</summary>
          <p>
            Reduzir o prazo pode gerar uma economia maior de juros, enquanto
            reduzir a prestação pode aliviar o orçamento mensal. A melhor opção
            depende dos seus objetivos e da situação financeira atual.
          </p>
        </details>

        <details class="faq-item">
          <summary>Posso amortizar meu financiamento mais de uma vez?</summary>
          <p>
            Em geral, é possível realizar amortizações adicionais conforme as
            regras do contrato e da instituição financeira. Consulte o banco
            para conhecer os procedimentos, valores mínimos e eventuais
            condições aplicáveis.
          </p>
        </details>

        <details class="faq-item">
          <summary>A calculadora informa o valor exato da economia?</summary>
          <p>
            Não. O resultado é uma estimativa baseada nos dados informados.
            O cálculo oficial pode considerar seguros, tarifas, indexadores,
            atualização monetária e regras específicas do contrato.
          </p>
        </details>

        <details class="faq-item">
          <summary>Posso usar esta ferramenta para financiamento imobiliário?</summary>
          <p>
            Sim, ela pode ser utilizada para fazer uma simulação inicial de
            amortização imobiliária. Entretanto, sistemas como SAC e Price,
            correções do saldo devedor e encargos adicionais podem produzir
            resultados diferentes dos apresentados.
          </p>
        </details>
      </div>
    </section>

    <aside class="disclaimer final-note" style="margin-top: 3rem;">
      <div class="notice-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        </svg>
        <strong>Calculadora de Ganhos</strong>
      </div>
      <p>
        Utilize nossas ferramentas para simular cenários, organizar seu
        planejamento financeiro e tomar decisões mais conscientes.
      </p>
      <a href="/financas/">Explorar outras ferramentas financeiras →</a>
    </aside>
  </main>

  <script>
    import { calculateEarlyPayoff } from '../../engines/finance/early-payoff-engine';
    import { formatBRL } from '../../engines/common/currency';

    const form = document.getElementById('amortization-form') as HTMLFormElement;
    const balanceInput = document.getElementById('balance') as HTMLInputElement;
    const monthsInput = document.getElementById('months') as HTMLInputElement;
    const rateInput = document.getElementById('interest-rate') as HTMLInputElement;
    const amortInput = document.getElementById('amort-amount') as HTMLInputElement;
    const typeInput = document.getElementById('amort-type') as HTMLSelectElement;

    const errorElement = document.getElementById('form-error') as HTMLDivElement;
    const savedElement = document.getElementById('res-saved')!;
    const monthsElement = document.getElementById('res-months')!;
    const paymentElement = document.getElementById('res-payment')!;
    const amortElement = document.getElementById('res-amort')!;
    const balanceElement = document.getElementById('res-balance')!;
    const prazoElement = document.getElementById('result-detail-prazo') as HTMLDivElement;
    const prestacaoElement = document.getElementById('result-detail-prestacao') as HTMLDivElement;
    const messageElement = document.getElementById('result-message')!;

    function showError(message: string) {
      errorElement.textContent = message;
      errorElement.hidden = false;
    }

    function clearError() {
      errorElement.textContent = '';
      errorElement.hidden = true;
    }

    function runCalc() {
      clearError();

      const balance = Number(balanceInput.value);
      const months = Number(monthsInput.value);
      const interestRate = Number(rateInput.value);
      const amortAmount = Number(amortInput.value);
      const amortType = typeInput.value as 'prazo' | 'prestacao';

      if (!Number.isFinite(balance) || balance <= 0) {
        showError('Informe um saldo devedor maior que zero.');
        return;
      }

      if (!Number.isInteger(months) || months < 1 || months > 600) {
        showError('Informe um prazo entre 1 e 600 meses.');
        return;
      }

      if (!Number.isFinite(interestRate) || interestRate < 0 || interestRate > 100) {
        showError('Informe uma taxa anual entre 0% e 100%.');
        return;
      }

      if (!Number.isFinite(amortAmount) || amortAmount <= 0) {
        showError('Informe um valor de amortização maior que zero.');
        return;
      }

      if (amortAmount > balance) {
        showError('O valor de amortização não pode ser maior que o saldo devedor.');
        return;
      }

      try {
        const result = calculateEarlyPayoff({
          currentBalance: balance,
          remainingMonths: months,
          annualInterestRate: interestRate,
          amortizationAmount: amortAmount,
          amortizationType: amortType,
        });

        if (
          !Number.isFinite(result.interestSaved) ||
          result.interestSaved < 0
        ) {
          throw new Error('Não foi possível calcular uma economia válida.');
        }

        savedElement.textContent = formatBRL(result.interestSaved);
        amortElement.textContent = formatBRL(amortAmount);
        balanceElement.textContent = formatBRL(balance);

        if (amortType === 'prazo') {
          if (
            !Number.isFinite(result.monthsReduced) ||
            result.monthsReduced < 0
          ) {
            throw new Error('O resultado da redução do prazo é inválido.');
          }

          prazoElement.hidden = false;
          prestacaoElement.hidden = true;

          monthsElement.textContent =
            `${result.monthsReduced} meses (~${(result.monthsReduced / 12).toFixed(1)} anos)`;

          messageElement.textContent =
            'Simulação realizada com foco na redução do prazo do financiamento.';
        } else {
          if (
            !Number.isFinite(result.newMonthlyPaymentEstimate) ||
            result.newMonthlyPaymentEstimate < 0
          ) {
            throw new Error('O resultado da nova prestação é inválido.');
          }

          prazoElement.hidden = true;
          prestacaoElement.hidden = false;

          paymentElement.textContent = formatBRL(result.newMonthlyPaymentEstimate);

          messageElement.textContent =
            'Simulação realizada com foco na redução do valor da prestação mensal.';
        }
      } catch (error) {
        console.error('Erro ao calcular amortização:', error);
        showError(
          error instanceof Error
            ? error.message
            : 'Não foi possível realizar a simulação. Verifique os dados informados.'
        );
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      runCalc();
    });

    document.getElementById('reset-btn')?.addEventListener('click', () => {
      balanceInput.value = '250000';
      monthsInput.value = '240';
      rateInput.value = '9.5';
      amortInput.value = '30000';
      typeInput.value = 'prazo';

      runCalc();
    });

    runCalc();
  </script>

  <style>
    .page-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0.5rem 0 4rem;
      color: var(--text-primary);
    }

    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 1.75rem;
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .breadcrumb a,
    .back-link a {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover,
    .back-link a:hover {
      color: var(--color-primary);
    }

    .page-header {
      max-width: 790px;
      margin-bottom: 3rem;
    }

    .eyebrow,
    .section-kicker,
    .section-label {
      display: inline-block;
      margin-bottom: 0.75rem;
      color: var(--color-primary);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.1em;
    }

    .page-header h1 {
      margin: 0 0 0.9rem;
      color: var(--text-primary);
      font-size: clamp(2rem, 5vw, 2.7rem);
      line-height: 1.2;
    }

    .page-header > p {
      max-width: 790px;
      margin: 0;
      color: var(--text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .icon-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(6, 95, 70, 0.1);
      color: var(--color-primary);
      flex-shrink: 0;
    }

    :global([data-theme="dark"]) .icon-badge {
      background: rgba(16, 185, 129, 0.14);
    }

    .calculator-section {
      margin-bottom: 3.5rem;
      scroll-margin-top: 2rem;
    }

    .section-heading {
      margin-bottom: 1.5rem;
    }

    .section-heading h2 {
      margin: 0 0 0.6rem;
      font-size: 1.65rem;
      line-height: 1.3;
    }

    .section-heading > p {
      max-width: 760px;
      margin: 0;
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.75;
    }

    .calculator-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      align-items: stretch;
    }

    .card {
      min-width: 0;
      padding: 1.65rem;
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: var(--bg-secondary);
    }

    .card-heading {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1.4rem;
    }

    .card-heading h3 {
      margin: 0;
      font-size: 1.2rem;
    }

    .card-heading p {
      margin: 0.2rem 0 0;
      color: var(--text-secondary);
      font-size: 0.82rem;
    }

    .input-card .card-heading h3 {
      color: var(--color-primary);
    }

    .field-group {
      margin-bottom: 1.25rem;
    }

    .field-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
      font-weight: 650;
      line-height: 1.5;
    }

    .input-wrapper {
      display: flex;
      align-items: center;
      border: 1px solid var(--border-color);
      border-radius: 9px;
      background: var(--bg-primary);
      overflow: hidden;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-wrapper:focus-within {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(6, 95, 70, 0.12);
    }

    :global([data-theme="dark"]) .input-wrapper:focus-within {
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.16);
    }

    .input-wrapper input {
      width: 100%;
      min-width: 0;
      min-height: 46px;
      padding: 0.75rem 0.9rem;
      border: none;
      outline: none;
      background: transparent;
      color: var(--text-primary);
      font: inherit;
      box-sizing: border-box;
    }

    .input-prefix,
    .input-suffix {
      padding: 0 0.85rem;
      color: var(--text-secondary);
      font-size: 0.85rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .input-prefix {
      border-right: 1px solid var(--border-color);
    }

    .input-suffix {
      border-left: 1px solid var(--border-color);
    }

    .field-group select {
      width: 100%;
      min-height: 46px;
      padding: 0.75rem 0.9rem;
      border: 1px solid var(--border-color);
      border-radius: 9px;
