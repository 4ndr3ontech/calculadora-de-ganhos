---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Simulador de Quitação de Cartão de Crédito — Calculadora de Ganhos"
  description="Simule a quitação da dívida do cartão de crédito. Descubra quanto pagará de juros, o tempo necessário para quitar e o custo total da dívida."
>
  <main class="page-container">
    <nav class="breadcrumb" aria-label="Navegação">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/financas/">Finanças</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Quitação de Cartão</span>
    </nav>

    <header class="page-header">
      <span class="eyebrow">PLANEJAMENTO FINANCEIRO</span>
      <h1>Simulador de Quitação de Cartão de Crédito</h1>
      <p>
        Descubra quanto tempo será necessário para quitar sua dívida,
        quanto poderá pagar em juros e como o valor da parcela mensal
        influencia o custo total do cartão de crédito.
      </p>
    </header>

    <section class="calculator-section" aria-label="Simulador de quitação">
      <div class="calculator-grid">
        <!-- Dados da dívida -->
        <div class="card input-card">
          <div class="card-heading">
            <div class="icon-badge" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>
              </svg>
            </div>
            <div>
              <h3>Dados da dívida</h3>
              <p>Informe os valores do seu cartão de crédito.</p>
            </div>
          </div>

          <form id="credit-card-form">
            <div class="field-group">
              <label for="total-debt">Valor total da dívida</label>
              <div class="input-wrapper">
                <span class="input-prefix">R$</span>
                <input
                  type="number"
                  id="total-debt"
                  value="5000"
                  min="0.01"
                  step="0.01"
                  required
                />
              </div>
              <small>
                Informe o saldo devedor atual do cartão, incluindo os valores
                que já estão em atraso, se aplicável.
              </small>
            </div>

            <div class="field-group">
              <label for="monthly-interest">Taxa de juros mensal</label>
              <div class="input-wrapper">
                <input
                  type="number"
                  id="monthly-interest"
                  value="14"
                  min="0"
                  max="100"
                  step="0.01"
                  required
                />
                <span class="input-suffix">% a.m.</span>
              </div>
              <small>
                Utilize a taxa mensal informada na fatura ou na proposta
                de renegociação.
              </small>
            </div>

            <div class="field-group">
              <label for="monthly-payment">Pagamento fixo mensal</label>
              <div class="input-wrapper">
                <span class="input-prefix">R$</span>
                <input
                  type="number"
                  id="monthly-payment"
                  value="1000"
                  min="0.01"
                  step="0.01"
                  required
                />
              </div>
              <small>
                Valor que você pretende pagar mensalmente para reduzir
                e quitar a dívida.
              </small>
            </div>

            <div id="form-error" class="error-message" role="alert" hidden></div>

            <button type="submit" class="btn-calculate">
              <span>Simular quitação</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </button>

            <button type="button" id="reset-btn" class="btn-reset">
              Restaurar valores iniciais
            </button>
          </form>
        </div>

        <!-- Resultados -->
        <div class="card result-card" aria-live="polite">
          <div>
            <div class="card-heading">
              <div class="icon-badge result-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/>
                </svg>
              </div>
              <div>
                <h3>Projeção de pagamento</h3>
                <p>Veja o resultado estimado da sua dívida.</p>
              </div>
            </div>

            <div class="main-result time-panel">
              <span class="result-label">Tempo estimado para quitação</span>
              <strong id="res-time">0 meses</strong>
              <span class="savings-caption">
                Prazo estimado considerando o pagamento informado.
              </span>
            </div>

            <div class="result-breakdown">
              <div class="result-row">
                <div>
                  <span class="result-dot interest-dot"></span>
                  <div>
                    <strong>Total de juros pagos</strong>
                    <span>Custo financeiro estimado</span>
                  </div>
                </div>
                <strong id="res-interest" class="interest-value">R$ 0,00</strong>
              </div>

              <div class="result-row">
                <div>
                  <span class="result-dot invested-dot"></span>
                  <div>
                    <strong>Custo total da dívida</strong>
                    <span>Saldo devedor mais juros</span>
                  </div>
                </div>
                <strong id="res-total">R$ 0,00</strong>
              </div>

              <div class="result-row">
                <div>
                  <span class="result-dot"></span>
                  <div>
                    <strong>Valor original da dívida</strong>
                    <span>Saldo informado na simulação</span>
                  </div>
                </div>
                <strong id="res-debt">R$ 0,00</strong>
              </div>

              <div class="result-row">
                <div>
                  <span class="result-dot"></span>
                  <div>
                    <strong>Pagamento mensal</strong>
                    <span>Valor informado pelo usuário</span>
                  </div>
                </div>
                <strong id="res-payment">R$ 0,00</strong>
              </div>
            </div>

            <div class="result-insight">
              <span class="insight-icon" aria-hidden="true">💡</span>
              <p id="result-message">
                Informe os dados da dívida e clique em simular para visualizar
                a projeção.
              </p>
            </div>
          </div>

          <p class="result-disclaimer">
            <strong>Atenção:</strong>
            esta simulação é uma projeção matemática simplificada.
            O resultado real pode variar conforme encargos, impostos,
            tarifas, pagamentos adicionais e condições de renegociação.
          </p>
        </div>
      </div>
    </section>

    <!-- Conteúdo educativo -->
    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">ENTENDA SUA DÍVIDA</span>
        <h2>Como funciona a quitação do cartão de crédito?</h2>
      </div>

      <p>
        Quando uma fatura não é paga integralmente, o saldo restante pode
        gerar encargos financeiros. Dependendo das condições contratadas,
        essa dívida pode entrar no crédito rotativo ou ser direcionada
        para outra modalidade de financiamento.
      </p>

      <p>
        O problema é que os juros podem aumentar significativamente o valor
        devido ao longo do tempo. Por isso, entender o custo da dívida e
        estabelecer um plano de pagamento é uma etapa importante para
        recuperar o equilíbrio financeiro.
      </p>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>O que é o crédito rotativo?</h2>
      </div>

      <p>
        O crédito rotativo é uma modalidade de financiamento associada
        ao saldo não pago da fatura do cartão de crédito. Quando o consumidor
        paga apenas parte da fatura, o valor restante pode ficar sujeito
        aos encargos dessa modalidade, conforme as regras aplicáveis.
      </p>

      <p>
        A permanência no rotativo é limitada pelas regras do Banco Central.
        Após o período permitido, o saldo precisa ser liquidado ou transferido
        para outra modalidade de crédito, conforme as condições oferecidas.
      </p>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Como o valor do pagamento mensal influencia a dívida?</h2>
      </div>

      <div class="info-grid comparison-grid">
        <article class="info-card">
          <div class="step-number" aria-hidden="true">⚠</div>
          <h3>Pagamento muito baixo</h3>
          <p>
            Quando o pagamento mensal é insuficiente para cobrir os juros
            gerados, a dívida pode crescer em vez de diminuir.
          </p>
          <ul>
            <li>Maior custo financeiro.</li>
            <li>Dificuldade de reduzir o saldo.</li>
            <li>Risco de prolongar o endividamento.</li>
          </ul>
        </article>

        <article class="info-card">
          <div class="step-number" aria-hidden="true">✓</div>
          <h3>Pagamento planejado</h3>
          <p>
            Um pagamento compatível com a dívida e os encargos permite
            reduzir o saldo devedor progressivamente.
          </p>
          <ul>
            <li>Maior controle do orçamento.</li>
            <li>Redução progressiva da dívida.</li>
            <li>Planejamento do prazo de quitação.</li>
          </ul>
        </article>
      </div>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Como a calculadora realiza a simulação?</h2>
      </div>

      <p>
        O simulador considera três informações principais: o saldo devedor,
        a taxa de juros mensal e o valor que você pretende pagar a cada mês.
        Com esses dados, o motor de cálculo projeta o prazo necessário
        para quitar a dívida e estima os juros acumulados.
      </p>

      <div class="formula-card">
        <h3>Informações utilizadas</h3>
        <div class="formula">
          Dívida atual + Taxa mensal de juros + Pagamento mensal
        </div>
        <p>
          A projeção considera os parâmetros informados e as regras
          matemáticas implementadas no simulador. Ela não substitui
          o demonstrativo oficial da administradora do cartão.
        </p>
      </div>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>O que fazer quando a dívida não diminui?</h2>
      </div>

      <p>
        Se o valor disponível mensalmente não consegue cobrir os encargos,
        pode ser necessário rever a estratégia de pagamento. Algumas
        alternativas incluem negociar diretamente com a instituição
        financeira, solicitar uma proposta de parcelamento ou comparar
        outras modalidades de crédito com custo efetivo total menor.
      </p>

      <p>
        Antes de aceitar uma renegociação, compare o CET (Custo Efetivo Total),
        o número de parcelas, o valor de cada prestação e o montante final
        que será pago.
      </p>

      <div class="section-heading" style="margin-top: 2.5rem;">
        <h2>Como evitar novas dívidas no cartão?</h2>
      </div>

      <p>
        Acompanhe os gastos durante o mês, estabeleça um limite de despesas
        compatível com sua renda e evite utilizar o cartão como extensão
        do salário. Sempre que possível, mantenha uma reserva financeira
        para despesas inesperadas.
      </p>
    </section>

    <!-- FAQ -->
    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">DÚVIDAS FREQUENTES</span>
        <h2>Perguntas sobre a quitação do cartão</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>O que acontece quando pago apenas o mínimo da fatura?</summary>
          <p>
            O valor não pago pode ser financiado e gerar encargos financeiros.
            Isso aumenta o custo da dívida e pode dificultar sua quitação.
            Consulte as condições apresentadas na sua fatura.
          </p>
        </details>

        <details class="faq-item">
          <summary>Como saber se meu pagamento mensal é suficiente?</summary>
          <p>
            O pagamento precisa ser suficiente para cobrir os encargos
            considerados na simulação e também reduzir o saldo devedor.
            Se o valor for insuficiente, a ferramenta poderá indicar
            que a quitação não é viável.
          </p>
        </details>

        <details class="faq-item">
          <summary>É melhor parcelar a fatura ou pagar o rotativo?</summary>
          <p>
            Não existe uma resposta única. Compare o Custo Efetivo Total,
            os juros, as tarifas e o valor final de cada proposta. Uma
            alternativa com taxa nominal menor nem sempre representa
            o menor custo total.
          </p>
        </details>

        <details class="faq-item">
          <summary>Posso negociar a dívida diretamente com o banco?</summary>
          <p>
            Sim. Você pode entrar em contato com a instituição responsável
            pelo cartão e solicitar opções de renegociação. Antes de aceitar,
            verifique o valor total, as parcelas e as condições do acordo.
          </p>
        </details>

        <details class="faq-item">
          <summary>A calculadora mostra exatamente quanto vou pagar?</summary>
          <p>
            Não. O resultado é uma estimativa matemática baseada nos dados
            informados. Encargos adicionais, regras do cartão, mudanças
            nas taxas e condições de negociação podem alterar o valor real.
          </p>
        </details>

        <details class="faq-item">
          <summary>O que é o limite de juros do cartão de crédito?</summary>
          <p>
            Para operações de crédito rotativo e parcelamento da fatura
            abrangidas pela regra vigente desde janeiro de 2024, os juros
            e encargos financeiros não podem ultrapassar o valor original
            da dívida. Existem condições específicas para aplicação dessa
            regra, portanto é importante conferir a modalidade da operação.
          </p>
        </details>
      </div>
    </section>

    <aside class="disclaimer final-note" style="margin-top: 3rem;">
      <div class="notice-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        </svg>
        <strong>Calculadora de Ganhos</strong>
      </div>
      <p>
        Utilize nossas ferramentas para simular cenários, organizar
        seu orçamento e tomar decisões financeiras mais conscientes.
      </p>
      <a href="/financas/">Explorar outras ferramentas financeiras →</a>
    </aside>
  </main>

  <script>
    import { calculateCreditCardPayoff } from '../../engines/finance/personal-finance-engine';
    import { formatBRL } from '../../engines/common/currency';

    const form = document.getElementById('credit-card-form') as HTMLFormElement;

    const debtInput = document.getElementById('total-debt') as HTMLInputElement;
    const rateInput = document.getElementById('monthly-interest') as HTMLInputElement;
    const paymentInput = document.getElementById('monthly-payment') as HTMLInputElement;

    const errorElement = document.getElementById('form-error') as HTMLDivElement;

    const timeElement = document.getElementById('res-time')!;
    const interestElement = document.getElementById('res-interest')!;
    const totalElement = document.getElementById('res-total')!;
    const debtElement = document.getElementById('res-debt')!;
    const monthlyPaymentElement = document.getElementById('res-payment')!;
    const messageElement = document.getElementById('result-message')!;

    function showError(message: string) {
      errorElement.textContent = message;
      errorElement.hidden = false;
    }

    function clearError() {
      errorElement.textContent = '';
      errorElement.hidden = true;
    }

    function runCalc() {
      clearError();

      const debt = Number(debtInput.value);
      const rate = Number(rateInput.value);
      const payment = Number(paymentInput.value);

      if (!Number.isFinite(debt) || debt <= 0) {
        showError('Informe uma dívida maior que zero.');
        return;
      }

      if (!Number.isFinite(rate) || rate < 0 || rate > 100) {
        showError('Informe uma taxa mensal entre 0% e 100%.');
        return;
      }

      if (!Number.isFinite(payment) || payment <= 0) {
        showError('Informe um pagamento mensal maior que zero.');
        return;
      }

      try {
        const result = calculateCreditCardPayoff({
          totalDebt: debt,
          monthlyInterestRate: rate,
          monthlyPayment: payment,
        });

        debtElement.textContent = formatBRL(debt);
        monthlyPaymentElement.textContent = formatBRL(payment);

        if (!result.isViable) {
          timeElement.textContent = 'Não é viável';
          interestElement.textContent = '—';
          totalElement.textContent = '—';

          messageElement.textContent =
            'O pagamento informado não é suficiente para quitar a dívida nas condições simuladas. Considere aumentar o valor mensal ou negociar uma taxa menor.';

          return;
        }

        if (
          !Number.isFinite(result.monthsToPayoff) ||
          result.monthsToPayoff < 0 ||
          !Number.isFinite(result.totalInterestPaid) ||
          result.totalInterestPaid < 0 ||
          !Number.isFinite(result.totalAmountPaid) ||
          result.totalAmountPaid < 0
        ) {
          throw new Error('O motor retornou valores inválidos para a simulação.');
        }

        timeElement.textContent =
          `${result.monthsToPayoff} meses (~${(result.monthsToPayoff / 12).toFixed(1)} anos)`;

        interestElement.textContent = formatBRL(result.totalInterestPaid);
        totalElement.textContent = formatBRL(result.totalAmountPaid);

        messageElement.textContent =
          'Simulação concluída. Os valores representam uma estimativa do pagamento da dívida com a taxa e a parcela informadas.';
      } catch (error) {
        console.error('Erro na simulação de quitação:', error);

        showError(
          error instanceof Error
            ? error.message
            : 'Não foi possível realizar a simulação. Verifique os valores informados.'
        );
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      runCalc();
    });

    document.getElementById('reset-btn')?.addEventListener('click', () => {
      debtInput.value = '5000';
      rateInput.value = '14';
      paymentInput.value = '1000';

      runCalc();
    });

    runCalc();
  </script>

  <style>
    .page-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0.5rem 0 4rem;
      color: var(--text-primary);
    }

    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 1.75rem;
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .breadcrumb a,
    .back-link a {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover,
    .back-link a:hover {
      color: var(--color-primary);
    }

    .page-header {
      max-width: 790px;
      margin-bottom: 3rem;
    }

    .eyebrow,
    .section-kicker,
    .section-label {
      display: inline-block;
      margin-bottom: 0.75rem;
      color: var(--color-primary);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.1em;
    }

    .page-header h1 {
      margin: 0 0 0.9rem;
      color: var(--text-primary);
      font-size: clamp(2rem, 5vw, 2.7rem);
      line-height: 1.2;
    }

    .page-header > p {
      max-width: 790px;
      margin: 0;
      color: var(--text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .icon-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(6, 95, 70, 0.1);
      color: var(--color-primary);
      flex-shrink: 0;
    }

    :global([data-theme="dark"]) .icon-badge {
      background: rgba(16, 185, 129, 0.14);
    }

    .calculator-section {
      margin-bottom: 3.5rem;
      scroll-margin-top: 2rem;
    }

    .section-heading {
      margin-bottom: 1.5rem;
    }

    .section-heading h2 {
      margin: 0 0 0.6rem;
      font-size: 1.65rem;
      line-height: 1.3;
    }

    .section-heading > p {
      max-width: 760px;
      margin: 0;
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.75;
    }

    .calculator-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      align-items: stretch;
    }

    .card {
      min-width: 0;
      padding: 1.65rem;
      border: 1px solid var(--border-color);
      border-radius: 16px;
      background: var(--bg-secondary);
    }

    .card-heading {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1.4rem;
    }

    .card-heading h3 {
      margin: 0;
      font-size: 1.2rem;
    }

    .card-heading p {
      margin: 0.2rem 0 0;
      color: var(--text-secondary);
      font-size: 0.82rem;
    }

    .input-card .card-heading h3 {
      color: var(--color-primary);
    }

    .field-group {
      margin-bottom: 1.25rem;
    }

    .field-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
      font-weight: 650;
      line-height: 1.5;
    }

    .input-wrapper {
      display: flex;
      align-items: center;
      border: 1px solid var(--border-color);
      border-radius: 9px;
      background: var(--bg-primary);
      overflow: hidden;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-wrapper:focus-within {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(6, 95, 70, 0.12);
    }

    :global([data-theme="dark"]) .input-wrapper:focus-within {
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.16);
    }

    .input-wrapper input {
      width: 100%;
      min-width: 0;
      min-height: 46px;
      padding: 0.75rem 0.9rem;
      border: none;
      outline: none;
      background: transparent;
      color: var(--text-primary);
      font: inherit;
      box-sizing: border-box;
    }

    .input-prefix,
    .input-suffix {
      padding: 0 0.85rem;
      color: var(--text-secondary);
      font-size: 0.85rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .input-prefix {
      border-right: 1px solid var(--border-color);
    }

    .input-suffix {
      border-left: 1px solid var(--border-color);
    }

    .field-group small {
      display: block;
      margin-top: 0.45rem;
      color: var(--text-secondary);
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .btn-calculate {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      width: 100%;
      min-height: 48px;
      padding: 0.85rem 1.1rem;
      border: 0;
      border-radius: 9px;
      background: var(--color-primary);
      color: #ffffff;
      font: inherit;
      font-size: 0.95rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    .btn-calculate:hover {
      opacity: 0.88;
    }

