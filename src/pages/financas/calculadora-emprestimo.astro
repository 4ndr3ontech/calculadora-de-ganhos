  <!-- SCRIPT DA CALCULADORA -->
  <script>
    import { calculateLoanPrice } from '../../engines/finance/loan';
    import { formatBRL } from '../../engines/common/currency';

    let pageController: AbortController | null = null;

    function initPage() {
      // Evita duplicação de eventos após navegação interna do Astro.
      pageController?.abort();
      pageController = new AbortController();

      const { signal } = pageController;

      const principalInput = document.getElementById('principal') as HTMLInputElement | null;
      const rateInput = document.getElementById('rate') as HTMLInputElement | null;
      const monthsInput = document.getElementById('months') as HTMLInputElement | null;

      const calcButton = document.getElementById('calc-btn');
      const errorElement = document.getElementById('calc-error');

      const monthlyOutput = document.getElementById('res-monthly');
      const interestOutput = document.getElementById('res-interest');
      const totalOutput = document.getElementById('res-total');
      const principalOutput = document.getElementById('res-principal');

      if (
        !principalInput ||
        !rateInput ||
        !monthsInput ||
        !calcButton ||
        !errorElement ||
        !monthlyOutput ||
        !interestOutput ||
        !totalOutput ||
        !principalOutput
      ) {
        return;
      }

      function resetResults() {
        monthlyOutput.textContent = '—';
        interestOutput.textContent = '—';
        totalOutput.textContent = '—';
        principalOutput.textContent = '—';
      }

      function showError(message: string) {
        errorElement.textContent = message;
        errorElement.hidden = false;
        resetResults();
      }

      function clearError() {
        errorElement.textContent = '';
        errorElement.hidden = true;
      }

      function runCalc() {
        clearError();

        const rawPrincipal = principalInput.value.trim();
        const rawRate = rateInput.value.trim();
        const rawMonths = monthsInput.value.trim();

        // Number('') retorna zero. Por isso, os campos vazios são
        // verificados antes da conversão numérica.
        if (!rawPrincipal || !rawRate || !rawMonths) {
          showError('Preencha todos os campos para realizar a simulação.');
          return;
        }

        const principal = Number(rawPrincipal);
        const rate = Number(rawRate);
        const months = Number(rawMonths);

        if (!Number.isFinite(principal) || principal <= 0) {
          showError('Informe um valor de empréstimo maior que zero.');
          return;
        }

        if (!Number.isFinite(rate) || rate < 0) {
          showError('Informe uma taxa de juros anual válida. Ela não pode ser negativa.');
          return;
        }

        if (!Number.isInteger(months) || months <= 0) {
          showError('Informe um prazo válido em meses, utilizando um número inteiro maior que zero.');
          return;
        }

        try {
          const result = calculateLoanPrice({
            principal,
            annualInterestRate: rate,
            months,
          });

          const monthlyPayment = Number(result.monthlyPayment);
          const totalInterest = Number(result.totalInterest);
          const totalPayment = Number(result.totalPayment);

          const values = [
            monthlyPayment,
            totalInterest,
            totalPayment,
          ];

          if (!values.every(value => Number.isFinite(value) && value >= 0)) {
            throw new Error('O motor retornou valores financeiros inválidos.');
          }

          if (monthlyPayment <= 0 || totalPayment <= 0) {
            throw new Error('O motor retornou um resultado sem valor positivo.');
          }

          // Verificação de coerência: o total pago não deve ser inferior
          // ao principal em uma simulação com juros não negativos.
          if (totalPayment + 0.01 < principal) {
            throw new Error('O total calculado ficou abaixo do valor solicitado.');
          }

          monthlyOutput.textContent = formatBRL(monthlyPayment);
          interestOutput.textContent = formatBRL(totalInterest);
          totalOutput.textContent = formatBRL(totalPayment);
          principalOutput.textContent = formatBRL(principal);
        } catch {
          showError(
            'Não foi possível realizar a simulação. Confira os valores informados e tente novamente.'
          );
        }
      }

      calcButton.addEventListener('click', runCalc, { signal });

      [principalInput, rateInput, monthsInput].forEach(input => {
        input.addEventListener('input', runCalc, { signal });
        input.addEventListener('change', runCalc, { signal });
      });

      runCalc();
    }

    // Inicialização inicial.
    initPage();

    // Reaplica os eventos após navegações com View Transitions do Astro.
    document.addEventListener('astro:page-load', initPage);
  </script>

