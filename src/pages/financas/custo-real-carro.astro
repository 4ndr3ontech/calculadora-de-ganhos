  <script>
    import { calculateVehicleTCO } from '../../engines/finance/vehicle-engine';
    import { formatBRL } from '../../engines/common/currency';

    let pageController: AbortController | null = null;

    function initPage() {
      // Evita listeners duplicados durante a navegação do Astro.
      pageController?.abort();
      pageController = new AbortController();

      const { signal } = pageController;

      const priceInput = document.getElementById('v-price') as HTMLInputElement | null;
      const fuelInput = document.getElementById('v-fuel') as HTMLInputElement | null;
      const insuranceInput = document.getElementById('v-insurance') as HTMLInputElement | null;
      const maintenanceInput = document.getElementById('v-maint') as HTMLInputElement | null;
      const ipvaInput = document.getElementById('v-ipva') as HTMLInputElement | null;
      const depreciationInput = document.getElementById('v-dep') as HTMLInputElement | null;

      const errorElement = document.getElementById('calc-error');
      const calculateButton = document.getElementById('calc-btn');

      const monthlyOutput = document.getElementById('res-monthly');
      const annualOutput = document.getElementById('res-annual');
      const deprOutput = document.getElementById('res-depr');

      if (
        !priceInput ||
        !fuelInput ||
        !insuranceInput ||
        !maintenanceInput ||
        !ipvaInput ||
        !depreciationInput ||
        !errorElement ||
        !calculateButton ||
        !monthlyOutput ||
        !annualOutput ||
        !deprOutput
      ) {
        return;
      }

      const fields = {
        price: priceInput,
        fuel: fuelInput,
        insurance: insuranceInput,
        maintenance: maintenanceInput,
        ipva: ipvaInput,
        depreciation: depreciationInput,
      };

      function readNumber(input: HTMLInputElement): number | null {
        const value = input.value.trim();

        if (value === '') {
          return null;
        }

        const number = Number(value);

        if (!Number.isFinite(number)) {
          return null;
        }

        return number;
      }

      function getInputValues() {
        return {
          price: readNumber(fields.price),
          fuel: readNumber(fields.fuel),
          insurance: readNumber(fields.insurance),
          maintenance: readNumber(fields.maintenance),
          ipva: readNumber(fields.ipva),
          depreciation: readNumber(fields.depreciation),
        };
      }

      function validateInputs(values: ReturnType<typeof getInputValues>): string | null {
        const definitions = [
          {
            value: values.price,
            label: 'valor de mercado do veículo',
            min: 0,
            max: 100000000,
          },
          {
            value: values.fuel,
            label: 'combustível mensal',
            min: 0,
            max: 1000000,
          },
          {
            value: values.insurance,
            label: 'seguro mensal',
            min: 0,
            max: 1000000,
          },
          {
            value: values.maintenance,
            label: 'manutenção mensal',
            min: 0,
            max: 1000000,
          },
          {
            value: values.ipva,
            label: 'alíquota do IPVA',
            min: 0,
            max: 100,
          },
          {
            value: values.depreciation,
            label: 'percentual de desvalorização',
            min: 0,
            max: 100,
          },
        ];

        for (const field of definitions) {
          if (field.value === null) {
            return `Informe um valor válido para ${field.label}.`;
          }

          if (field.value < field.min || field.value > field.max) {
            return `O campo "${field.label}" deve estar entre ${field.min} e ${field.max}.`;
          }
        }

        return null;
      }

      function showError(message: string) {
        errorElement.textContent = message;
        errorElement.hidden = false;

        monthlyOutput.textContent = '—';
        annualOutput.textContent = '—';
        deprOutput.textContent = '—';
      }

      function clearError() {
        errorElement.textContent = '';
        errorElement.hidden = true;
      }

      function runCalc() {
        const values = getInputValues();
        const validationError = validateInputs(values);

        if (validationError) {
          showError(validationError);
          return;
        }

        clearError();

        try {
          // Após a validação, os valores não podem ser nulos.
          const result = calculateVehicleTCO({
            vehiclePrice: values.price!,
            monthlyFuelCost: values.fuel!,
            monthlyInsurance: values.insurance!,
            annualIpvaRate: values.ipva!,
            monthlyMaintenance: values.maintenance!,
            annualDepreciationRate: values.depreciation!,
          });

          const resultValues = [
            result.totalMonthlyCost,
            result.costPerYear,
            result.annualDepreciationValue,
          ];

          const hasInvalidResult = resultValues.some(
            (value) => !Number.isFinite(value) || value < 0
          );

          if (hasInvalidResult) {
            throw new Error('O motor retornou valores inválidos.');
          }

          monthlyOutput.textContent = formatBRL(result.totalMonthlyCost);
          annualOutput.textContent = formatBRL(result.costPerYear);
          deprOutput.textContent = formatBRL(result.annualDepreciationValue);
        } catch (error) {
          console.error('Erro ao calcular o custo real do veículo:', error);

          showError(
            'Não foi possível realizar o cálculo. Verifique os valores informados e tente novamente.'
          );
        }
      }

      calculateButton.addEventListener('click', runCalc, { signal });

      Object.values(fields).forEach((input) => {
        input.addEventListener('input', runCalc, { signal });
        input.addEventListener('change', runCalc, { signal });
      });

      // Calcula automaticamente com os valores iniciais.
      runCalc();
    }

    initPage();

    // Reexecuta a inicialização após navegações feitas pelo Astro.
    document.addEventListener('astro:page-load', initPage);
  </script>

