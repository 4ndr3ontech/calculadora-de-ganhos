  <script>
    import { calculateBuyVsRent } from '../../engines/finance/buy-vs-rent-engine';
    import { formatBRL } from '../../engines/common/currency';

    let pageController: AbortController | null = null;

    function initPage() {
      // Evita listeners duplicados após navegações internas do Astro.
      pageController?.abort();
      pageController = new AbortController();

      const { signal } = pageController;

      const propInput = document.getElementById('prop-value') as HTMLInputElement | null;
      const downPaymentInput = document.getElementById('down-payment') as HTMLInputElement | null;
      const rentInput = document.getElementById('monthly-rent') as HTMLInputElement | null;
      const investmentRateInput = document.getElementById('inv-rate') as HTMLInputElement | null;
      const yearsInput = document.getElementById('years') as HTMLInputElement | null;

      const calcButton = document.getElementById('calc-btn') as HTMLButtonElement | null;
      const errorElement = document.getElementById('calc-error');

      const propertyOutput = document.getElementById('res-prop');
      const investmentOutput = document.getElementById('res-inv');
      const recommendationOutput = document.getElementById('res-rec');

      if (
        !propInput ||
        !downPaymentInput ||
        !rentInput ||
        !investmentRateInput ||
        !yearsInput ||
        !calcButton ||
        !errorElement ||
        !propertyOutput ||
        !investmentOutput ||
        !recommendationOutput
      ) {
        return;
      }

      function resetResults() {
        propertyOutput.textContent = '—';
        investmentOutput.textContent = '—';
        recommendationOutput.textContent =
          'Corrija os valores informados para gerar a comparação.';
      }

      function showError(message: string) {
        errorElement.textContent = message;
        errorElement.hidden = false;
        resetResults();
      }

      function clearError() {
        errorElement.textContent = '';
        errorElement.hidden = true;
      }

      function readRequiredNumber(
        input: HTMLInputElement,
        fieldName: string
      ): number {
        if (input.value.trim() === '') {
          throw new Error(`Preencha o campo "${fieldName}".`);
        }

        const value = Number(input.value);

        if (!Number.isFinite(value)) {
          throw new Error(`Informe um valor numérico válido para "${fieldName}".`);
        }

        return value;
      }

      function runCalc() {
        clearError();

        try {
          const propValue = readRequiredNumber(
            propInput,
            'Valor do imóvel'
          );

          const downPayment = readRequiredNumber(
            downPaymentInput,
            'Valor da entrada'
          );

          const monthlyRent = readRequiredNumber(
            rentInput,
            'Aluguel mensal'
          );

          const invRate = readRequiredNumber(
            investmentRateInput,
            'Rentabilidade dos investimentos'
          );

          const years = readRequiredNumber(
            yearsInput,
            'Horizonte de análise'
          );

          if (propValue <= 0) {
            throw new Error('Informe um valor de imóvel maior que zero.');
          }

          if (downPayment < 0) {
            throw new Error(
              'O valor da entrada não pode ser negativo.'
            );
          }

          if (downPayment >= propValue) {
            throw new Error(
              'O valor da entrada deve ser menor que o valor do imóvel nesta simulação de financiamento.'
            );
          }

          if (monthlyRent < 0) {
            throw new Error(
              'O valor do aluguel não pode ser negativo.'
            );
          }

          if (invRate < 0) {
            throw new Error(
              'A rentabilidade dos investimentos não pode ser negativa.'
            );
          }

          if (!Number.isInteger(years) || years < 1 || years > 30) {
            throw new Error(
              'Informe um período inteiro entre 1 e 30 anos.'
            );
          }

          const result = calculateBuyVsRent({
            propertyValue: propValue,
            downPayment,
            annualInterestRate: 10,
            financingMonths: years * 12,
            monthlyRent,
            propertyAppreciationRate: 4,
            investmentReturnRate: invRate,
            simulationYears: years,
          });

          const propertyValue = result.totalPropertyFutureValue;
          const investmentValue = result.totalInvestmentFutureValue;
          const recommendation = result.recommendation;

          if (
            !Number.isFinite(propertyValue) ||
            propertyValue < 0
          ) {
            throw new Error(
              'O motor retornou um valor inválido para o cenário de compra.'
            );
          }

          if (
            !Number.isFinite(investmentValue) ||
            investmentValue < 0
          ) {
            throw new Error(
              'O motor retornou um valor inválido para o cenário de aluguel.'
            );
          }

          if (
            typeof recommendation !== 'string' ||
            recommendation.trim() === ''
          ) {
            throw new Error(
              'O motor não retornou uma recomendação válida para a comparação.'
            );
          }

          propertyOutput.textContent = formatBRL(propertyValue);
          investmentOutput.textContent = formatBRL(investmentValue);
          recommendationOutput.textContent = recommendation;
        } catch (error) {
          const message =
            error instanceof Error
              ? error.message
              : 'Não foi possível realizar a comparação. Confira os valores informados e tente novamente.';

          showError(message);
        }
      }

      calcButton.addEventListener('click', runCalc, { signal });

      [
        propInput,
        downPaymentInput,
        rentInput,
        investmentRateInput,
        yearsInput,
      ].forEach(input => {
        input.addEventListener('input', runCalc, { signal });
        input.addEventListener('change', runCalc, { signal });
      });

      runCalc();
    }

    initPage();

    document.addEventListener('astro:page-load', initPage);
  </script>

