---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getToolsByCategory } from '../../data/tools';

const financasTools = getToolsByCategory('Finanças');

const descriptions: Record<string, string> = {
  'Juros Compostos': 'Projete o crescimento do seu dinheiro ao longo do tempo, considerando juros sobre juros e aportes periódicos.',
  'Calculadora de Juros Compostos': 'Simule a evolução de investimentos com capital inicial, aportes mensais e rentabilidade.',
  'Simulador de Financiamento SAC': 'Calcule parcelas, amortização, juros e custo total de um financiamento imobiliário.',
  'Simulador de Financiamento': 'Compare condições de financiamento e entenda o impacto das taxas e dos prazos.',
  'Independência Financeira': 'Estime o patrimônio necessário para alcançar sua meta de renda passiva.',
  'Comprar ou Alugar Imóvel': 'Compare os custos de comprar um imóvel financiado com a alternativa de alugar e investir.',
  'Custo Real do Carro': 'Estime os gastos com combustível, seguro, manutenção, impostos e depreciação do veículo.',
};

const featuredTools = financasTools.map((tool, index) => ({
  ...tool,
  description: descriptions[tool.name] || tool.description,
  number: String(index + 1).padStart(2, '0'),
}));
---

<BaseLayout
  title="Calculadoras Financeiras: Investimentos, Juros e Financiamentos — Calculadora de Ganhos"
  description="Explore calculadoras financeiras gratuitas para simular investimentos, juros compostos, financiamentos, aposentadoria e planejamento financeiro. Faça suas simulações online."
>
  <div class="finance-page">
    <!-- NAVEGAÇÃO -->
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Finanças</span>
    </nav>

    <!-- HERO COM MOCKUP FLUTUANTE DE DASHBOARD -->
    <header class="hero">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-grid">
        <div class="hero-text">
          <span class="eyebrow">PLANEJAMENTO FINANCEIRO</span>

          <h1>
            Calculadoras
            <span>Financeiras</span>
          </h1>

          <p class="hero-description">
            Tome decisões financeiras com mais clareza. Utilize nossas ferramentas
            gratuitas para simular investimentos, entender financiamentos,
            planejar objetivos e organizar seu dinheiro.
          </p>

          <div class="hero-actions">
            <a href="#ferramentas" class="hero-cta">
              Explorar calculadoras <span aria-hidden="true">↓</span>
            </a>

            <span class="hero-note">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Simulações gratuitas e online
            </span>
          </div>
        </div>

        <!-- CARTÃO VISUAL ILUSTRATIVO (MOCKUP DASHBOARD FINANCEIRA) -->
        <div class="hero-visual" aria-hidden="true">
          <span class="floating-symbol symbol-one">R$</span>
          <span class="floating-symbol symbol-two">+12,4%</span>
          <span class="floating-symbol symbol-three">↗</span>

          <div class="mockup-card dash-mockup">
            <div class="mockup-top">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <span class="mockup-badge">Projeção patrimonial</span>
            </div>

            <!-- RESUMO DO PATRIMÔNIO -->
            <div class="dash-balance-box">
              <div class="dash-balance-header">
                <span class="dash-balance-label">Patrimônio acumulado</span>
                <span class="dash-trend-pill">+18,6% a.a.</span>
              </div>
              <div class="dash-balance-value">R$ 148.920,00</div>
            </div>

            <!-- GRÁFICO DE CRESCIMENTO -->
            <div class="dash-chart">
              <div class="dash-grid-lines">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="dash-bars">
                <div class="dash-bar-col">
                  <div class="dash-bar-track"><span style="height: 28%"></span></div>
                  <small>Ano 1</small>
                </div>
                <div class="dash-bar-col">
                  <div class="dash-bar-track"><span style="height: 42%"></span></div>
                  <small>Ano 2</small>
                </div>
                <div class="dash-bar-col">
                  <div class="dash-bar-track"><span style="height: 56%"></span></div>
                  <small>Ano 3</small>
                </div>
                <div class="dash-bar-col">
                  <div class="dash-bar-track"><span style="height: 74%"></span></div>
                  <small>Ano 4</small>
                </div>
                <div class="dash-bar-col is-active">
                  <div class="dash-bar-track"><span style="height: 96%"></span></div>
                  <small>Ano 5</small>
                </div>
              </div>
            </div>

            <!-- MINI INDICADORES -->
            <div class="dash-kpis">
              <div class="dash-kpi">
                <span>Total investido</span>
                <strong>R$ 96.000</strong>
              </div>
              <div class="dash-kpi">
                <span>Juros obtidos</span>
                <strong class="is-positive">+R$ 52.920</strong>
              </div>
            </div>

            <div class="mockup-row-footer">
              <span>Calculadora de Ganhos</span>
              <span class="mockup-dot"></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- BARRA DE INDICADORES -->
    <section class="highlights" aria-label="Características das ferramentas">
      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>
          </svg>
        </div>
        <div>
          <strong>Simulações práticas</strong>
          <small>Resultados organizados para sua análise</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/>
          </svg>
        </div>
        <div>
          <strong>Planejamento consciente</strong>
          <small>Entenda cenários antes de decidir</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>
          </svg>
        </div>
        <div>
          <strong>Acesso online</strong>
          <small>Funciona em celular e computador</small>
        </div>
      </div>
    </section>

    <!-- FERRAMENTAS -->
    <section class="tools-section" id="ferramentas" aria-labelledby="tools-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">NOSSA COLEÇÃO</span>
          <h2 id="tools-title">Explore nossas calculadoras</h2>
          <p>
            Escolha a ferramenta que corresponde ao seu objetivo financeiro.
          </p>
        </div>

        <span class="tools-count">
          {featuredTools.length} {featuredTools.length === 1 ? 'ferramenta disponível' : 'ferramentas disponíveis'}
        </span>
      </div>

      {featuredTools.length > 0 ? (
        <div class="tools-grid">
          {featuredTools.map((tool) => (
            <a href={tool.route} class="tool-card">
              <div class="tool-card-top">
                <span class="tool-number">{tool.number}</span>
                <span class="tool-arrow" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17 17 7"/><path d="M7 7h10v10"/>
                  </svg>
                </span>
              </div>

              <div class="tool-card-content">
                <h3>{tool.name}</h3>
                <p>{tool.description}</p>
              </div>

              <div class="tool-card-footer">
                <span>Acessar calculadora</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>
            </svg>
          </div>
          <h3>Novas calculadoras em preparação</h3>
          <p>
            Estamos preparando novas ferramentas financeiras.
            Volte em breve para conferir as novidades.
          </p>
        </div>
      )}
    </section>

    <!-- GUIA DE EDUCAÇÃO FINANCEIRA -->
    <section class="content-section" aria-labelledby="guide-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">EDUCAÇÃO FINANCEIRA</span>
          <h2 id="guide-title">Planejar é o primeiro passo para cuidar melhor do dinheiro</h2>
        </div>
      </div>

      <div class="guide-grid">
        <article class="guide-card">
          <div class="guide-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3>Entenda seus números</h3>
          <p>
            Antes de investir, financiar ou assumir uma nova despesa,
            é importante compreender como os valores envolvidos afetam
            seu orçamento. Uma simulação permite visualizar cenários,
            comparar alternativas e identificar custos que poderiam
            passar despercebidos.
          </p>
        </article>

        <article class="guide-card">
          <div class="guide-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/>
            </svg>
          </div>
          <h3>Compare diferentes cenários</h3>
          <p>
            Taxas de juros, prazos, aportes e valores iniciais podem
            alterar significativamente um resultado financeiro.
            Testar diferentes combinações ajuda a entender essas
            diferenças e a tomar decisões mais fundamentadas.
          </p>
        </article>

        <article class="guide-card">
          <div class="guide-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3>Use os resultados com consciência</h3>
          <p>
            Toda simulação depende das informações fornecidas e das
            premissas utilizadas. Os resultados são estimativas para
            fins educativos e não substituem uma análise individual
            das condições de cada operação financeira.
          </p>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">DÚVIDAS FREQUENTES</span>
          <h2 id="faq-title">Perguntas sobre calculadoras financeiras</h2>
        </div>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>As calculadoras financeiras são gratuitas?</summary>
          <p>
            Sim. As ferramentas disponibilizadas nesta categoria podem
            ser utilizadas gratuitamente, diretamente pelo navegador.
          </p>
        </details>

        <details class="faq-item">
          <summary>Posso utilizar as calculadoras pelo celular?</summary>
          <p>
            Sim. As páginas são desenvolvidas para funcionar em computadores,
            tablets e smartphones, com adaptação para diferentes tamanhos
            de tela.
          </p>
        </details>

        <details class="faq-item">
          <summary>Os resultados das simulações são garantidos?</summary>
          <p>
            Não. Os resultados são estimativas matemáticas baseadas nos dados
            informados e nas premissas de cada ferramenta. Condições reais,
            taxas, impostos e outros fatores podem modificar os resultados.
          </p>
        </details>

        <details class="faq-item">
          <summary>As calculadoras substituem um profissional financeiro?</summary>
          <p>
            Não. Elas são recursos de apoio ao planejamento e à educação
            financeira. Para decisões importantes, considere consultar
            um profissional habilitado.
          </p>
        </details>
      </div>
    </section>

    <!-- AVISO LEGAL -->
    <aside class="notice">
      <div class="notice-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        </svg>
        <strong>Transparência:</strong>
      </div>
      <p>
        As ferramentas desta página têm finalidade educativa e informativa.
        Os resultados não representam garantia de rentabilidade, aprovação
        de crédito ou recomendação de investimento.
      </p>
    </aside>

    <!-- CTA FINAL -->
    <section class="final-cta">
      <span class="eyebrow">CALCULADORA DE GANHOS</span>
      <h2>Planeje seus objetivos com mais clareza</h2>
      <p>
        Explore também nossas calculadoras trabalhistas, matemáticas e
        conversores gratuitos em um só lugar.
      </p>
      <a href="/" class="cta-link">
        <span>Explorar outras ferramentas</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .finance-page {
    width: 100%;
    padding: 0.5rem 0 2.5rem;
    color: var(--text-primary);
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1.75rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  /* HERO (PADRÃO CENTRAL DE FERRAMENTAS) */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 2.75rem 3rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .hero-glow {
    position: absolute;
    top: -120px;
    right: -80px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 16%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-text {
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    color: var(--color-primary);
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 0.85rem;
  }

  .hero h1 {
    margin: 0 0 1.15rem;
    font-size: clamp(2.15rem, 4.5vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 850;
    color: var(--text-primary);
    text-align: center;
  }

  .hero h1 span {
    display: block;
    color: var(--color-primary);
  }

  .hero-description {
    max-width: 520px;
    margin: 0 auto 1.75rem;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.75;
    text-align: center;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.35rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.45rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .hero-cta:hover {
    opacity: 0.92;
    transform: translateY(-2px);
  }

  .hero-note {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .hero-note svg {
    color: var(--color-primary);
  }

  /* CARTÃO MOCKUP DASHBOARD FINANCEIRA */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .floating-symbol {
    position: absolute;
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding: 0 0.55rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-primary);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 850;
    box-shadow: var(--shadow-md);
    pointer-events: none;
    z-index: 2;
  }

  .symbol-one {
    top: -10px;
    left: 10px;
    transform: rotate(-10deg);
  }

  .symbol-two {
    top: 30px;
    right: 2px;
    transform: rotate(10deg);
  }

  .symbol-three {
    bottom: 14px;
    left: 4px;
    transform: rotate(8deg);
  }

  .dash-mockup {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 335px;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-primary);
    box-shadow: var(--shadow-lg);
    transform: rotate(-2.5deg);
    transition: transform 0.3s ease;
    text-align: left;
  }

  .dash-mockup:hover {
    transform: rotate(0deg) translateY(-3px);
  }

  .mockup-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.95rem;
  }

  .window-dots {
    display: flex;
    gap: 5px;
  }

  .window-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-color);
  }

  .mockup-badge {
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 750;
  }

  /* RESUMO DO PATRIMÔNIO */
  .dash-balance-box {
    padding: 0.85rem 0.95rem;
    margin-bottom: 0.85rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
  }

  .dash-balance-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }

  .dash-balance-label {
    color: var(--text-secondary);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .dash-trend-pill {
    padding: 0.16rem 0.48rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    color: var(--color-primary);
    font-size: 0.66rem;
    font-weight: 800;
  }

  .dash-balance-value {
    color: var(--text-primary);
    font-size: 1.42rem;
    font-weight: 850;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  /* GRÁFICO DE BARRAS */
  .dash-chart {
    position: relative;
    padding: 0.75rem 0.65rem 0.55rem;
    margin-bottom: 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
  }

  .dash-grid-lines {
    position: absolute;
    inset: 0.75rem 0.65rem 1.65rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }

  .dash-grid-lines span {
    border-top: 1px dashed var(--border-color);
  }

  .dash-bars {
    position: relative;
