      background: var(--bg-secondary);
    }

    .faq-item summary {
      position: relative;
      padding-right: 1.5rem;
      color: var(--text-primary);
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      list-style: none;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item summary::after {
      position: absolute;
      top: 0;
      right: 0;
      color: var(--color-primary);
      content: "+";
      font-size: 1.2rem;
      line-height: 1;
    }

    .faq-item[open] summary::after {
      content: "−";
    }

    .faq-item p {
      margin: 0.85rem 0 0;
      color: var(--text-secondary);
      font-size: 0.84rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin: 2rem 0 0;
      padding: 1rem 1.1rem;
      border-left: 3px solid var(--color-primary);
      background: var(--bg-secondary);
      color: var(--text-secondary);
      font-size: 0.81rem;
      line-height: 1.7;
    }

    .disclaimer strong {
      color: var(--text-primary);
    }

    @media (max-width: 850px) {
      .calculator-grid {
        grid-template-columns: 1fr;
      }

      .result-card {
        position: static;
      }

      .info-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 580px) {
      .card {
        padding: 1.1rem;
      }

      .date-grid,
      .info-grid,
      .types-grid {
