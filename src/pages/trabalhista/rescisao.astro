---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calculadora de Rescisão Trabalhista CLT Online — Calculadora de Ganhos"
  description="Simule sua rescisão trabalhista CLT. Calcule saldo de salário, aviso prévio proporcional, férias, décimo terceiro e multa do FGTS."
>
  <main class="page-container">
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/trabalhista/">Trabalhista</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Rescisão</span>
    </nav>

    <header class="page-header">
      <span class="eyebrow">CALCULADORA TRABALHISTA</span>
      <h1>Calculadora de Rescisão Trabalhista</h1>
      <p>
        Simule os valores da sua rescisão contratual. Informe os dados do vínculo
        empregatício e confira uma estimativa das principais verbas rescisórias.
      </p>
    </header>

    <section class="notice-banner">
      <span class="notice-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
      </span>
      <p>
        <strong>Importante:</strong> o resultado é uma simulação. O valor efetivo
        pode variar conforme o histórico do contrato, depósitos do FGTS, férias
        adquiridas, descontos e regras coletivas aplicáveis.
      </p>
    </section>

    <section class="calculator-grid" aria-label="Calculadora de rescisão">
      <div class="card form-card">
        <div class="section-heading">
          <div class="heading-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div>
            <h2>Dados do contrato</h2>
            <p>Preencha as informações do seu vínculo empregatício.</p>
          </div>
        </div>

        <div class="form-group">
          <label for="res-salary">Último salário bruto mensal</label>
          <div class="input-wrapper">
            <span class="input-prefix">R$</span>
            <input
              type="number"
              id="res-salary"
              value="3500"
              min="0.01"
              step="0.01"
              inputmode="decimal"
              placeholder="Ex.: 3500,00"
            />
          </div>
          <small>Informe sua remuneração mensal bruta.</small>
        </div>

        <div class="form-group">
          <label for="res-type">Motivo do desligamento</label>
          <select id="res-type">
            <option value="sem-justa-causa">Dispensa sem justa causa</option>
            <option value="pedido-demissao">Pedido de demissão</option>
            <option value="acordo-mutuo">Acordo entre empregado e empregador</option>
            <option value="com-justa-causa">Dispensa por justa causa</option>
          </select>
          <small>O tipo de desligamento altera as verbas rescisórias.</small>
        </div>

        <div class="form-group" id="aviso-group">
          <label for="res-aviso-type">Modalidade do aviso prévio</label>
          <select id="res-aviso-type">
            <option value="indenizado">Indenizado</option>
            <option value="trabalhado">Trabalhado</option>
          </select>
          <small id="aviso-help">
            Selecione como o aviso prévio foi ou será cumprido.
          </small>
        </div>

        <div class="form-group" id="fgts-group">
          <label for="res-fgts-balance">Saldo do FGTS para fins rescisórios (opcional)</label>
          <div class="input-wrapper">
            <span class="input-prefix">R$</span>
            <input
              type="number"
              id="res-fgts-balance"
              min="0"
              step="0.01"
              inputmode="decimal"
              placeholder="Ex.: 8500,00 (deixe em branco se não souber)"
            />
          </div>
          <small id="fgts-help">
            Informe o saldo base do FGTS para calcular a multa rescisória de 40%.
          </small>
        </div>

        <div class="form-group">
          <label for="res-dependents">Dependentes para o IRRF</label>
          <input
            type="number"
            id="res-dependents"
            value="0"
            min="0"
            step="1"
            inputmode="numeric"
          />
          <small>
            Informe a quantidade de dependentes que podem ser considerados para fins de IRRF.
          </small>
        </div>

        <div class="form-divider"></div>

        <div class="section-heading compact-heading">
          <div class="heading-icon secondary-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div>
            <h2>Datas do contrato</h2>
            <p>Informe o início e o término do vínculo.</p>
          </div>
        </div>

        <div class="date-grid">
          <div class="form-group">
            <label for="res-start-date">Data de admissão</label>
            <input type="date" id="res-start-date" value="2020-01-15" />
          </div>

          <div class="form-group">
            <label for="res-end-date">Data de afastamento</label>
            <input type="date" id="res-end-date" />
          </div>
        </div>

        <div class="form-divider"></div>

        <div class="vacation-option">
          <input type="checkbox" id="res-vencida" />
          <label for="res-vencida">
            <strong>Possuo férias adquiridas e ainda não gozadas</strong>
            <small>
              Informe quantos períodos completos ainda não foram quitados.
            </small>
          </label>
        </div>

        <div id="vacation-details" class="vacation-details" hidden>
          <div class="form-group">
            <label for="res-vacation-periods">Quantidade de períodos adquiridos</label>
            <input
              type="number"
              id="res-vacation-periods"
              value="1"
              min="1"
              step="1"
              inputmode="numeric"
            />
            <small>
              Informe todos os períodos completos ainda não gozados ou quitados.
            </small>
          </div>

          <div class="form-group">
            <label for="res-vacation-overdue">
              Quantos desses períodos devem ser pagos em dobro?
            </label>
            <input
              type="number"
              id="res-vacation-overdue"
              value="0"
              min="0"
              step="1"
              inputmode="numeric"
            />
            <small>
              Informe somente os períodos que ultrapassaram o prazo legal de concessão.
            </small>
          </div>
        </div>

        <div id="calc-error" class="form-error" role="alert" hidden></div>

        <button type="button" id="calc-btn" class="calculate-button">
          <span>Calcular minha rescisão</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </button>

        <p class="privacy-note">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline; vertical-align:-1px; margin-right:4px;">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Seus dados são utilizados apenas para realizar esta simulação.
        </p>
      </div>

      <div class="card result-card">
        <div class="section-heading">
          <div class="heading-icon result-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div>
            <h2>Resultado da simulação</h2>
            <p>Confira a memória de cálculo estimada.</p>
          </div>
        </div>

        <div class="total-panel" aria-live="polite">
          <span class="total-label">Total estimado da rescisão</span>
          <strong id="res-total">R$ 0,00</strong>
          <span class="total-caption">
            Conforme as verbas e os descontos calculados pela ferramenta
          </span>
        </div>

        <div class="result-group">
          <span class="result-group-title">VERBAS RESCISÓRIAS</span>

          <div class="result-row">
            <div>
              <span class="result-label">Saldo de salário</span>
              <small>Dias trabalhados no mês do desligamento</small>
            </div>
            <strong id="res-saldo">R$ 0,00</strong>
          </div>

          <div class="result-row">
            <div>
              <span class="result-label">Aviso prévio</span>
              <small><span id="res-aviso-dias">30</span> dias considerados</small>
            </div>
            <strong id="res-aviso">R$ 0,00</strong>
          </div>

          <div class="result-row">
            <div>
              <span class="result-label">Décimo terceiro proporcional</span>
              <small>Inclui eventual parcela indenizada calculada</small>
            </div>
            <strong id="res-13">R$ 0,00</strong>
          </div>

          <div class="result-row">
            <div>
              <span class="result-label">Férias proporcionais</span>
              <small>Inclui eventual parcela indenizada calculada</small>
            </div>
            <strong id="res-ferias">R$ 0,00</strong>
          </div>

          <div class="result-row">
            <div>
              <span class="result-label">Férias vencidas</span>
              <small>Valor apresentado pelo motor de cálculo</small>
            </div>
            <strong id="res-ferias-venc" class="positive-value">R$ 0,00</strong>
          </div>
        </div>

        <div class="result-group">
          <span class="result-group-title">FGTS E DESCONTOS</span>

          <div class="result-row">
            <div>
              <span class="result-label">Multa rescisória do FGTS</span>
              <small id="res-multa-desc">Estimativa conforme a base do FGTS informada</small>
            </div>
            <strong id="res-multa">R$ 0,00</strong>
          </div>

          <div class="result-row discount-row">
            <div>
              <span class="result-label">Descontos estimados</span>
              <small>INSS e IRRF considerados pelo motor</small>
            </div>
            <strong id="res-descontos">R$ 0,00</strong>
          </div>
        </div>

        <div class="result-observation">
          <span aria-hidden="true">ⓘ</span>
          <div>
            <p>
              O saldo disponível na conta do FGTS, os saques e outros descontos
              não são necessariamente representados integralmente neste resultado.
              Confira seu extrato e o demonstrativo oficial da rescisão.
            </p>
            <ul id="res-notes" class="calculation-notes" hidden></ul>
          </div>
        </div>
      </div>
    </section>

    <section class="content-section">
      <div class="content-heading">
        <span class="eyebrow">ENTENDA SEUS DIREITOS</span>
        <h2>O que entra no cálculo da rescisão?</h2>
        <p>
          As verbas rescisórias dependem principalmente do motivo do desligamento,
          do tempo de serviço e das condições do contrato.
        </p>
      </div>

      <div class="info-grid">
        <article class="info-card">
          <div class="info-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3>Saldo de salário</h3>
          <p>
            Corresponde aos dias trabalhados no mês em que ocorre o encerramento
            do contrato, ainda não pagos pelo empregador.
          </p>
        </article>

        <article class="info-card">
          <div class="info-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3>Aviso prévio</h3>
          <p>
            Pode ser trabalhado ou indenizado. Na dispensa sem justa causa,
            o período pode ser proporcional ao tempo de serviço.
          </p>
        </article>

        <article class="info-card">
          <div class="info-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <h3>Décimo terceiro</h3>
          <p>
            O valor proporcional considera os meses trabalhados no ano,
            observadas as regras de contagem e a projeção do aviso prévio
            quando aplicável.
          </p>
        </article>

        <article class="info-card">
          <div class="info-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
              <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
            </svg>
          </div>
          <h3>Férias e adicional de 1/3</h3>
          <p>
            Podem existir valores de férias proporcionais, adquiridas e não
            gozadas, acrescidos do adicional constitucional, conforme o caso.
          </p>
        </article>

        <article class="info-card">
          <div class="info-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <h3>FGTS e multa rescisória</h3>
          <p>
            Na dispensa sem justa causa, em regra, existe multa de 40% sobre
            a base legal dos depósitos do FGTS. No acordo, a multa é de 20%.
          </p>
        </article>

        <article class="info-card">
          <div class="info-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m16 16 3-8 3 8c-.87.65-1.93 1-3 1s-2.13-.35-3-1Z"></path>
              <path d="m2 16 3-8 3 8c-.87.65-1.93 1-3 1s-2.13-.35-3-1Z"></path>
              <path d="M7 21h10"></path>
              <path d="M12 3v18"></path>
              <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>
            </svg>
          </div>
          <h3>Descontos legais</h3>
          <p>
            INSS, imposto de renda e outros descontos permitidos podem alterar
            o valor final recebido pelo trabalhador.
          </p>
        </article>
      </div>
    </section>

    <section class="types-section">
      <div class="content-heading">
        <span class="eyebrow">MODALIDADES DE DESLIGAMENTO</span>
        <h2>O motivo da rescisão faz diferença</h2>
        <p>
          Cada modalidade possui regras próprias para o pagamento das verbas
          trabalhistas.
        </p>
      </div>

      <div class="types-grid">
        <article class="type-card">
          <span class="type-indicator indicator-green"></span>
          <h3>Sem justa causa</h3>
          <p>
            Em regra, inclui saldo de salário, aviso prévio, férias e décimo
            terceiro proporcionais, além da multa rescisória do FGTS.
          </p>
        </article>

        <article class="type-card">
          <span class="type-indicator indicator-blue"></span>
          <h3>Pedido de demissão</h3>
          <p>
            Em regra, são devidos saldo de salário, férias adquiridas e
            proporcionais com adicional de 1/3 e décimo terceiro proporcional.
            Pode haver desconto de aviso prévio não cumprido.
          </p>
        </article>

        <article class="type-card">
          <span class="type-indicator indicator-purple"></span>
          <h3>Acordo entre as partes</h3>
          <p>
            O artigo 484-A da CLT prevê regras específicas, incluindo metade
            do aviso prévio indenizado e metade da indenização sobre o FGTS,
            além das demais verbas devidas integralmente.
          </p>
        </article>

        <article class="type-card">
          <span class="type-indicator indicator-orange"></span>
          <h3>Com justa causa</h3>
          <p>
            As verbas são mais restritas. Em regra, são devidos saldo de salário
            e férias já adquiridas com adicional de 1/3, conforme a situação.
          </p>
        </article>
      </div>
    </section>

    <section class="legal-section">
      <div class="legal-icon" aria-hidden="true">§</div>
      <div>
        <h2>Legislação trabalhista</h2>
        <p>
          A rescisão do contrato de trabalho envolve diferentes dispositivos
          legais. Entre as referências importantes estão a CLT, a Lei
          12.506/2011, que trata do aviso prévio proporcional, e o artigo
          484-A da CLT, que regulamenta a extinção do contrato por acordo.
        </p>
        <div class="legal-links">
          <a
            href="https://www.planalto.gov.br/ccivil_03/decreto-lei/del5452compilado.htm"
            target="_blank"
            rel="noopener noreferrer"
          >Consultar a CLT</a>
          <a
            href="https://www.planalto.gov.br/ccivil_03/_ato2011-2014/2011/lei/l12506.htm"
            target="_blank"
            rel="noopener noreferrer"
          >Lei 12.506/2011 — Aviso prévio proporcional</a>
          <a
            href="https://www.planalto.gov.br/ccivil_03/leis/l8036consol.htm"
            target="_blank"
            rel="noopener noreferrer"
          >Lei 8.036/1990 — FGTS</a>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="content-heading">
        <span class="eyebrow">DÚVIDAS FREQUENTES</span>
        <h2>Perguntas sobre rescisão trabalhista</h2>
      </div>

      <details class="faq-item">
        <summary>Como funciona o aviso prévio proporcional?</summary>
        <p>
          A Lei 12.506/2011 estabelece 30 dias de aviso prévio, acrescidos de
          3 dias por ano de serviço prestado na mesma empresa, até o limite
          legal de 90 dias no total.
        </p>
      </details>

      <details class="faq-item">
        <summary>Quem pede demissão recebe multa do FGTS?</summary>
        <p>
          Em regra, não. No pedido de demissão, o trabalhador não recebe a
          multa rescisória de 40% e não tem liberação do FGTS pela modalidade
          de desligamento, ressalvadas outras hipóteses legais de saque.
        </p>
      </details>

      <details class="faq-item">
        <summary>Como funciona a rescisão por acordo?</summary>
        <p>
          No acordo previsto no artigo 484-A da CLT, o aviso prévio, se
          indenizado, e a indenização sobre o saldo do FGTS são pagos pela
          metade. As demais verbas trabalhistas são devidas integralmente.
          O saque do FGTS fica limitado à regra legal dessa modalidade.
        </p>
      </details>

      <details class="faq-item">
        <summary>O que são férias vencidas?</summary>
        <p>
          São férias relativas a um período aquisitivo já completado e ainda
          não usufruídas. Dependendo do prazo de concessão e das circunstâncias,
          pode existir pagamento em dobro. A simulação simplificada não substitui
          a análise dos períodos e das datas de cada férias.
        </p>
      </details>

      <details class="faq-item">
        <summary>O valor calculado é exatamente o que vou receber?</summary>
        <p>
          Não necessariamente. O cálculo depende dos dados informados e das
          regras implementadas na ferramenta. O demonstrativo oficial pode
          incluir outras verbas, descontos, médias remuneratórias e informações
          do FGTS que não foram consideradas na simulação.
        </p>
      </details>

      <details class="faq-item">
        <summary>Qual é o prazo para pagamento da rescisão?</summary>
        <p>
          Em regra, o artigo 477, § 6º, da CLT estabelece prazo de até 10 dias
          contados do término do contrato para pagamento das verbas rescisórias
          e entrega dos documentos previstos na legislação.
        </p>
      </details>
    </section>

    <p class="disclaimer">
      <strong>Aviso:</strong> esta ferramenta tem finalidade exclusivamente
      informativa. Ela não substitui o Termo de Rescisão do Contrato de Trabalho
      (TRCT), a conferência do extrato do FGTS ou a orientação de um profissional
      especializado.
    </p>
  </main>

  <script>
    import { calculateRescisao } from '../../engines/business/rescisao-engine';
    import { formatBRL } from '../../engines/common/currency';

    const getInput = (id: string): HTMLInputElement =>
      document.getElementById(id) as HTMLInputElement;

    const getSelect = (id: string): HTMLSelectElement =>
      document.getElementById(id) as HTMLSelectElement;

    const setText = (id: string, value: string) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    };

    const errorElement = document.getElementById('calc-error');

    function showError(message: string) {
      if (errorElement) {
        errorElement.textContent = message;
        errorElement.removeAttribute('hidden');
      }
    }

    function clearError() {
      if (errorElement) {
        errorElement.textContent = '';
        errorElement.setAttribute('hidden', '');
      }
    }

    function toggleVacationDetails() {
      const hasVencida = getInput('res-vencida').checked;
      const vacationDetails = document.getElementById('vacation-details');
      if (vacationDetails) {
        vacationDetails.hidden = !hasVencida;
      }
    }

    function updateNoticeHelp() {
      const type = getSelect('res-type').value;
      const avisoGroup = document.getElementById('aviso-group');
      const avisoHelp = document.getElementById('aviso-help');
      const fgtsGroup = document.getElementById('fgts-group');
      const fgtsHelp = document.getElementById('fgts-help');

      if (avisoHelp) {
        const messages: Record<string, string> = {
          'sem-justa-causa':
            'Na dispensa sem justa causa, o aviso pode ser trabalhado ou indenizado.',
          'pedido-demissao':
            'No pedido de demissão, o aviso pode ser cumprido ou, conforme o caso, descontado.',
          'acordo-mutuo':
            'No acordo, se o aviso prévio for indenizado, aplica-se a regra específica do artigo 484-A da CLT.',
          'com-justa-causa':
            'Em regra, não há aviso prévio devido na dispensa por justa causa.'
        };

        avisoHelp.textContent =
          messages[type] || 'Selecione a modalidade do aviso prévio.';
      }

      if (avisoGroup) {
        avisoGroup.classList.toggle('notice-disabled', type === 'com-justa-causa');
      }

      const hasFgtsFine = type === 'sem-justa-causa' || type === 'acordo-mutuo';
      if (fgtsGroup) {
        fgtsGroup.hidden = !hasFgtsFine;
      }
      if (fgtsHelp && hasFgtsFine) {
        fgtsHelp.textContent =
          type === 'acordo-mutuo'
            ? 'Informe o saldo base do FGTS para calcular a multa rescisória de 20%.'
            : 'Informe o saldo base do FGTS para calcular a multa rescisória de 40%.';
      }
    }

    function runCalc() {
      clearError();

      const salary = Number(getInput('res-salary').value);
      const type = getSelect('res-type').value;
      const avisoType = getSelect('res-aviso-type').value;
      const startDate = getInput('res-start-date').value;
      const endDate = getInput('res-end-date').value;
      const hasVencida = getInput('res-vencida').checked;
      const rawFgts = getInput('res-fgts-balance').value.trim();
      const dependents = Math.max(0, Math.floor(Number(getInput('res-dependents').value) || 0));

      let vacationPeriodsDue: number | undefined;
      let vacationPeriodsOverdue = 0;

      if (hasVencida) {
        const periods = Math.floor(Number(getInput('res-vacation-periods').value));
        const overdue = Math.floor(Number(getInput('res-vacation-overdue').value) || 0);

        if (!Number.isFinite(periods) || periods < 1) {
          showError('Informe pelo menos 1 período de férias adquiridas.');
          return;
        }

        if (!Number.isFinite(overdue) || overdue < 0 || overdue > periods) {
          showError('A quantidade de períodos em dobro deve estar entre 0 e o total de períodos adquiridos.');
          return;
        }

        vacationPeriodsDue = periods;
        vacationPeriodsOverdue = overdue;
      }

      if (!Number.isFinite(salary) || salary <= 0) {
        showError('Informe um salário bruto maior que zero.');
        return;
      }

      let fgtsBaseForTermination: number | undefined;
      if (rawFgts !== '') {
        const parsedFgts = Number(rawFgts);
        if (!Number.isFinite(parsedFgts) || parsedFgts < 0) {
          showError('O saldo do FGTS deve ser um valor válido e não negativo.');
          return;
        }
        fgtsBaseForTermination = parsedFgts;
      }

      if (!startDate || !endDate) {
        showError('Preencha as datas de admissão e afastamento.');
        return;
      }

      const start = new Date(`${startDate}T12:00:00`);
      const end = new Date(`${endDate}T12:00:00`);

      if (
        Number.isNaN(start.getTime()) ||
        Number.isNaN(end.getTime())
      ) {
        showError('Informe datas válidas para o contrato.');
        return;
      }

      if (start > end) {
        showError('A data de admissão não pode ser posterior à data de afastamento.');
        return;
      }

      try {
        const res = calculateRescisao({
          monthlySalary: salary,
          resignationType: type as any,
          avisoType: avisoType as any,
          startDate,
          endDate,
          hasVencidaVacation: hasVencida,
          fgtsBaseForTermination,
          vacationPeriodsDue,
          vacationPeriodsOverdue,
          dependents
        });

        const values = [
          res.totalLiquido,
          res.saldoSalario,
          res.avisoPrevio,
          res.decimoTerceiroProporcional,
          res.decimoTerceiroIndenizado,
          res.feriasProporcionais,
          res.feriasIndenizadas,
          res.feriasVencidas,
          res.multaFgts,
          res.inssDescontoTotal,
          res.irrfDescontoTotal,
          res.avisoDays
        ];

        if (!values.every((value) => Number.isFinite(Number(value)))) {
          throw new Error('O motor retornou valores inválidos.');
        }

        setText('res-total', formatBRL(res.totalLiquido));
        setText('res-saldo', formatBRL(res.saldoSalario));
        setText('res-aviso', formatBRL(res.avisoPrevio));
        setText('res-aviso-dias', String(res.avisoDays));

        setText(
          'res-13',
          formatBRL(
            res.decimoTerceiroProporcional +
            res.decimoTerceiroIndenizado
          )
        );

        setText(
          'res-ferias',
          formatBRL(
            res.feriasProporcionais +
            res.feriasIndenizadas
          )
        );

        setText('res-ferias-venc', formatBRL(res.feriasVencidas));
        setText('res-multa', formatBRL(res.multaFgts));

        const hasFgtsFine = type === 'sem-justa-causa' || type === 'acordo-mutuo';
        setText(
          'res-multa-desc',
          !hasFgtsFine
            ? 'Não aplicável nesta modalidade de desligamento'
            : fgtsBaseForTermination === undefined
              ? 'Informe o saldo do FGTS ao lado para calcular a multa'
              : type === 'acordo-mutuo'
                ? '20% sobre a base do FGTS informada (depositada em conta)'
                : '40% sobre a base do FGTS informada (depositada em conta)'
        );

        setText(
          'res-descontos',
          formatBRL(
            res.inssDescontoTotal +
            res.irrfDescontoTotal
          )
        );

        const notesList = document.getElementById('res-notes');
        if (notesList) {
          if (res.calculationNotes && res.calculationNotes.length > 0) {
            notesList.innerHTML = '';
            res.calculationNotes.forEach((note) => {
              const li = document.createElement('li');
              li.textContent = note;
              notesList.appendChild(li);
            });
            notesList.hidden = false;
          } else {
            notesList.innerHTML = '';
            notesList.hidden = true;
          }
        }
      } catch (error) {
        console.error('Erro ao calcular rescisão:', error);
        showError(
          'Não foi possível concluir o cálculo. Confira os dados e tente novamente.'
        );
      }
    }

    document.getElementById('calc-btn')?.addEventListener('click', runCalc);

    getSelect('res-type').addEventListener('change', () => {
      updateNoticeHelp();
      runCalc();
    });

    getSelect('res-aviso-type').addEventListener('change', runCalc);

    [
      'res-salary',
      'res-fgts-balance',
      'res-dependents',
      'res-start-date',
      'res-end-date',
      'res-vacation-periods',
      'res-vacation-overdue'
    ].forEach((id) => {
      getInput(id).addEventListener('change', runCalc);
    });

    getInput('res-vencida').addEventListener('change', () => {
      toggleVacationDetails();
      runCalc();
    });

    updateNoticeHelp();
    toggleVacationDetails();

    // Define a data atual como padrão para o afastamento.
    const endDateInput = getInput('res-end-date');
    if (!endDateInput.value) {
      const today = new Date();
      const year = today.getFullYear();
      const month = String(today.getMonth() + 1).padStart(2, '0');
      const day = String(today.getDate()).padStart(2, '0');

      endDateInput.value = `${year}-${month}-${day}`;
    }

    runCalc();
  </script>

