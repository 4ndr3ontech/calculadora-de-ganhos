---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calculadora CLT vs. PJ — Compare Salários e Ganhos — Calculadora de Ganhos"
  description="Compare uma proposta CLT com uma contratação PJ. Simule salário líquido, benefícios, faturamento, impostos e despesas para avaliar qual modalidade compensa mais."
>
  <main class="page-container">
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <a href="/trabalhista/">Trabalhista</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">CLT vs. PJ</span>
    </nav>

    <header class="page-header">
      <span class="eyebrow">PLANEJAMENTO PROFISSIONAL</span>
      <h1>Calculadora CLT vs. PJ</h1>
      <p>
        Está avaliando uma proposta de trabalho? Compare os ganhos estimados
        nas duas modalidades e descubra qual oferece o melhor resultado
        financeiro mensal.
      </p>
    </header>

    <section class="intro-card">
      <div class="intro-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m16 16 3-8 3 8c-.87.65-1.93 1-3 1s-2.13-.35-3-1Z"></path>
          <path d="m2 16 3-8 3 8c-.87.65-1.93 1-3 1s-2.13-.35-3-1Z"></path>
          <path d="M7 21h10"></path>
          <path d="M12 3v18"></path>
        </svg>
      </div>
      <div>
        <h2>Compare além do salário</h2>
        <p>
          Uma contratação CLT oferece direitos trabalhistas e benefícios.
          Já o modelo PJ pode proporcionar um faturamento maior, mas envolve
          impostos, despesas empresariais e planejamento financeiro próprio.
        </p>
      </div>
    </section>

    <section class="calculator-layout" aria-label="Simulador CLT versus PJ">
      <div class="card form-card">
        <div class="section-heading">
          <div>
            <span class="section-label">ETAPA 1</span>
            <h2>Dados da contratação</h2>
          </div>
          <div class="heading-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
        </div>

        <div class="form-section">
          <h3 class="form-section-title">
            <span class="section-number">1</span>
            Proposta CLT
          </h3>

          <div class="field">
            <label for="clt-salary">Salário bruto mensal</label>
            <div class="input-wrapper">
              <span class="input-prefix">R$</span>
              <input
                type="number"
                id="clt-salary"
                value="6000"
                min="0"
                step="100"
                inputmode="decimal"
              />
            </div>
            <small>Valor bruto registrado em carteira, antes dos descontos.</small>
          </div>

          <div class="field">
            <label for="clt-benefits">Benefícios mensais (opcional)</label>
            <div class="input-wrapper">
              <span class="input-prefix">R$</span>
              <input
                type="number"
                id="clt-benefits"
                value="0"
                min="0"
                step="50"
                inputmode="decimal"
              />
            </div>
            <small>
              Informe o valor estimado de benefícios como alimentação,
              transporte ou auxílio, quando quiser considerá-los.
            </small>
          </div>
        </div>

        <div class="form-divider"></div>

        <div class="form-section">
          <h3 class="form-section-title">
            <span class="section-number">2</span>
            Proposta PJ
          </h3>

          <div class="field">
            <label for="pj-billing">Faturamento mensal</label>
            <div class="input-wrapper">
              <span class="input-prefix">R$</span>
              <input
                type="number"
                id="pj-billing"
                value="9500"
                min="0"
                step="100"
                inputmode="decimal"
              />
            </div>
            <small>Valor mensal previsto para emissão de notas fiscais.</small>
          </div>

          <div class="field">
            <label for="pj-regime">Enquadramento tributário estimado</label>
            <select id="pj-regime">
              <option value="simples-AnexoIII">
                Simples Nacional — Anexo III
              </option>
              <option value="simples-AnexoV">
                Simples Nacional — Anexo V
              </option>
            </select>
            <small>
              O enquadramento real depende da atividade e das condições
              tributárias da empresa.
            </small>
          </div>

          <div class="field">
            <label for="pj-expenses">Despesas mensais da empresa</label>
            <div class="input-wrapper">
              <span class="input-prefix">R$</span>
              <input
                type="number"
                id="pj-expenses"
                value="400"
                min="0"
                step="50"
                inputmode="decimal"
              />
            </div>
            <small>
              Contabilidade, sistemas, ferramentas, taxas e outros custos
              operacionais.
            </small>
          </div>
        </div>

        <div id="form-error" class="form-error" role="alert" hidden></div>

        <button type="button" id="calc-btn" class="calculate-button">
          <span>Comparar CLT e PJ</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </button>

        <p class="privacy-note">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Os dados são utilizados somente para realizar a simulação nesta página.
        </p>
      </div>

      <div class="card results-card" aria-live="polite">
        <div class="section-heading">
          <div>
            <span class="section-label">ETAPA 2</span>
            <h2>Resultado da comparação</h2>
          </div>
          <div class="heading-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
        </div>

        <div class="results-placeholder" id="results-placeholder">
          <div class="placeholder-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
              <polyline points="16 7 22 7 22 13"></polyline>
            </svg>
          </div>
          <h3>Sua comparação aparecerá aqui</h3>
          <p>
            Preencha os valores da proposta CLT e PJ e clique em
            "Comparar CLT e PJ" para visualizar os resultados.
          </p>
        </div>

        <div id="results-content" hidden>
          <div class="comparison-grid">
            <div class="comparison-item clt-result">
              <div class="result-type">
                <span class="result-dot clt-dot"></span>
                Modalidade CLT
              </div>
              <span class="result-caption">Valor mensal efetivo</span>
              <strong id="res-clt">R$ 0,00</strong>
              <span class="result-footnote">Inclui benefícios informados</span>
            </div>

            <div class="comparison-item pj-result">
              <div class="result-type">
                <span class="result-dot pj-dot"></span>
                Modalidade PJ
              </div>
              <span class="result-caption">Valor mensal líquido</span>
              <strong id="res-pj">R$ 0,00</strong>
              <span class="result-footnote">Após impostos e despesas estimadas</span>
            </div>
          </div>

          <div class="difference-panel">
            <span class="difference-label">Diferença mensal estimada</span>
            <strong id="res-difference">R$ 0,00</strong>
            <p id="res-difference-text"></p>
          </div>

          <div class="recommendation-panel">
            <div class="recommendation-heading">
              <span aria-hidden="true">💡</span>
              <strong>Análise da simulação</strong>
            </div>
            <p id="res-rec"></p>
          </div>

          <div class="result-details">
            <h3>Resumo dos valores</h3>

            <div class="detail-row">
              <span>Salário bruto CLT</span>
              <strong id="detail-clt-gross">R$ 0,00</strong>
            </div>

            <div class="detail-row">
              <span>Benefícios CLT informados</span>
              <strong id="detail-clt-benefits">R$ 0,00</strong>
            </div>

            <div class="detail-row">
              <span>Faturamento PJ</span>
              <strong id="detail-pj-gross">R$ 0,00</strong>
            </div>

            <div class="detail-row">
              <span>Despesas PJ informadas</span>
              <strong id="detail-pj-expenses">R$ 0,00</strong>
            </div>

            <div class="detail-row total-row">
              <span>Resultado mensal CLT</span>
              <strong id="detail-clt-net">R$ 0,00</strong>
            </div>

            <div class="detail-row total-row">
              <span>Resultado mensal PJ</span>
              <strong id="detail-pj-net">R$ 0,00</strong>
            </div>
          </div>
        </div>

        <p class="result-disclaimer">
          Simulação estimativa. O resultado depende das regras tributárias,
          das condições contratuais e dos parâmetros utilizados pelo simulador.
        </p>
      </div>
    </section>

    <section class="content-section">
      <h2>CLT ou PJ: quais são as diferenças?</h2>
      <p>
        A escolha entre trabalhar como empregado contratado pelo regime CLT
        ou prestar serviços como pessoa jurídica vai além da comparação entre
        dois valores mensais. Cada modalidade possui características,
        obrigações e responsabilidades diferentes.
      </p>

      <div class="info-grid">
        <article class="info-card">
          <div class="info-icon clt-info-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <h3>Trabalho CLT</h3>
          <p>
            O trabalhador possui vínculo empregatício e direitos previstos
            na legislação trabalhista.
          </p>
          <ul>
            <li>13º salário;</li>
            <li>Férias remuneradas com adicional de 1/3;</li>
            <li>Depósitos de FGTS pelo empregador;</li>
            <li>Contribuição previdenciária;</li>
            <li>Possibilidade de seguro-desemprego, conforme os requisitos legais.</li>
          </ul>
        </article>

        <article class="info-card">
          <div class="info-icon pj-info-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <h3>Trabalho PJ</h3>
          <p>
            O profissional presta serviços por meio de uma empresa e precisa
            administrar sua própria estrutura financeira.
          </p>
          <ul>
            <li>Possibilidade de faturamento maior;</li>
            <li>Despesas e obrigações empresariais;</li>
            <li>Tributação conforme atividade e enquadramento;</li>
            <li>Planejamento próprio para férias e períodos sem faturamento;</li>
            <li>Ausência automática dos direitos típicos de um vínculo CLT.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="content-section">
      <h2>O que considerar antes de aceitar uma proposta PJ?</h2>
      <p>
        Um faturamento PJ aparentemente superior pode não representar um ganho
        real maior. Antes de tomar uma decisão, considere os custos e as
        responsabilidades que passam a ser seus.
      </p>

      <div class="checklist">
        <div class="check-item">
          <span aria-hidden="true">✓</span>
          <div>
            <strong>Tributação da empresa</strong>
            <p>
              Verifique o Anexo aplicável, a alíquota efetiva, o faturamento
              acumulado e a possibilidade de aplicação do Fator R.
            </p>
          </div>
        </div>

        <div class="check-item">
          <span aria-hidden="true">✓</span>
          <div>
            <strong>Contabilidade e despesas</strong>
            <p>
              Considere contador, certificados, sistemas, taxas e outros
              custos necessários para manter a empresa.
            </p>
          </div>
        </div>

        <div class="check-item">
          <span aria-hidden="true">✓</span>
          <div>
            <strong>Reserva financeira</strong>
            <p>
              Planeje recursos para férias, períodos sem contratos,
              imprevistos e aposentadoria.
            </p>
          </div>
        </div>

        <div class="check-item">
          <span aria-hidden="true">✓</span>
          <div>
            <strong>Benefícios e segurança</strong>
            <p>
              Compare plano de saúde, alimentação, transporte, estabilidade
              contratual e demais condições oferecidas pela empresa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>Perguntas frequentes</h2>

      <div class="faq-list">
        <details class="faq-item">
          <summary>Trabalhar como PJ sempre compensa financeiramente?</summary>
          <p>
            Não. O faturamento PJ precisa ser suficiente para compensar impostos,
            despesas operacionais, ausência de benefícios automáticos e a
            necessidade de formar reservas financeiras. A comparação deve
            considerar o conjunto da remuneração.
          </p>
        </details>

        <details class="faq-item">
          <summary>O que é o Fator R do Simples Nacional?</summary>
          <p>
            É um cálculo que relaciona a folha de pagamento e encargos
            considerados pela legislação com a receita bruta da empresa.
            Em determinadas atividades, o resultado pode influenciar o
            enquadramento entre os Anexos III e V do Simples Nacional.
          </p>
        </details>

        <details class="faq-item">
          <summary>O FGTS é descontado do salário do trabalhador?</summary>
          <p>
            Não. O depósito do FGTS é uma obrigação do empregador e não
            representa um desconto direto no salário do empregado. Seu valor
            deve ser considerado como parte da remuneração indireta ao comparar
            as modalidades.
          </p>
        </details>

        <details class="faq-item">
          <summary>A calculadora considera todos os impostos e benefícios?</summary>
          <p>
            Não necessariamente. A ferramenta apresenta uma estimativa
            baseada nos parâmetros informados e nas regras implementadas
            no motor de cálculo. Impostos pessoais, pró-labore, INSS do
            sócio, ISS, retenções, benefícios específicos e reservas podem
            exigir uma análise complementar.
          </p>
        </details>

        <details class="faq-item">
          <summary>Posso utilizar o resultado para negociar uma proposta?</summary>
          <p>
            Sim, como referência inicial. Utilize a comparação para avaliar
            os valores e preparar uma negociação, mas confirme os detalhes
            tributários e contratuais antes de tomar uma decisão.
          </p>
        </details>
      </div>
    </section>

    <div class="final-note">
      <strong>Importante:</strong>
      Esta calculadora tem finalidade exclusivamente informativa e educacional.
      Não substitui uma análise individual feita por contador ou profissional
      especializado em legislação trabalhista e tributária.
    </div>
  </main>

  <script>
    import { calculateCltVsPj } from '../../engines/finance/clt-pj-engine';
    import { formatBRL } from '../../engines/common/currency';

    type PjTaxRegime = 'simples-AnexoIII' | 'simples-AnexoV';

    const getInput = (id: string): HTMLInputElement =>
      document.getElementById(id) as HTMLInputElement;

    const getSelect = (id: string): HTMLSelectElement =>
      document.getElementById(id) as HTMLSelectElement;

    const getElement = (id: string): HTMLElement =>
      document.getElementById(id)!;

    function readNumber(id: string): number {
      const rawValue = getInput(id).value.trim();

      if (rawValue === '') {
        return Number.NaN;
      }

      return Number(rawValue);
    }

    function showError(message: string): void {
      const error = getElement('form-error');

      error.textContent = message;
      error.hidden = false;
      getElement('results-content').hidden = true;
      getElement('results-placeholder').hidden = false;
    }

    function clearError(): void {
      const error = getElement('form-error');

      error.textContent = '';
      error.hidden = true;
    }

    function setText(id: string, value: string): void {
      getElement(id).textContent = value;
    }

    function runCalc(): void {
      clearError();

      const cltSalary = readNumber('clt-salary');
      const cltBenefits = readNumber('clt-benefits');
      const pjBilling = readNumber('pj-billing');
      const pjExpenses = readNumber('pj-expenses');

      const pjRegime = getSelect('pj-regime').value as PjTaxRegime;

      if (
        !Number.isFinite(cltSalary) ||
        !Number.isFinite(cltBenefits) ||
        !Number.isFinite(pjBilling) ||
        !Number.isFinite(pjExpenses)
      ) {
        showError('Preencha todos os campos com valores numéricos válidos.');
        return;
      }

      if (cltSalary <= 0) {
        showError('Informe um salário bruto CLT maior que zero.');
        getInput('clt-salary').focus();
        return;
      }

      if (pjBilling <= 0) {
        showError('Informe um faturamento mensal PJ maior que zero.');
        getInput('pj-billing').focus();
        return;
      }

      if (cltBenefits < 0 || pjExpenses < 0) {
        showError('Benefícios e despesas não podem ter valores negativos.');
        return;
      }

      if (!['simples-AnexoIII', 'simples-AnexoV'].includes(pjRegime)) {
        showError('Selecione um regime tributário válido.');
        return;
      }

      const button = getElement('calc-btn') as HTMLButtonElement;

      button.disabled = true;
      button.textContent = 'Calculando...';

      try {
        const result = calculateCltVsPj({
          cltGrossSalary: cltSalary,
          cltHasBenefits: cltBenefits > 0,
          cltMonthlyBenefits: cltBenefits,
          pjMonthlyBilling: pjBilling,
          pjTaxRegime: pjRegime,
          pjMonthlyExpenses: pjExpenses,
        });

        const cltNet = Number(result.cltEffectiveMonthly);
        const pjNet = Number(result.pjMonthlyNet);

        if (
          !Number.isFinite(cltNet) ||
          !Number.isFinite(pjNet)
        ) {
          throw new Error('O motor de cálculo retornou valores inválidos.');
        }

        const difference = Math.abs(pjNet - cltNet);
        const pjWins = pjNet > cltNet;
        const cltWins = cltNet > pjNet;

        setText('res-clt', formatBRL(cltNet));
        setText('res-pj', formatBRL(pjNet));
        setText('res-difference', formatBRL(difference));

        if (pjWins) {
          setText(
            'res-difference-text',
            `A modalidade PJ apresenta uma vantagem estimada de ${formatBRL(difference)} por mês.`
          );
        } else if (cltWins) {
          setText(
            'res-difference-text',
            `A modalidade CLT apresenta uma vantagem estimada de ${formatBRL(difference)} por mês.`
          );
        } else {
          setText(
            'res-difference-text',
            'As duas modalidades apresentam resultados mensais equivalentes nesta simulação.'
          );
        }

        setText('res-rec', String(result.recommendation));

        setText('detail-clt-gross', formatBRL(cltSalary));
        setText('detail-clt-benefits', formatBRL(cltBenefits));
        setText('detail-pj-gross', formatBRL(pjBilling));
        setText('detail-pj-expenses', formatBRL(pjExpenses));
        setText('detail-clt-net', formatBRL(cltNet));
        setText('detail-pj-net', formatBRL(pjNet));

        const differencePanel = getElement('res-difference').parentElement!;

        differencePanel.classList.toggle('pj-winner', pjWins);
        differencePanel.classList.toggle('clt-winner', cltWins);

        getElement('results-placeholder').hidden = true;
        getElement('results-content').hidden = false;
      } catch (error) {
        console.error('Erro ao calcular CLT vs. PJ:', error);

        showError(
          'Não foi possível realizar a simulação. Verifique os valores e tente novamente.'
        );
      } finally {
        button.disabled = false;
        button.innerHTML = '<span>Comparar CLT e PJ</span><span aria-hidden="true">→</span>';
      }
    }

    getElement('calc-btn').addEventListener('click', runCalc);

    [
      'clt-salary',
      'clt-benefits',
      'pj-billing',
      'pj-expenses',
      'pj-regime',
    ].forEach((id) => {
      const element = getElement(id);

      element.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          runCalc();
        }
      });
    });
  </script>

  <style>
    .page-container {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 0 3rem;
      color: var(--text-primary);
    }

    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 2rem;
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .breadcrumb a {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--color-primary);
    }

    .page-header {
      margin-bottom: 1.75rem;
    }

    .eyebrow,
    .section-label {
      display: inline-block;
      color: var(--color-primary);
      font-size: 0.72rem;
      font-weight: 800;
