---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { TOOLS_DATA } from "../../../data/tools";
import { CATEGORY_EN, TOOLS_EN } from "../../../i18n/tools-en";

export function getStaticPaths() {
  return Object.keys(CATEGORY_EN).map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const meta = CATEGORY_EN[category!];

const tools = TOOLS_DATA.filter(
  (t) => t.status === "active" && t.category === meta.ptCategory
);
---

<BaseLayout
  title={`${meta.title} — Calculadora de Ganhos`}
  description={meta.description}
>
  <section class="en-cat-hero">
    <div class="container">
      <nav class="en-breadcrumb" aria-label="Breadcrumb">
        <a href="/en/">Home</a>
        <span>/</span>
        <span>{meta.title}</span>
      </nav>
      <h1>{meta.title}</h1>
      <p>{meta.subtitle}</p>
      <span class="en-count">{tools.length} calculators available</span>
    </div>
  </section>

  <section class="en-cat-list">
    <div class="container">
      <div class="en-grid">
        {tools.map((tool) => {
          const tr = TOOLS_EN[tool.id];
          const name = tr ? tr.name : tool.name;
          const desc = tr ? tr.description : tool.description;
          const badge = tr ? tr.badge : meta.title;

          return (
            <a href={tool.route} class={`en-card color-${meta.color}`}>
              <span class="en-badge">{badge}</span>
              <h2>{name}</h2>
              <p>{desc}</p>
              <span class="en-cta">Open calculator →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .en-cat-hero {
    text-align: center;
    padding: 2.75rem 1.25rem 2.25rem;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .en-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
  }

  .en-breadcrumb a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .en-cat-hero h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 850;
    color: var(--text-primary);
    margin: 0 auto 0.65rem;
  }

  .en-cat-hero p {
    max-width: 600px;
    margin: 0 auto 1rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }

  .en-count {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--text-secondary);
  }

  .en-cat-list {
    padding: 2.75rem 1.25rem 4rem;
  }

  .en-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
  }

  .en-card {
    --card-accent: #059669;
    --card-soft: rgba(16, 185, 129, 0.12);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.4rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .en-card.color-blue   { --card-accent: #2563eb; --card-soft: rgba(37, 99, 235, 0.12); }
  .en-card.color-green  { --card-accent: #059669; --card-soft: rgba(16, 185, 129, 0.12); }
  .en-card.color-purple { --card-accent: #8b5cf6; --card-soft: rgba(139, 92, 246, 0.12); }
  .en-card.color-orange { --card-accent: #ea580c; --card-soft: rgba(234, 88, 12, 0.12); }
  .en-card.color-cyan   { --card-accent: #0891b2; --card-soft: rgba(8, 145, 178, 0.12); }
  .en-card.color-pink   { --card-accent: #db2777; --card-soft: rgba(219, 39, 119, 0.12); }

  .en-card:hover {
    transform: translateY(-3px);
    border-color: var(--card-accent);
    box-shadow: var(--shadow-md);
  }

  .en-badge {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--card-soft);
    color: var(--card-accent);
    font-size: 0.72rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.85rem;
  }

  .en-card h2 {
    font-size: 1.12rem;
    font-weight: 750;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  .en-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .en-cta {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--card-accent);
  }
</style>
