---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SearchTools from "../../components/SearchTools.astro";
import { TOOLS_DATA } from "../../data/tools";
import { TOOLS_EN } from "../../i18n/tools-en";

const popularIds = [
  "juros-compostos",
  "financiamento-imobiliario",
  "simulador-investimentos",
  "independencia-financeira",
  "porcentagem",
  "regra-de-tres",
  "biometria",
  "precificacao-markup",
  "gerador-senhas",
  "temperatura",
];

const colorByCat: Record<string, string> = {
  "Finanças": "green",
  "Matemática": "purple",
  "Conversores": "cyan",
  "Saúde": "pink",
  "Ferramentas": "orange",
};

const popularTools = popularIds
  .map((id) => TOOLS_DATA.find((t) => t.id === id))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
---

<BaseLayout
  title="Calculadora de Ganhos | Free Online Financial, Math & Utility Calculators"
  description="Free online calculators to simulate compound interest, mortgages, investments, percentages, rule of three, BMI, and everyday utilities directly in your browser."
>
  <div class="home">

    <!-- HERO WITH FLOATING MOCKUP -->
    <header class="hero">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-grid">
        <div class="hero-text">
          <span class="eyebrow">FREE ONLINE CALCULATORS FOR EVERYDAY DECISIONS</span>

          <h1>
            Clearer numbers.
            <span>Smarter decisions.</span>
          </h1>

          <p class="hero-description">
            Calculate, simulate, and compare financial, mathematical, health, and
            everyday scenarios. Practical tools to understand numbers and plan
            with confidence directly in your browser.
          </p>

          <div class="hero-search">
            <SearchTools />
          </div>

          <div class="quick-links">
            <span class="quick-links-label">Most accessed:</span>

            <div class="quick-chips">
              <a href="/financas/juros-compostos/">Compound interest</a>
              <a href="/financas/financiamento-imobiliario/">Mortgage</a>
              <a href="/matematica/porcentagem/">Percentage</a>
              <a href="/matematica/regra-de-tres/">Rule of three</a>
              <a href="/saude/biometria/">BMI & Biometrics</a>
            </div>
          </div>

          <div class="hero-benefits">
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              No signup
            </span>
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              100% Free
            </span>
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Clear results
            </span>
          </div>
        </div>

        <!-- ILLUSTRATIVE SIMULATION MOCKUP -->
        <div class="hero-visual" aria-hidden="true">
          <span class="floating-symbol symbol-one">$</span>
          <span class="floating-symbol symbol-two">%</span>
          <span class="floating-symbol symbol-three">∑</span>

          <div class="mockup-card home-mockup">
            <div class="mockup-top">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <span class="mockup-badge">Quick simulation</span>
            </div>

            <div class="sim-screen">
              <div class="sim-screen-top">
                <span class="sim-label">Estimated balance</span>
                <span class="sim-pill">+14.2% APY</span>
              </div>
              <div class="sim-value">$ 18,450.00</div>
            </div>

            <div class="sim-bars">
              <div class="sim-bar-row">
                <span>Principal invested</span>
                <strong>$ 12,000.00</strong>
              </div>
              <div class="sim-track">
                <span class="sim-fill-base"></span>
              </div>

              <div class="sim-bar-row">
                <span>Compound return</span>
                <strong class="is-accent">+ $ 6,450.00</strong>
              </div>
              <div class="sim-track">
                <span class="sim-fill-accent"></span>
              </div>
            </div>

            <div class="sim-tags">
              <span>Finance</span>
              <span>Math</span>
              <span>Tools</span>
            </div>

            <div class="mockup-row-footer">
              <span>Calculadora de Ganhos</span>
              <span class="mockup-dot"></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- HIGHLIGHTS BAR -->
    <section class="highlights" aria-label="Portal highlights">
      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
            <line x1="8" y1="6" x2="16" y2="6"></line>
            <line x1="16" y1="14" x2="16" y2="18"></line>
            <path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path>
            <path d="M12 14h.01"></path><path d="M8 14h.01"></path>
            <path d="M12 18h.01"></path><path d="M8 18h.01"></path>
          </svg>
        </div>
        <div>
          <strong>25+ Free Calculators</strong>
          <small>Built for everyday accuracy</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
        </div>
        <div>
          <strong>Instant Simulations</strong>
          <small>Compare scenarios in real time</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
        </div>
        <div>
          <strong>Step-by-Step Clarity</strong>
          <small>Understand every formula & result</small>
        </div>
      </div>
    </section>

    <!-- CATEGORIES -->
    <section id="categorias" class="categories-section">
      <div class="section-heading">
        <div>
          <h2>Explore by Category</h2>
          <p>
            Choose an area below to access specialized calculators, unit converters, health tools, and financial simulators.
          </p>
        </div>
      </div>

      <div class="categories-grid">
        <a href="/en/financas/" class="category-card category-finance">
          <div class="category-top">
            <div class="category-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                <polyline points="16 7 22 7 22 13"></polyline>
              </svg>
            </div>
            <span class="category-pill">11 Calculators</span>
          </div>
          <span class="category-kicker">INVESTING & PLANNING</span>
          <h3>Finance & Investing</h3>
          <p>
            Simulate compound interest, mortgages, loans, credit card payoff, 50/30/20 budgets, and financial independence (FIRE).
          </p>
          <span class="category-link">
            <span>Explore Finance</span>
            <span>→</span>
          </span>
        </a>

        <a href="/en/matematica/" class="category-card category-math">
          <div class="category-top">
            <div class="category-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="5" x2="5" y2="19"></line>
                <circle cx="6.5" cy="6.5" r="2.5"></circle>
                <circle cx="17.5" cy="17.5" r="2.5"></circle>
              </svg>
            </div>
            <span class="category-pill">8 Calculators</span>
          </div>
          <span class="category-kicker">EVERYDAY & ACADEMIC MATH</span>
          <h3>Mathematics & Percentages</h3>
          <p>
            Solve percentages, discounts, rule of three proportions, arithmetic means, GCD/LCM, and scientific operations.
          </p>
          <span class="category-link">
            <span>Explore Math</span>
            <span>→</span>
          </span>
        </a>

        <a href="/en/conversores/" class="category-card category-work">
          <div class="category-top">
            <div class="category-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="17 1 21 5 17 9"></polyline>
                <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                <polyline points="7 23 3 19 7 15"></polyline>
                <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
              </svg>
            </div>
            <span class="category-pill">3 Converters</span>
          </div>
          <span class="category-kicker">UNITS & CALENDAR</span>
          <h3>Converters & Dates</h3>
          <p>
            Convert Celsius, Fahrenheit, and Kelvin scales instantaneously and count business days between two dates.
          </p>
          <span class="category-link">
            <span>Explore Converters</span>
            <span>→</span>
          </span>
        </a>

        <a href="/en/saude/" class="category-card category-tools">
          <div class="category-top">
            <div class="category-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </div>
            <span class="category-pill">Health & Tools</span>
          </div>
          <span class="category-kicker">BIOMETRICS & PRODUCTIVITY</span>
          <h3>Health & Digital Utilities</h3>
          <p>
            Check BMI & metabolic metrics, generate strong passwords, count text characters, and calculate product markup.
          </p>
          <span class="category-link">
            <span>Explore Digital Tools</span>
            <span>→</span>
          </span>
        </a>
      </div>
    </section>

    <!-- POPULAR CALCULATORS -->
    <section class="popular-section">
      <div class="section-heading">
        <div>
          <h2>Popular Calculators</h2>
          <p>Quick access to our most used financial, mathematical, health, and productivity calculators.</p>
          <a href="/en/financas/" class="text-link">Browse all finance tools →</a>
        </div>
      </div>

      <div class="popular-grid">
        {popularTools.map((tool) => {
          const tr = TOOLS_EN[tool.id];
          const color = colorByCat[tool.category] || "green";

          return (
            <a href={tool.route} class={`popular-card pop-${color}`}>
              <div class="popular-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                  <line x1="8" y1="6" x2="16" y2="6"></line>
                  <line x1="8" y1="12" x2="16" y2="12"></line>
                  <line x1="8" y1="17" x2="12" y2="17"></line>
                </svg>
              </div>
              <div class="popular-card-body">
                <strong>{tr ? tr.name : tool.name}</strong>
                <small>{tr ? tr.description : tool.description}</small>
              </div>
              <span class="popular-arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- HOW TO USE -->
    <section class="how-section">
      <div class="section-heading">
        <div>
          <h2>How It Works</h2>
          <p>Simple, fast, and transparent calculations right inside your browser.</p>
        </div>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <span class="step-number">01</span>
          <h3>Pick a calculator</h3>
          <p>Use the search bar or select a category suited to your calculation.</p>
        </article>

        <article class="step-card">
          <span class="step-number">02</span>
          <h3>Enter your numbers</h3>
          <p>Fill in amounts, rates, percentages, or periods in clearly labeled fields.</p>
        </article>

        <article class="step-card">
          <span class="step-number">03</span>
          <h3>Review the breakdown</h3>
          <p>Get immediate results with detailed subtotals, comparisons, and explanations.</p>
        </article>

        <article class="step-card">
          <span class="step-number">04</span>
          <h3>Test new scenarios</h3>
          <p>Adjust any parameter anytime to compare outcomes before making decisions.</p>
        </article>
      </div>
    </section>

    <!-- TRUST & PRIVACY -->
    <section class="trust-section">
      <div class="trust-content">
        <div class="trust-intro">
          <h2>Why use Calculadora de Ganhos?</h2>
          <p>
            Built to turn complex financial and mathematical formulas into clear, instant insights without friction.
          </p>
        </div>

        <div class="trust-list">
          <article class="trust-item">
            <span class="trust-check" aria-hidden="true">✓</span>
            <div>
              <h3>100% Browser-Based & Private</h3>
              <p>All calculations run locally in your browser—your financial inputs are never stored on external servers.</p>
            </div>
          </article>

          <article class="trust-item">
            <span class="trust-check" aria-hidden="true">✓</span>
            <div>
              <h3>Zero Friction, Zero Paywalls</h3>
              <p>No account creation, no email walls, and instant responsiveness across desktop and mobile devices.</p>
            </div>
          </article>

          <article class="trust-item">
            <span class="trust-check" aria-hidden="true">✓</span>
            <div>
              <h3>Educational & Transparent Formulas</h3>
              <p>Every tool explains the methodology behind the numbers so you know exactly how results are derived.</p>
            </div>
          </article>

          <article class="trust-item">
            <span class="trust-check" aria-hidden="true">✓</span>
            <div>
              <h3>Multi-Scenario Comparisons</h3>
              <p>Simulate different interest rates, deadlines, and contributions side by side before committing.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- DISCLAIMER -->
    <section class="disclaimer-section" aria-label="Informational notice">
      <div class="disclaimer-icon" aria-hidden="true">i</div>
      <div>
        <h2>Informational & Educational Purpose</h2>
        <p>
          All calculators and simulations on <strong>Calculadora de Ganhos</strong> provide estimates for planning and educational purposes. For formal financial, tax, legal, or medical decisions, consult a qualified professional.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="section-heading">
        <div>
          <h2>Frequently Asked Questions</h2>
          <p>Quick answers about our calculators and how they work.</p>
        </div>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>Are the calculators completely free to use?</summary>
          <p>Yes. Every calculator, simulator, and converter on the portal is 100% free and requires no registration.</p>
        </details>

        <details class="faq-item">
          <summary>Is my financial data saved anywhere?</summary>
          <p>No. Calculations execute directly inside your browser session and are never transmitted or saved to a database.</p>
        </details>

        <details class="faq-item">
          <summary>Can I use these tools on mobile devices?</summary>
          <p>Yes. Every page and calculator interface is fully responsive for smartphones, tablets, and desktops.</p>
        </details>

        <details class="faq-item">
          <summary>Do the results replace professional financial or legal advice?</summary>
          <p>No. Our tools offer accurate mathematical simulations for educational planning and should complement—not replace—certified professional guidance.</p>
        </details>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta">
      <h2>Ready to run your next simulation?</h2>
      <p>
        Explore our categories and get accurate numbers in seconds.
      </p>
      <a href="#categorias" class="cta-button">
        <span>Explore calculators</span>
        <span aria-hidden="true">→</span>
      </a>
    </section>

  </div>
</BaseLayout>

<style>
  .home {
    width: 100%;
    padding: 0.5rem 0 2.5rem;
    color: var(--text-primary);
  }

  /* HERO (PADRÃO DAS CENTRAIS) */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 2.75rem 3rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .hero-glow {
    position: absolute;
    top: -120px;
    right: -80px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 16%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-text {
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 0.85rem;
    color: var(--color-primary);
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .hero h1 {
    margin: 0 0 1.15rem;
    font-size: clamp(2.15rem, 4.4vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 850;
    color: var(--text-primary);
    text-align: center;
  }

  .hero h1 span {
    display: block;
    color: var(--color-primary);
  }

  .hero-description {
    max-width: 540px;
    margin: 0 auto 1.65rem;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.75;
    text-align: center;
  }

  .hero-search {
    max-width: 560px;
    margin: 0 auto 1.25rem;
  }

  .quick-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .quick-links-label {
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .quick-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
  }

  .quick-chips a {
    padding: 0.42rem 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--bg-primary);
    color: var(--text-secondary);
    font-size: 0.77rem;
    font-weight: 650;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .quick-chips a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  .hero-benefits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.4rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .hero-benefits span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .hero-benefits svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* CARTÃO MOCKUP DO PORTAL */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .floating-symbol {
    position: absolute;
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding: 0 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-primary);
    color: var(--color-primary);
    font-size: 0.88rem;
    font-weight: 850;
    box-shadow: var(--shadow-md);
    pointer-events: none;
    z-index: 2;
  }

  .symbol-one {
    top: -10px;
    left: 10px;
    transform: rotate(-10deg);
  }

  .symbol-two {
    top: 32px;
    right: 4px;
    transform: rotate(12deg);
  }

  .symbol-three {
    bottom: 14px;
    left: 4px;
    transform: rotate(8deg);
  }

  .home-mockup {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 330px;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-primary);
    box-shadow: var(--shadow-lg);
    transform: rotate(-2.5deg);
    transition: transform 0.3s ease;
    text-align: left;
  }

  .home-mockup:hover {
    transform: rotate(0deg) translateY(-3px);
  }

  .mockup-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.95rem;
  }

  .window-dots {
    display: flex;
    gap: 5px;
  }

  .window-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-color);
  }

  .mockup-badge {
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 750;
  }

  .sim-screen {
    padding: 0.85rem 0.95rem;
    margin-bottom: 0.85rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
  }

  .sim-screen-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
