---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getToolsByCategory } from '../../data/tools';

const categoryTools = getToolsByCategory('Saúde');
const tools =
  categoryTools.length > 0
    ? categoryTools
    : [
        {
          name: 'Calculadora de Biometria',
          route: '/saude/biometria/',
          description:
            'Avalie índices corporais e parâmetros biométricos essenciais para acompanhar sua saúde de forma prática.',
        },
      ];
---

<BaseLayout
  title="Calculadoras de Saúde e Bem-Estar Grátis | Calculadora de Ganhos"
  description="Encontre calculadoras e ferramentas online gratuitas de saúde, biometria e bem-estar. Acompanhe indicadores corporais diretamente pelo navegador, sem instalar programas."
>
  <div class="tools-page">
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Saúde</span>
    </nav>

    <!-- HERO -->
    <header class="hero">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-grid">
        <div class="hero-text">
          <span class="eyebrow">SAÚDE E BEM-ESTAR</span>

          <h1>
            Calculadoras de
            <span>Saúde e Biometria</span>
          </h1>

          <p class="hero-description">
            Acompanhe indicadores corporais e parâmetros biométricos com
            clareza e praticidade. Utilize ferramentas gratuitas diretamente
            pelo navegador para apoiar sua rotina de cuidados com a saúde.
          </p>

          <div class="hero-actions">
            <a href="#catalogo" class="hero-cta">
              Explorar calculadoras <span aria-hidden="true">↓</span>
            </a>

            <span class="hero-note">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Gratuitas e fáceis de usar
            </span>
          </div>
        </div>

        <!-- MOCKUP ILUSTRATIVO -->
        <div class="hero-visual" aria-hidden="true">
          <span class="floating-symbol symbol-one">♥</span>
          <span class="floating-symbol symbol-two">IMC</span>
          <span class="floating-symbol symbol-three">✓</span>

          <div class="mockup-card util-mockup">
            <div class="mockup-top">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <span class="mockup-badge">Uso no navegador</span>
            </div>

            <div class="util-screen">
              <div class="util-screen-header">
                <span class="util-tag">Indicador biométrico</span>
                <span class="util-status">● Disponível</span>
              </div>
              <div class="util-output">Simples • Rápido • Informativo</div>
            </div>

            <div class="util-actions-grid">
              <span class="util-chip is-active">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                </svg>
                Biometria
              </span>

              <span class="util-chip">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
                Índices
              </span>

              <span class="util-chip">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Medidas
              </span>

              <span class="util-chip is-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>
                </svg>
                Calcular
              </span>
            </div>

            <div class="util-bar">
              <div class="util-bar-info">
                <span>Consulta imediata</span>
                <strong>Online</strong>
              </div>
              <div class="util-progress">
                <span></span>
              </div>
            </div>

            <div class="mockup-row-footer">
              <span>Calculadora de Ganhos</span>
              <span class="mockup-dot"></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- INDICADORES -->
    <section class="highlights" aria-label="Características das calculadoras">
      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
        </div>
        <div>
          <strong>Fáceis de usar</strong>
          <small>Cálculos rápidos e resultados claros</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <div>
          <strong>Privacidade em foco</strong>
          <small>Cálculos realizados no próprio navegador</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/>
          </svg>
        </div>
        <div>
          <strong>Acesso gratuito</strong>
          <small>Compatível com celular, tablet e computador</small>
        </div>
      </div>
    </section>

    <!-- CATÁLOGO -->
    <section class="catalog-section" id="catalogo" aria-labelledby="catalog-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">NOSSO CATÁLOGO</span>
          <h2 id="catalog-title">Explore nossas calculadoras de saúde</h2>
          <p>
            Escolha a calculadora desejada para acessar sua página, preencher
            seus parâmetros e conferir os resultados explicados.
          </p>
        </div>

        <span class="tool-count">
          <span class="count-dot" aria-hidden="true"></span>
          {tools.length} {tools.length === 1 ? 'calculadora disponível' : 'calculadoras disponíveis'}
        </span>
      </div>

      {tools.length > 0 ? (
        <div class="tools-grid">
          {tools.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
            </svg>
          </div>
          <h3>Novas calculadoras estão chegando</h3>
          <p>
            Estamos preparando novas ferramentas de saúde e bem-estar.
            Volte em breve para conferir as novidades.
          </p>
          <a href="/" class="empty-link">Voltar para a página inicial →</a>
        </div>
      )}
    </section>

    <!-- SOBRE AS FERRAMENTAS -->
    <section class="content-section" aria-labelledby="about-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">SOBRE A CATEGORIA</span>
          <h2 id="about-title">O que você encontra nesta seção?</h2>
        </div>
      </div>

      <div class="prose-block">
        <p>
          A categoria de saúde reúne calculadoras informativas desenvolvidas
          para ajudar você a acompanhar métricas corporais, índices biométricos
          e referências gerais de bem-estar no dia a dia.
        </p>

        <p>
          Com poucos dados básicos, como altura, peso, idade ou circunferências,
          você obtém estimativas organizadas e explicações sobre como cada
          indicador é interpretado na prática.
        </p>

        <p>
          Os resultados têm caráter exclusivamente educativo e informativo,
          servindo como ponto de apoio para acompanhar sua evolução antes ou
          durante consultas com profissionais da área da saúde.
        </p>
      </div>
    </section>

    <!-- PRIVACIDADE E AVISO -->
    <section class="privacy-section" aria-labelledby="privacy-title">
      <div class="privacy-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
        </svg>
      </div>

      <div class="privacy-body">
        <span class="eyebrow">PRIVACIDADE E ORIENTAÇÃO</span>
        <h2 id="privacy-title">Seus dados ficam no seu navegador</h2>

        <p>
          As informações inseridas nas calculadoras de saúde são processadas
          localmente no seu próprio dispositivo, sem armazenamento ou envio
          de dados pessoais para servidores externos.
        </p>

        <p>
          Lembre-se de que indicadores biométricos oferecem uma visão geral e
          não substituem avaliações clínicas, exames laboratoriais ou o
          acompanhamento de médicos, nutricionistas e educadores físicos.
        </p>
      </div>
    </section>

    <!-- COMO UTILIZAR -->
    <section class="how-section" aria-labelledby="how-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">COMO UTILIZAR</span>
          <h2 id="how-title">Comece em poucos passos</h2>
          <p>
            O uso das calculadoras foi pensado para ser rápido, intuitivo e
            acessível em qualquer tela.
          </p>
        </div>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <span class="step-number">01</span>
          <h3>Escolha uma calculadora</h3>
          <p>
            Selecione no catálogo a ferramenta biométrica ou de saúde que
            deseja consultar.
          </p>
        </article>

        <article class="step-card">
          <span class="step-number">02</span>
          <h3>Preencha suas medidas</h3>
          <p>
            Informe os dados solicitados nos campos indicados, seguindo as
            unidades de medida orientadas na página.
          </p>
        </article>

        <article class="step-card">
          <span class="step-number">03</span>
          <h3>Analise o resultado</h3>
          <p>
            Visualize os índices calculados e leia as faixas de referência
            para compreender melhor cada indicador.
          </p>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">DÚVIDAS FREQUENTES</span>
          <h2 id="faq-title">Perguntas sobre as calculadoras de saúde</h2>
        </div>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>As calculadoras de saúde são gratuitas?</summary>
          <p>
            Sim. Todas as calculadoras desta seção são totalmente gratuitas e
            podem ser acessadas quantas vezes você precisar, sem cadastro.
          </p>
        </details>

        <details class="faq-item">
          <summary>Os resultados substituem uma consulta médica?</summary>
          <p>
            Não. As ferramentas têm finalidade exclusivamente informativa e
            educativa. Para diagnósticos, prescrições ou planos alimentares e
            de treino, consulte sempre um profissional de saúde qualificado.
          </p>
        </details>

        <details class="faq-item">
          <summary>Meus dados corporais ficam salvos no site?</summary>
          <p>
            Não. Os cálculos são realizados diretamente no seu navegador e
            nenhuma medida informada é armazenada em banco de dados.
          </p>
        </details>

        <details class="faq-item">
          <summary>Posso acessar pelo celular?</summary>
          <p>
            Sim. Todas as páginas e calculadoras são responsivas e funcionam
            normalmente em smartphones, tablets e computadores.
          </p>
        </details>

        <details class="faq-item">
          <summary>Novas ferramentas de saúde serão adicionadas?</summary>
          <p>
            Sim. Esta seção receberá novas calculadoras de bem-estar, gasto
            calórico, hidratação e índices corporais conforme a evolução do
            portal.
          </p>
        </details>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="final-cta">
      <span class="eyebrow">CALCULADORA DE GANHOS</span>
      <h2>Mais praticidade para o seu dia a dia</h2>
      <p>
        Explore também nossas calculadoras financeiras, trabalhistas,
        matemáticas e utilitários em um só lugar.
      </p>
      <a href="/" class="cta-link">
        <span>Conhecer o site</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .tools-page {
    width: 100%;
    padding: 0.5rem 0 2.5rem;
    color: var(--text-primary);
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1.75rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 2.75rem 3rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .hero-glow {
    position: absolute;
    top: -120px;
    right: -80px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 16%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-text {
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    color: var(--color-primary);
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 0.85rem;
  }

  .hero h1 {
    margin: 0 0 1.15rem;
    font-size: clamp(2.15rem, 4.5vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 850;
    color: var(--text-primary);
    text-align: center;
  }

  .hero h1 span {
    display: block;
    color: var(--color-primary);
  }

  .hero-description {
    max-width: 520px;
    margin: 0 auto 1.75rem;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.75;
    text-align: center;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.35rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.45rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .hero-cta:hover {
    opacity: 0.92;
    transform: translateY(-2px);
  }

  .hero-note {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .hero-note svg {
    color: var(--color-primary);
  }

  /* MOCKUP */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .floating-symbol {
    position: absolute;
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding: 0 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-primary);
    color: var(--color-primary);
    font-size: 0.88rem;
    font-weight: 850;
    box-shadow: var(--shadow-md);
    pointer-events: none;
    z-index: 2;
  }

  .symbol-one {
    top: -10px;
    left: 12px;
    transform: rotate(-10deg);
  }

  .symbol-two {
    top: 32px;
    right: 6px;
    transform: rotate(12deg);
  }

  .symbol-three {
    bottom: 14px;
    left: 6px;
    transform: rotate(8deg);
  }

  .util-mockup {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 325px;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-primary);
    box-shadow: var(--shadow-lg);
    transform: rotate(-2.5deg);
    transition: transform 0.3s ease;
    text-align: left;
  }

  .util-mockup:hover {
    transform: rotate(0deg) translateY(-3px);
  }

  .mockup-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.95rem;
  }

  .window-dots {
    display: flex;
    gap: 5px;
  }

  .window-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-color);
  }

  .mockup-badge {
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 750;
  }

  /* VISOR */
  .util-screen {
    padding: 0.85rem 0.95rem;
    margin-bottom: 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
  }

  .util-screen-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .util-tag {
    color: var(--text-secondary);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .util-status {
    color: #22c55e;
    font-size: 0.68rem;
    font-weight: 750;
  }

  .util-output {
    color: var(--text-primary);
    font-size: 0.96rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  /* AÇÕES */
  .util-actions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.45rem;
    margin-bottom: 0.8rem;
  }

  .util-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 35px;
    padding: 0 0.65rem;
    border: 1px solid var(--border-color);
    border-radius: 9px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.76rem;
    font-weight: 700;
    user-select: none;
  }

  .util-chip.is-active {
    border-color: color-mix(in srgb, var(--color-primary) 28%, var(--border-color));
    background: color-mix(in srgb, var(--color-primary) 11%, var(--bg-primary));
    color: var(--color-primary);
  }

  .util-chip.is-primary {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 750;
  }

  /* BARRA DE STATUS */
  .util-bar {
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: var(--bg-secondary);
  }

  .util-bar-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    font-size: 0.7rem;
  }

  .util-bar-info span {
    color: var(--text-secondary);
  }

  .util-bar-info strong {
    color: var(--color-primary);
    font-weight: 800;
  }

  .util-progress {
    height: 6px;
    border-radius: 999px;
    background: var(--border-color);
