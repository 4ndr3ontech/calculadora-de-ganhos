  <!-- MECANISMO DE CÁLCULO -->
  <script>
    import { calculateBusinessDays } from '../../engines/utility/date-business-engine';

    function runCalc() {
      const startInput = document.getElementById('date-start') as HTMLInputElement | null;
      const endInput = document.getElementById('date-end') as HTMLInputElement | null;
      const errorElement = document.getElementById('calc-error');
      const businessElement = document.getElementById('res-business');
      const totalElement = document.getElementById('res-total');
      const weekendsElement = document.getElementById('res-weekends');

      if (
        !startInput ||
        !endInput ||
        !errorElement ||
        !businessElement ||
        !totalElement ||
        !weekendsElement
      ) {
        return;
      }

      const clearResults = () => {
        businessElement.textContent = '—';
        totalElement.textContent = '—';
        weekendsElement.textContent = '—';
      };

      const showError = (message: string) => {
        clearResults();
        errorElement.textContent = message;
        errorElement.hidden = false;
      };

      const startDate = startInput.value;
      const endDate = endInput.value;

      errorElement.textContent = '';
      errorElement.hidden = true;

      if (!startDate || !endDate) {
        showError('Informe a data inicial e a data final para realizar o cálculo.');
        return;
      }

      if (startDate > endDate) {
        showError('A data inicial não pode ser posterior à data final. Corrija o período informado.');
        return;
      }

      try {
        const result = calculateBusinessDays(startDate, endDate);

        if (
          !Number.isSafeInteger(result.businessDays) ||
          !Number.isSafeInteger(result.totalDays) ||
          !Number.isSafeInteger(result.weekends) ||
          result.businessDays < 0 ||
          result.totalDays < 1 ||
          result.weekends < 0 ||
          result.businessDays + result.weekends !== result.totalDays
        ) {
          throw new Error('O mecanismo retornou um resultado inválido.');
        }

        businessElement.textContent = `${result.businessDays} dias úteis`;
        totalElement.textContent = `${result.totalDays} dias`;
        weekendsElement.textContent = `${result.weekends} dias`;
      } catch (error) {
        console.error('Erro ao calcular dias úteis:', error);

        showError(
          'Não foi possível realizar o cálculo. Confira as datas e tente novamente.'
        );
      }
    }

    // Delegação de eventos: evita registrar listeners duplicados
    // quando ocorre navegação entre páginas com View Transitions.
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;

      if (event.target.closest('#calc-btn')) {
        runCalc();
      }
    });

    document.addEventListener('change', (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;

      if (
        event.target.id === 'date-start' ||
        event.target.id === 'date-end'
      ) {
        const startInput = document.getElementById('date-start') as HTMLInputElement | null;
        const endInput = document.getElementById('date-end') as HTMLInputElement | null;

        // Só recalcula automaticamente quando as duas datas estiverem preenchidas.
        if (startInput?.value && endInput?.value) {
          runCalc();
        }
      }
    });
  </script>

