  <script>
    const ABSOLUTE_ZERO_C = -273.15;
    const ABSOLUTE_ZERO_F = -459.67;
    const MINIMUM_K = 0;

    const formatTemperature = (number: number): string => {
      return number.toLocaleString('pt-BR', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    };

    function runCalc() {
      const valueInput =
        document.getElementById('temp-val') as HTMLInputElement | null;

      const scaleInput =
        document.getElementById('temp-scale') as HTMLSelectElement | null;

      const errorElement = document.getElementById('calc-error');

      const resultC = document.getElementById('res-c');
      const resultF = document.getElementById('res-f');
      const resultK = document.getElementById('res-k');

      if (
        !valueInput ||
        !scaleInput ||
        !errorElement ||
        !resultC ||
        !resultF ||
        !resultK
      ) {
        return;
      }

      const rawValue = valueInput.value.trim();
      const scale = scaleInput.value;

      const showError = (message: string) => {
        // Limpa resultados anteriores para evitar exibir
        // valores que não correspondem à entrada atual.
        resultC.textContent = '—';
        resultF.textContent = '—';
        resultK.textContent = '—';

        errorElement.textContent = message;
        errorElement.hidden = false;
      };

      const clearError = () => {
        errorElement.textContent = '';
        errorElement.hidden = true;
      };

      clearError();

      if (rawValue === '') {
        showError(
          'Informe uma temperatura para realizar a conversão.'
        );
        return;
      }

      const value = Number(rawValue);

      if (!Number.isFinite(value)) {
        showError('Informe um valor numérico válido.');
        return;
      }

      let c: number;
      let f: number;
      let k: number;

      // Conversão a partir da escala selecionada.
      if (scale === 'C') {
        c = value;
        f = (value * 9 / 5) + 32;
        k = value + 273.15;

      } else if (scale === 'F') {
        f = value;
        c = (value - 32) * 5 / 9;
        k = (value - 32) * 5 / 9 + 273.15;

      } else if (scale === 'K') {
        k = value;
        c = value - 273.15;
        f = (value * 9 / 5) - 459.67;

      } else {
        showError('Selecione uma escala de temperatura válida.');
        return;
      }

      // Verificação de resultados numéricos.
      if (![c, f, k].every(Number.isFinite)) {
        showError(
          'Não foi possível processar esse valor. Informe uma temperatura dentro do intervalo numérico permitido.'
        );
        return;
      }

      // Validação do zero absoluto em todas as escalas.
      const tolerance = 1e-9;

      if (
        c < ABSOLUTE_ZERO_C - tolerance ||
        f < ABSOLUTE_ZERO_F - tolerance ||
        k < MINIMUM_K - tolerance
      ) {
        let minimumMessage = '';

        if (scale === 'C') {
          minimumMessage = 'O limite mínimo é -273,15 °C.';
        } else if (scale === 'F') {
          minimumMessage = 'O limite mínimo é -459,67 °F.';
        } else {
          minimumMessage = 'O limite mínimo é 0 K.';
        }

        showError(
          `A temperatura informada está abaixo do zero absoluto. ${minimumMessage}`
        );
        return;
      }

      // Corrige pequenas diferenças de ponto flutuante no limite.
      if (Math.abs(k) < tolerance) {
        k = 0;
        c = ABSOLUTE_ZERO_C;
        f = ABSOLUTE_ZERO_F;
      }

      // Atualiza os três resultados.
      resultC.textContent = `${formatTemperature(c)} °C`;
      resultF.textContent = `${formatTemperature(f)} °F`;
      resultK.textContent = `${formatTemperature(k)} K`;
    }

    function initTemperatureConverter() {
      const calcButton = document.getElementById('calc-btn');
      const valueInput = document.getElementById('temp-val');
      const scaleInput = document.getElementById('temp-scale');

      if (!calcButton || !valueInput || !scaleInput) {
        return;
      }

      // Evita registrar eventos repetidos na mesma página.
      if (calcButton.dataset.initialized === 'true') {
        runCalc();
        return;
      }

      calcButton.addEventListener('click', runCalc);
      valueInput.addEventListener('input', runCalc);
      scaleInput.addEventListener('change', runCalc);

      calcButton.dataset.initialized = 'true';

      // Exibe os resultados iniciais.
      runCalc();
    }

    // Inicialização normal da página.
    initTemperatureConverter();

    // Compatibilidade com navegação do Astro View Transitions.
    document.addEventListener(
      'astro:page-load',
      initTemperatureConverter
    );
  </script>

</BaseLayout>