---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getToolsByCategory } from '../../data/tools';

const tools = getToolsByCategory('Conversores');
---

<BaseLayout
  title="Conversores de Unidades Online — Temperatura e Medidas | Calculadora de Ganhos"
  description="Acesse conversores de unidades online gratuitos. Converta temperatura, dias úteis e outras grandezas com praticidade, rapidez e resultados fáceis de entender."
>
  <div class="converters-page">
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Conversores</span>
    </nav>

    <!-- HERO COM MOCKUP FLUTUANTE -->
    <header class="hero">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-grid">
        <div class="hero-text">
          <span class="eyebrow">CENTRAL DE FERRAMENTAS</span>

          <h1>
            Conversores
            <span>de Unidades</span>
          </h1>

          <p class="hero-description">
            Transforme medidas, escalas e prazos de forma simples, rápida e
            precisa. Utilize nossas ferramentas gratuitas para conversões do
            cotidiano, estudos e atividades profissionais.
          </p>

          <div class="hero-actions">
            <a href="#ferramentas" class="hero-cta">
              Explorar conversores <span aria-hidden="true">↓</span>
            </a>

            <span class="hero-note">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Gratuitos e fáceis de usar
            </span>
          </div>
        </div>

        <!-- CARTÃO VISUAL ILUSTRATIVO (MOCKUP DE CONVERSOR) -->
        <div class="hero-visual" aria-hidden="true">
          <span class="floating-symbol symbol-one">°C</span>
          <span class="floating-symbol symbol-two">°F</span>
          <span class="floating-symbol symbol-three">⇄</span>

          <div class="mockup-card calc-mockup">
            <div class="mockup-top">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <span class="mockup-badge">Conversão online</span>
            </div>

            <!-- VISOR DO CONVERSOR -->
            <div class="calc-screen">
              <div class="calc-expression">25 °C → Fahrenheit =</div>
              <div class="calc-result">77,00 °F</div>
            </div>

            <!-- TECLADO -->
            <div class="calc-keypad">
              <span class="calc-key is-muted">C</span>
              <span class="calc-key is-muted">°C</span>
              <span class="calc-key is-muted">°F</span>
              <span class="calc-key is-op">⇄</span>

              <span class="calc-key">7</span>
              <span class="calc-key">8</span>
              <span class="calc-key">9</span>
              <span class="calc-key is-op">K</span>

              <span class="calc-key">4</span>
              <span class="calc-key">5</span>
              <span class="calc-key">6</span>
              <span class="calc-key is-op">−</span>

              <span class="calc-key">1</span>
              <span class="calc-key">2</span>
              <span class="calc-key">3</span>
              <span class="calc-key is-equal">=</span>
            </div>

            <div class="mockup-row-footer">
              <span>Calculadora de Ganhos</span>
              <span class="mockup-dot"></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- BARRA DE INDICADORES -->
    <section class="highlights" aria-label="Características dos conversores">
      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/>
          </svg>
        </div>
        <div>
          <strong>Conversões práticas</strong>
          <small>Transformações simples e rápidas</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>
          </svg>
        </div>
        <div>
          <strong>Responsivo</strong>
          <small>Funciona em celular e computador</small>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
        <div>
          <strong>Informação clara</strong>
          <small>Entenda cada fórmula e resultado</small>
        </div>
      </div>
    </section>

    <!-- GRADE DE FERRAMENTAS -->
    <section class="tools-section" id="ferramentas" aria-labelledby="tools-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">FERRAMENTAS DISPONÍVEIS</span>
          <h2 id="tools-title">Escolha seu conversor</h2>
          <p>
            Selecione a ferramenta desejada para realizar sua conversão.
          </p>
        </div>

        <span class="tools-count">
          {tools.length} {tools.length === 1 ? 'ferramenta' : 'ferramentas'}
        </span>
      </div>

      {tools.length > 0 ? (
        <div class="tools-grid">
          {tools.map((tool) => (
            <a href={tool.route} class="tool-card">
              <div class="tool-card-content">
                <div class="tool-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/>
                  </svg>
                </div>

                <h3>{tool.name}</h3>

                <p>{tool.description}</p>
              </div>

              <span class="tool-link">
                <span>Acessar ferramenta</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <h3>Novos conversores em desenvolvimento</h3>
          <p>
            Estamos preparando novas ferramentas para facilitar suas
            conversões. Volte em breve para conferir as novidades.
          </p>
        </div>
      )}
    </section>

    <!-- ENTENDA AS CONVERSÕES -->
    <section class="content-section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">ENTENDA AS CONVERSÕES</span>
          <h2>O que são conversores de unidades?</h2>
        </div>
      </div>

      <div class="prose-block">
        <p>
          Conversores de unidades são ferramentas que permitem transformar
          uma medida expressa em determinada unidade para outra unidade
          equivalente, mantendo o mesmo valor físico ou a mesma quantidade
          representada.
        </p>

        <p>
          Eles são úteis quando precisamos comparar medidas, interpretar
          informações técnicas, realizar cálculos ou trabalhar com diferentes
          sistemas de unidades. Uma conversão de temperatura, por exemplo,
          permite transformar graus Celsius em Fahrenheit ou Kelvin.
        </p>

        <p>
          Em vez de realizar cálculos manualmente e correr o risco de cometer
          erros, você pode utilizar nossas ferramentas para obter resultados
          de maneira prática.
        </p>
      </div>
    </section>

    <!-- APLICAÇÕES PRÁTICAS -->
    <section class="content-section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">APLICAÇÕES PRÁTICAS</span>
          <h2>Quando utilizar um conversor de unidades?</h2>
        </div>
      </div>

      <div class="applications-grid">
        <article class="application-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <h3>Estudos</h3>
          <p>
            Auxílio em exercícios escolares, cálculos matemáticos e
            atividades de física e ciências.
          </p>
        </article>

        <article class="application-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
          </div>
          <h3>Trabalho</h3>
          <p>
            Apoio em atividades profissionais que exigem comparação
            e transformação de medidas.
          </p>
        </article>

        <article class="application-card">
          <div class="icon-badge icon-badge-amber" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3>Dia a dia</h3>
          <p>
            Conversões úteis para interpretar informações, receitas,
            temperaturas e outras medidas.
          </p>
        </article>

        <article class="application-card">
          <div class="icon-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/>
            </svg>
          </div>
          <h3>Conhecimento técnico</h3>
          <p>
            Compreensão de grandezas e unidades utilizadas em diferentes
            áreas do conhecimento.
          </p>
        </article>
      </div>
    </section>

    <!-- COMO FUNCIONA -->
    <section class="content-section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">COMO FUNCIONA</span>
          <h2>Como utilizar nossos conversores?</h2>
        </div>
      </div>

      <ol class="steps-list">
        <li>
          <span class="step-number">01</span>
          <div class="step-body">
            <h3>Escolha a ferramenta</h3>
            <p>
              Localize na lista o conversor correspondente à grandeza
              que deseja transformar.
            </p>
          </div>
        </li>

        <li>
          <span class="step-number">02</span>
          <div class="step-body">
            <h3>Informe o valor</h3>
            <p>
              Digite a medida que deseja converter no campo indicado
              pela ferramenta.
            </p>
          </div>
        </li>

        <li>
          <span class="step-number">03</span>
          <div class="step-body">
            <h3>Selecione as unidades</h3>
            <p>
              Escolha a unidade de origem e a unidade de destino,
              quando essa opção estiver disponível.
            </p>
          </div>
        </li>

        <li>
          <span class="step-number">04</span>
          <div class="step-body">
            <h3>Confira o resultado</h3>
            <p>
              Consulte o valor convertido e as informações adicionais
              apresentadas pela ferramenta.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">DÚVIDAS FREQUENTES</span>
          <h2>Perguntas frequentes sobre conversores</h2>
        </div>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>Os conversores são gratuitos?</summary>
          <p>
            Sim. As ferramentas disponibilizadas nesta categoria podem ser
            utilizadas gratuitamente, sem necessidade de pagamento.
          </p>
        </details>

        <details class="faq-item">
          <summary>Preciso instalar algum programa?</summary>
          <p>
            Não. Os conversores podem ser acessados diretamente pelo
            navegador, em dispositivos compatíveis.
          </p>
        </details>

        <details class="faq-item">
          <summary>Os resultados são precisos?</summary>
          <p>
            As ferramentas utilizam fórmulas matemáticas de conversão
            apropriadas para cada grandeza. A apresentação do resultado
            pode envolver arredondamento decimal.
          </p>
        </details>

        <details class="faq-item">
          <summary>Posso utilizar os conversores no celular?</summary>
          <p>
            Sim. As páginas são desenvolvidas para se adaptar a diferentes
            tamanhos de tela, incluindo smartphones, tablets e computadores.
          </p>
        </details>

        <details class="faq-item">
          <summary>Novos conversores serão adicionados?</summary>
          <p>
            A categoria pode receber novas ferramentas conforme a expansão
            do portal, incluindo conversões de diferentes grandezas e
            aplicações práticas.
          </p>
        </details>
      </div>
    </section>

    <!-- AVISO -->
    <aside class="notice">
      <div class="notice-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        </svg>
        <strong>Importante:</strong>
      </div>
      <p>
        Os resultados apresentados pelas ferramentas têm finalidade
        informativa e de apoio a cálculos cotidianos. Em atividades
        técnicas, científicas, industriais ou que envolvam segurança,
        confira as unidades, os critérios de arredondamento e as normas
        aplicáveis antes de utilizar os resultados.
      </p>
    </aside>

  </div>
</BaseLayout>

<style>
  .converters-page {
    width: 100%;
    padding: 0.5rem 0 2.5rem;
    color: var(--text-primary);
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1.75rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  /* HERO (PADRÃO CENTRAL DE FERRAMENTAS) */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 2.75rem 3rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .hero-glow {
    position: absolute;
    top: -120px;
    right: -80px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 16%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-text {
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    color: var(--color-primary);
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 0.85rem;
  }

  .hero h1 {
    margin: 0 0 1.15rem;
    font-size: clamp(2.15rem, 4.5vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 850;
    color: var(--text-primary);
    text-align: center;
  }

  .hero h1 span {
    display: block;
    color: var(--color-primary);
  }

  .hero-description {
    max-width: 520px;
    margin: 0 auto 1.75rem;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.75;
    text-align: center;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.35rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.45rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .hero-cta:hover {
    opacity: 0.92;
    transform: translateY(-2px);
  }

  .hero-note {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .hero-note svg {
    color: var(--color-primary);
  }

  /* CARTÃO MOCKUP DE CONVERSOR */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .floating-symbol {
    position: absolute;
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding: 0 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-primary);
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 850;
    box-shadow: var(--shadow-md);
    pointer-events: none;
    z-index: 2;
  }

  .symbol-one {
    top: -10px;
    left: 12px;
    transform: rotate(-10deg);
  }

  .symbol-two {
    top: 32px;
    right: 6px;
    transform: rotate(12deg);
  }

  .symbol-three {
    bottom: 14px;
    left: 6px;
    transform: rotate(8deg);
  }

  .calc-mockup {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 320px;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-primary);
    box-shadow: var(--shadow-lg);
    transform: rotate(-2.5deg);
    transition: transform 0.3s ease;
    text-align: left;
  }

  .calc-mockup:hover {
    transform: rotate(0deg) translateY(-3px);
  }

  .mockup-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .window-dots {
    display: flex;
    gap: 5px;
  }

  .window-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-color);
  }

  .mockup-badge {
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 750;
  }

  /* VISOR */
  .calc-screen {
    padding: 0.9rem 1rem;
    margin-bottom: 0.9rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    text-align: right;
  }

  .calc-expression {
    color: var(--text-secondary);
    font-size: 0.76rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .calc-result {
    color: var(--text-primary);
    font-size: 1.55rem;
    font-weight: 850;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  /* TECLADO */
  .calc-keypad {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
  }

  .calc-key {
    display: grid;
    place-items: center;
    height: 36px;
    border: 1px solid var(--border-color);
    border-radius: 9px;
